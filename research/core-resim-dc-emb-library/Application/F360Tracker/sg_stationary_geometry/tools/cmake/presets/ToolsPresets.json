{
    "version": 4,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 23,
        "patch": 0
    },
    "include": [
        "GenericPresets.json"
    ],
    "configurePresets": [
        {
            "name": "kpi_resim",
            "displayName": "KPI resimulation",
            "description": "Preset used in KPI framework i.e for logs resimulation",
            "inherits": "generic_release",
            "cacheVariables": {
                "SG_RESIM": "ON"
            }
        }
    ]
}