%% This is a scenario file, which can be read in by the MATE-Scenario-Creator-Plugin.
% File Version: VERSION_11

%% Scenario Description:
% This scenario includes the EGO-object, named 'Ego'. Internal name is 'object_1'.
% This scenario includes the TARGET-object, named 'Target'. Internal name is 'object_2'.
% This scenario includes the TARGET-object, named 'Car behind'. Internal name is 'object_3'.
% This scenario includes the TARGET-object, named 'Car front'. Internal name is 'object_4'.
% The dimensions of Ego are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The dimensions of Target are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The dimensions of Car behind are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The dimensions of Car front are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The initial conditions of Ego are set to: [Start-Speed: 0 kph, Start-Heading: 0 deg].
% The initial conditions of Target are set to: [Start-Speed: 50 kph, Start-Heading: 0 deg].
% The initial conditions of Car behind are set to: [Start-Speed: 0 kph, Start-Heading: 0 deg].
% The initial conditions of Car front are set to: [Start-Speed: 0 kph, Start-Heading: 0 deg].
% The start position of Target is shifted by Lateral-Offset: -3.5 m, Longitudinal-Offset: -40 mHeading: 0°.
% The start position of Car behind is shifted by Lateral-Offset: 0 m, Longitudinal-Offset: -6 mHeading: 0°.
% The start position of Car front is shifted by Lateral-Offset: 0 m, Longitudinal-Offset: 8 mHeading: 0°.
% Add a stationary section to Ego with: Duration: 0.5 s, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a clothoide section to Ego with: End-Speed: 20 kph, End-Radius: 2.5 m, End-Heading: -45 deg, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a clothoide section to Ego with: End-Speed: 40 kph, End-Radius: 3 m, End-Heading: 45 deg, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Ego with: End-Speed: 50 kph, Distance: 20 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Target with: End-Speed: 50 kph, Distance: 10 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a clothoide section to Target with: End-Speed: 50 kph, End-Radius: 20 m, End-Heading: -15 deg, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a clothoide section to Target with: End-Speed: 50 kph, End-Radius: 20 m, End-Heading: 15 deg, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Target with: End-Speed: 50 kph, Distance: 30 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a stationary section to Car behind with: Duration: 20 s, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a stationary section to Car front with: Duration: 20 s, Section-Generic-Properties( Tracker-Data.Status: MATURE ).

%% Set up enums
[enum_object_types, enum_object_specific_variants]  = enum_base.get_by_name('enum_object_types', 'enum_object_specific_variants');
[enum_track_status_T, enum_collision_point, enum_track_object_class] = enum_base.get_by_name('enum_track_status_T', 'enum_collision_point', 'enum_track_object_class');

%% Create Objects and define start and end conditions of the scenario
% Mandatory: Create objects for scenario (Type[enum], Name[char])
object_1 = class_scenario_properties(enum_object_types.EGO, 'Ego');
object_2 = class_scenario_properties(enum_object_types.TARGET, 'Target');
object_3 = class_scenario_properties(enum_object_types.TARGET, 'Car behind');
object_4 = class_scenario_properties(enum_object_types.TARGET, 'Car front');

% Mandatory: Define start objects dimensions (Width[m], Length[m], Pivot_Point[m]) OR (Preset[enum])
object_1.set_dimension(enum_object_specific_variants.VEHICLE);
object_2.set_dimension(enum_object_specific_variants.VEHICLE);
object_3.set_dimension(enum_object_specific_variants.VEHICLE);
object_4.set_dimension(enum_object_specific_variants.VEHICLE);

% Mandatory: Define objects starting values (Speed[kph], Heading[deg])
object_1.set_starting_values(0, 0);
object_2.set_starting_values(50, 0);
object_3.set_starting_values(0, 0);
object_4.set_starting_values(0, 0);

% Optional: Define objects to end its scenario together with ego

% Optional: Define objects to have collision with Ego (Collision_Point[enum], CP-Lat-Offset[%], CP-Long-Offset[%])

% Optional: Define end position offsets for targets (Lat.[m] / Long.[m])
object_2.set_start_pos_offsets(-3.5, -40, 0);
object_3.set_start_pos_offsets(0, -6, 0);
object_4.set_start_pos_offsets(0, 8, 0);

%% Define trajectories of the objects
section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_1.add_stationary_section(0.5, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_1.add_clothoide_by_tau_section(20, 2.5, -45, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_1.add_clothoide_by_tau_section(40, 3, 45, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_1.add_straight_section(50, 20, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_2.add_straight_section(50, 10, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_2.add_clothoide_by_tau_section(50, 20, -15, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_2.add_clothoide_by_tau_section(50, 20, 15, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_2.add_straight_section(50, 30, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_3.add_stationary_section(20, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_4.add_stationary_section(20, section_generic_properties);


%% Create scenario property, containing all of the objects.
scenario = class_scenario_creator();
scenario.set_version(enum_scenario_file_versions.VERSION_11);
scenario.set_polarion_info('CSCSA-41303', '');
scenario.set_test_type('positive');
scenario.set_default_timestep(0.05);
scenario.add_object(object_1);
scenario.add_object(object_2);
scenario.add_object(object_3);
scenario.add_object(object_4);
