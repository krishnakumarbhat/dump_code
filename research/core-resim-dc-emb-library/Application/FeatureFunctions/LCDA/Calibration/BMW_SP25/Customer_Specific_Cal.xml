  <CUSTOMER_SPECIFIC_CALIBRATION_COMPONENT>
    <record>
      <NAME>k_bmw_sp25_guardrail_rel_diff_thresh</NAME>
      <DESCRIPTION>Relative difference between lateral positions (recent and previous one) which indicates if guardrail is valid. </DESCRIPTION>
      <Comp>LCDA</Comp>
      <UNIT>none</UNIT>
      <DATA_TYPE>float32_T</DATA_TYPE>
      <DATA_RESOLUTION>0.01</DATA_RESOLUTION>
      <RANGE_MIN>0.0f</RANGE_MIN>
      <RANGE_MAX>100.0f</RANGE_MAX>
      <DEFAULT_VALUE>0.5f</DEFAULT_VALUE>
    </record>
    <record>
      <NAME>k_bmw_sp25_guardrail_age_stage_thresh</NAME>
      <DESCRIPTION>Minimum Guardrail age to be considered by LCDA </DESCRIPTION>
      <Comp>LCDA</Comp>
      <UNIT>none</UNIT>
      <DATA_TYPE>uint8_t</DATA_TYPE>
      <DATA_RESOLUTION>1</DATA_RESOLUTION>
      <RANGE_MIN>0u</RANGE_MIN>
      <RANGE_MAX>10u</RANGE_MAX>
      <DEFAULT_VALUE>4u</DEFAULT_VALUE>
    </record>
    <record>
      <NAME>k_bmw_sp25_exist_prob_lc_intention</NAME>
      <DESCRIPTION>Boundary of existence probability which is returned when lane change intention is given</DESCRIPTION>
      <Comp>BMW_SP25</Comp>
      <UNIT>none</UNIT>
      <DATA_TYPE>float32_T</DATA_TYPE>
      <DATA_RESOLUTION>0.0001</DATA_RESOLUTION>
      <RANGE_MIN>0.0f</RANGE_MIN>
      <RANGE_MAX>1.0f</RANGE_MAX>
      <DEFAULT_VALUE>0.91f</DEFAULT_VALUE>
    </record>
    <record>
      <NAME>k_bmw_sp25_cvw_limit_zone_range_hys</NAME>
      <DESCRIPTION>Hysteresis for BMW-specific CVW zone limit for China. Distance here describes object front to host vehicle rear. Hysteresis is added to input value lcda_cvw_limit_zone_range.</DESCRIPTION>
      <Comp>BMW_SP25</Comp>
      <UNIT>m</UNIT>
      <DATA_TYPE>float32_T</DATA_TYPE>
      <DATA_RESOLUTION>0.0001</DATA_RESOLUTION>
      <RANGE_MIN>0.0f</RANGE_MIN>
      <RANGE_MAX>10.0f</RANGE_MAX>
      <DEFAULT_VALUE>1.0f</DEFAULT_VALUE>
    </record>
    <record>
      <NAME>k_bmw_sp25_smooth_camera_signals</NAME>
      <DESCRIPTION>The BMW camera input signals (distance and probability) are smoothed for the guardrail calculation if activated.</DESCRIPTION>
      <Comp>BMW_SP25</Comp>
      <UNIT>none</UNIT>
      <DATA_TYPE>boolean_T</DATA_TYPE>
      <DATA_RESOLUTION>1</DATA_RESOLUTION>
      <RANGE_MIN>0</RANGE_MIN>
      <RANGE_MAX>1</RANGE_MAX>
      <DEFAULT_VALUE>0</DEFAULT_VALUE>
    </record>
    <record>
      <NAME>k_bmw_sp25_max_bad_guardrail_holding_counter</NAME>
      <DESCRIPTION>Counter to hold previous camera input signals for guardrail calculation in case of bad quality.</DESCRIPTION>
      <Comp>BMW_SP25</Comp>
      <UNIT>none</UNIT>
      <DATA_TYPE>uint8_t</DATA_TYPE>
      <DATA_RESOLUTION>1</DATA_RESOLUTION>
      <RANGE_MIN>0</RANGE_MIN>
      <RANGE_MAX>255</RANGE_MAX>
      <DEFAULT_VALUE>3</DEFAULT_VALUE>
    </record>
    <record>
      <NAME>k_bmw_sp25_lowest_probabilty_percentage_cal_for_adjustment</NAME>
      <DESCRIPTION>Definition of the lowest camera input probabiliy. The damping for the guardrail calculation is linearly interpolated between this value and 1. Values below this will be cut off.</DESCRIPTION>
      <Comp>BMW_SP25</Comp>
      <UNIT>none</UNIT>
      <DATA_TYPE>float32_T</DATA_TYPE>
      <DATA_RESOLUTION>0.01</DATA_RESOLUTION>
      <RANGE_MIN>0.0f</RANGE_MIN>
      <RANGE_MAX>1.0f</RANGE_MAX>
      <DEFAULT_VALUE>0.5f</DEFAULT_VALUE>
    </record>
    <record>
      <NAME>k_bmw_sp25_trailer_mode_max_trailer_length</NAME>
      <DESCRIPTION>Defines the maximum expected trailer length for BSW alert suppression when the trailer mode is active.</DESCRIPTION>
      <Comp>BMW_SP25</Comp>
      <UNIT>m</UNIT>
      <DATA_TYPE>float32_T</DATA_TYPE>
      <DATA_RESOLUTION>0.01</DATA_RESOLUTION>
      <RANGE_MIN>0.0f</RANGE_MIN>
      <RANGE_MAX>10.0f</RANGE_MAX>
      <DEFAULT_VALUE>5.0f</DEFAULT_VALUE>
    </record>
    <record>
      <NAME>k_bmw_sp25_trailer_mode_max_bike_carrier_distance</NAME>
      <DESCRIPTION>Defines the maximum expected distance of the bike carrier to the ego rear for BSW alert suppression when the trailer mode is active.</DESCRIPTION>
      <Comp>BMW_SP25</Comp>
      <UNIT>m</UNIT>
      <DATA_TYPE>float32_T</DATA_TYPE>
      <DATA_RESOLUTION>0.01</DATA_RESOLUTION>
      <RANGE_MIN>0.0f</RANGE_MIN>
      <RANGE_MAX>3.0f</RANGE_MAX>
      <DEFAULT_VALUE>0.5f</DEFAULT_VALUE>
    </record>
    <record>
      <NAME>k_bmw_sp25_trailer_mode_max_bike_carrier_buffer</NAME>
