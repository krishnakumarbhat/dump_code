%% This is a scenario file, which can be read in by the MATE-Scenario-Creator-Plugin.
% File Version: VERSION_11

%% Scenario Description:
% This scenario includes the EGO-object, named 'Ego'. Internal name is 'object_1'.
% This scenario includes the TARGET-object, named 'Target'. Internal name is 'object_2'.
% The dimensions of Ego are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The dimensions of Target are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The initial conditions of Ego are set to: [Start-Speed: 80 kph, Start-Heading: 0 deg].
% The initial conditions of Target are set to: [Start-Speed: 120 kph, Start-Heading: 0 deg].
% The path of Target is shifted so that it ends together with Ego in time.
% The end position of Target is shifted by Lateral-Offset: 3 m, Longitudinal-Offset: -4 mHeading: 0°.
% Register signal Ego with: Name: f_lcda_enabled, Interpolation: enum_interpolation.PREVIOUS).
% Change signal value Ego: Name: f_lcda_enabled, Value: 0).
% Register signal Ego with: Name: k_bsw_enable, Interpolation: enum_interpolation.PREVIOUS).
% Change signal value Ego: Name: k_bsw_enable, Value: 0).
% Register signal Ego with: Name: k_cvw_enable, Interpolation: enum_interpolation.PREVIOUS).
% Change signal value Ego: Name: k_cvw_enable, Value: 0).
% Register signal Ego with: Name: k_slc_enable, Interpolation: enum_interpolation.PREVIOUS).
% Change signal value Ego: Name: k_slc_enable, Value: 0).
% Register signal Ego with: Name: k_elc_enable, Interpolation: enum_interpolation.PREVIOUS).
% Change signal value Ego: Name: k_elc_enable, Value: 0).
% Add a straight section to Ego with: End-Speed: 80 kph, Distance: 100 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Target with: End-Speed: 130 kph, Distance: 100 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).

%% Set up enums
[enum_object_types, enum_object_specific_variants]  = enum_base.get_by_name('enum_object_types', 'enum_object_specific_variants');
[enum_track_status_T, enum_collision_point, enum_track_object_class] = enum_base.get_by_name('enum_track_status_T', 'enum_collision_point', 'enum_track_object_class');

%% Create Objects and define start and end conditions of the scenario
% Mandatory: Create objects for scenario (Type[enum], Name[char])
object_1 = class_scenario_properties(enum_object_types.EGO, 'Ego');
object_2 = class_scenario_properties(enum_object_types.TARGET, 'Target');

% Mandatory: Define start objects dimensions (Width[m], Length[m], Pivot_Point[m]) OR (Preset[enum])
object_1.set_dimension(enum_object_specific_variants.VEHICLE);
object_2.set_dimension(enum_object_specific_variants.VEHICLE);

% Mandatory: Define objects starting values (Speed[kph], Heading[deg])
object_1.set_starting_values(80, 0);
object_2.set_starting_values(120, 0);

% Optional: Define objects to end its scenario together with ego
object_2.set_alignment_to_end_time();

% Optional: Define objects to have collision with Ego (Collision_Point[enum], CP-Lat-Offset[%], CP-Long-Offset[%])

% Optional: Define end position offsets for targets (Lat.[m] / Long.[m])
object_2.set_end_pos_offsets(3, -4, 0);

%% Define trajectories of the objects
object_1.add_section_signal_register('f_lcda_enabled', enum_interpolation.PREVIOUS);
object_1.add_section_signal_change('f_lcda_enabled', 0);
object_1.add_section_signal_register('k_bsw_enable', enum_interpolation.PREVIOUS);
object_1.add_section_signal_change('k_bsw_enable', 0);
object_1.add_section_signal_register('k_cvw_enable', enum_interpolation.PREVIOUS);
object_1.add_section_signal_change('k_cvw_enable', 0);
object_1.add_section_signal_register('k_slc_enable', enum_interpolation.PREVIOUS);
object_1.add_section_signal_change('k_slc_enable', 0);
object_1.add_section_signal_register('k_elc_enable', enum_interpolation.PREVIOUS);
object_1.add_section_signal_change('k_elc_enable', 0);
section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_1.add_straight_section(80, 100, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_2.add_straight_section(130, 100, section_generic_properties);


%% Create scenario property, containing all of the objects.
scenario = class_scenario_creator();
scenario.set_version(enum_scenario_file_versions.VERSION_11);
scenario.set_polarion_info('CSCSA-122849', 'SF-2780,SF-2814,SF-2816');
scenario.set_test_type('Simulation');
scenario.set_default_timestep(0.05);
scenario.add_object(object_1);
scenario.add_object(object_2);
