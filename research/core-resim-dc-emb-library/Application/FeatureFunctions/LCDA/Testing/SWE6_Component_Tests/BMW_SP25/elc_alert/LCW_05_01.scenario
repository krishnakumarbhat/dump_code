%% This is a scenario file, which can be read in by the MATE-Scenario-Creator-Plugin.
% File Version: VERSION_11

%% Scenario Description:
% This scenario includes the EGO-object, named 'Ego'. Internal name is 'object_1'.
% This scenario includes the TARGET-object, named 'Overtaker'. Internal name is 'object_2'.
% This scenario includes the TARGET-object, named 'Floater'. Internal name is 'object_3'.
% The dimensions of Ego are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The dimensions of Overtaker are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The dimensions of Floater are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The initial conditions of Ego are set to: [Start-Speed: 50 kph, Start-Heading: 0 deg].
% The initial conditions of Overtaker are set to: [Start-Speed: 100 kph, Start-Heading: 0 deg].
% The initial conditions of Floater are set to: [Start-Speed: 50 kph, Start-Heading: 0 deg].
% The start position of Overtaker is shifted by Lateral-Offset: -3.5 m, Longitudinal-Offset: -308 mHeading: 0°.
% The start position of Floater is shifted by Lateral-Offset: -3.5 m, Longitudinal-Offset: -35 mHeading: 0°.
% Add a straight section to Ego with: End-Speed: 50 kph, Distance: 208 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Ego with: End-Speed: 50 kph, Distance: 200 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Overtaker with: End-Speed: 100 kph, Distance: 417 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Overtaker with: End-Speed: 60 kph, Distance: 100 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Overtaker with: End-Speed: 50 kph, Distance: 200 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Floater with: End-Speed: 50 kph, Distance: 208 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Floater with: End-Speed: 50 kph, Distance: 235 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).

%% Set up enums
[enum_object_types, enum_object_specific_variants]  = enum_base.get_by_name('enum_object_types', 'enum_object_specific_variants');
[enum_track_status_T, enum_collision_point, enum_track_object_class] = enum_base.get_by_name('enum_track_status_T', 'enum_collision_point', 'enum_track_object_class');

%% Create Objects and define start and end conditions of the scenario
% Mandatory: Create objects for scenario (Type[enum], Name[char])
object_1 = class_scenario_properties(enum_object_types.EGO, 'Ego');
object_2 = class_scenario_properties(enum_object_types.TARGET, 'Overtaker');
object_3 = class_scenario_properties(enum_object_types.TARGET, 'Floater');

% Mandatory: Define start objects dimensions (Width[m], Length[m], Pivot_Point[m]) OR (Preset[enum])
object_1.set_dimension(enum_object_specific_variants.VEHICLE);
object_2.set_dimension(enum_object_specific_variants.VEHICLE);
object_3.set_dimension(enum_object_specific_variants.VEHICLE);

% Mandatory: Define objects starting values (Speed[kph], Heading[deg])
object_1.set_starting_values(50, 0);
object_2.set_starting_values(100, 0);
object_3.set_starting_values(50, 0);

% Optional: Define objects to end its scenario together with ego

% Optional: Define objects to have collision with Ego (Collision_Point[enum], CP-Lat-Offset[%], CP-Long-Offset[%])

% Optional: Define end position offsets for targets (Lat.[m] / Long.[m])
object_2.set_start_pos_offsets(-3.5, -308, 0);
object_3.set_start_pos_offsets(-3.5, -35, 0);

%% Define trajectories of the objects
section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_1.add_straight_section(50, 208, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_1.add_straight_section(50, 200, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_2.add_straight_section(100, 417, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_2.add_straight_section(60, 100, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_2.add_straight_section(50, 200, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_3.add_straight_section(50, 208, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_3.add_straight_section(50, 235, section_generic_properties);


%% Create scenario property, containing all of the objects.
scenario = class_scenario_creator();
scenario.set_version(enum_scenario_file_versions.VERSION_11);
scenario.set_polarion_info('CSCSA-46787', '');
scenario.set_test_type('negative');
scenario.set_default_timestep(0.05);
scenario.add_object(object_1);
scenario.add_object(object_2);
scenario.add_object(object_3);
