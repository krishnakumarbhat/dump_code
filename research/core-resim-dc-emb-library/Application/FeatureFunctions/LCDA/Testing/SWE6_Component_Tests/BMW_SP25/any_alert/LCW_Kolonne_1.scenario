%% This is a scenario file, which can be read in by the MATE-Scenario-Creator-Plugin.
% File Version: VERSION_11

%% Scenario Description:
% This scenario includes the EGO-object, named 'Ego'. Internal name is 'object_1'.
% This scenario includes the TARGET-object, named 'Target1'. Internal name is 'object_2'.
% This scenario includes the TARGET-object, named 'Target2'. Internal name is 'object_3'.
% This scenario includes the TARGET-object, named 'Target3'. Internal name is 'object_4'.
% This scenario includes the TARGET-object, named 'Target4'. Internal name is 'object_5'.
% The dimensions of Ego are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The dimensions of Target1 are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The dimensions of Target2 are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The dimensions of Target3 are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The dimensions of Target4 are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The initial conditions of Ego are set to: [Start-Speed: 80 kph, Start-Heading: 0 deg].
% The initial conditions of Target1 are set to: [Start-Speed: 180 kph, Start-Heading: 0 deg].
% The initial conditions of Target2 are set to: [Start-Speed: 180 kph, Start-Heading: 0 deg].
% The initial conditions of Target3 are set to: [Start-Speed: 180 kph, Start-Heading: 0 deg].
% The initial conditions of Target4 are set to: [Start-Speed: 180 kph, Start-Heading: 0 deg].
% The start position of Target1 is shifted by Lateral-Offset: -3.5 m, Longitudinal-Offset: -516 mHeading: 0°.
% The start position of Target2 is shifted by Lateral-Offset: -3.5 m, Longitudinal-Offset: -601 mHeading: 0°.
% The start position of Target3 is shifted by Lateral-Offset: -3.5 m, Longitudinal-Offset: -686 mHeading: 0°.
% The start position of Target4 is shifted by Lateral-Offset: -3.5 m, Longitudinal-Offset: -771 mHeading: 0°.
% Add a straight section to Ego with: End-Speed: 80 kph, Distance: 333 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Ego with: End-Speed: 80 kph, Distance: 350 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Target1 with: End-Speed: 180 kph, Distance: 750 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Target1 with: End-Speed: 180 kph, Distance: 400 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Target2 with: End-Speed: 180 kph, Distance: 750 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Target2 with: End-Speed: 180 kph, Distance: 490 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Target3 with: End-Speed: 180 kph, Distance: 750 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Target3 with: End-Speed: 180 kph, Distance: 580 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Target4 with: End-Speed: 180 kph, Distance: 750 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Target4 with: End-Speed: 180 kph, Distance: 720 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).

%% Set up enums
[enum_object_types, enum_object_specific_variants]  = enum_base.get_by_name('enum_object_types', 'enum_object_specific_variants');
[enum_track_status_T, enum_collision_point, enum_track_object_class] = enum_base.get_by_name('enum_track_status_T', 'enum_collision_point', 'enum_track_object_class');

%% Create Objects and define start and end conditions of the scenario
% Mandatory: Create objects for scenario (Type[enum], Name[char])
object_1 = class_scenario_properties(enum_object_types.EGO, 'Ego');
object_2 = class_scenario_properties(enum_object_types.TARGET, 'Target1');
object_3 = class_scenario_properties(enum_object_types.TARGET, 'Target2');
object_4 = class_scenario_properties(enum_object_types.TARGET, 'Target3');
object_5 = class_scenario_properties(enum_object_types.TARGET, 'Target4');

% Mandatory: Define start objects dimensions (Width[m], Length[m], Pivot_Point[m]) OR (Preset[enum])
object_1.set_dimension(enum_object_specific_variants.VEHICLE);
object_2.set_dimension(enum_object_specific_variants.VEHICLE);
object_3.set_dimension(enum_object_specific_variants.VEHICLE);
object_4.set_dimension(enum_object_specific_variants.VEHICLE);
object_5.set_dimension(enum_object_specific_variants.VEHICLE);

% Mandatory: Define objects starting values (Speed[kph], Heading[deg])
object_1.set_starting_values(80, 0);
object_2.set_starting_values(180, 0);
object_3.set_starting_values(180, 0);
object_4.set_starting_values(180, 0);
object_5.set_starting_values(180, 0);

% Optional: Define objects to end its scenario together with ego

% Optional: Define objects to have collision with Ego (Collision_Point[enum], CP-Lat-Offset[%], CP-Long-Offset[%])

% Optional: Define end position offsets for targets (Lat.[m] / Long.[m])
object_2.set_start_pos_offsets(-3.5, -516, 0);
object_3.set_start_pos_offsets(-3.5, -601, 0);
object_4.set_start_pos_offsets(-3.5, -686, 0);
object_5.set_start_pos_offsets(-3.5, -771, 0);

%% Define trajectories of the objects
section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_1.add_straight_section(80, 333, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_1.add_straight_section(80, 350, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_2.add_straight_section(180, 750, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_2.add_straight_section(180, 400, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_3.add_straight_section(180, 750, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_3.add_straight_section(180, 490, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_4.add_straight_section(180, 750, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_4.add_straight_section(180, 580, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_5.add_straight_section(180, 750, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_5.add_straight_section(180, 720, section_generic_properties);


%% Create scenario property, containing all of the objects.
scenario = class_scenario_creator();
scenario.set_version(enum_scenario_file_versions.VERSION_11);
scenario.set_polarion_info('CSCSA-46674', '');
scenario.set_test_type('positive');
scenario.set_default_timestep(0.05);
scenario.add_object(object_1);
scenario.add_object(object_2);
scenario.add_object(object_3);
scenario.add_object(object_4);
scenario.add_object(object_5);
