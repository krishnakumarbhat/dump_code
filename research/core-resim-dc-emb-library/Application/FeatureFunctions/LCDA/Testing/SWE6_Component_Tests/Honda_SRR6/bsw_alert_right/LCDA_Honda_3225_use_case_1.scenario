%% This is a scenario file, which can be read in by the MATE-Scenario-Creator-Plugin.
% File Version: VERSION_11

%% Scenario Description:
% This scenario includes the EGO-object, named 'Ego'. Internal name is 'object_1'.
% This scenario includes the TARGET-object, named 'Target'. Internal name is 'object_2'.
% This scenario includes the TARGET-object, named 'Target'. Internal name is 'object_3'.
% This scenario includes the TARGET-object, named 'Target'. Internal name is 'object_4'.
% The dimensions of Ego are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The dimensions of Target are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The dimensions of Target are set to the MOTORCYCLE-Preset: [Width: 0.5 m, Length: 1.5 m, PivotPoint: -1 m].
% The dimensions of Target are set to the TRUCK-Preset: [Width: 2.05 m, Length: 8 m, PivotPoint: -6.5 m].
% The initial conditions of Ego are set to: [Start-Speed: 25 kph, Start-Heading: 0 deg].
% The initial conditions of Target are set to: [Start-Speed: 80 kph, Start-Heading: 0 deg].
% The initial conditions of Target are set to: [Start-Speed: 60 kph, Start-Heading: 0 deg].
% The initial conditions of Target are set to: [Start-Speed: 61 kph, Start-Heading: 0 deg].
% The start position of Target is shifted by Lateral-Offset: 4 m, Longitudinal-Offset: -80 mHeading: 0°.
% The start position of Target is shifted by Lateral-Offset: 2 m, Longitudinal-Offset: -80 mHeading: 0°.
% The start position of Target is shifted by Lateral-Offset: 5.8 m, Longitudinal-Offset: -80 mHeading: 0°.
% Add a straight section to Ego with: End-Speed: 25 kph, Distance: 100 m, Section-Generic-Properties( Tracker-Data.Status: MATURE  Precision: 5 ).
% Add a straight section to Target with: End-Speed: 80 kph, Distance: 300 m, Section-Generic-Properties( Tracker-Data.Status: MATURE  Precision: 5 ).
% Add a straight section to Target with: End-Speed: 60 kph, Distance: 300 m, Section-Generic-Properties( Tracker-Data.Status: MATURE  Precision: 5 ).
% Add a straight section to Target with: End-Speed: 61 kph, Distance: 300 m, Section-Generic-Properties( Tracker-Data.Status: MATURE  Precision: 5 ).

%% Set up enums
[enum_object_types, enum_object_specific_variants]  = enum_base.get_by_name('enum_object_types', 'enum_object_specific_variants');
[enum_track_status_T, enum_collision_point, enum_track_object_class] = enum_base.get_by_name('enum_track_status_T', 'enum_collision_point', 'enum_track_object_class');

%% Create Objects and define start and end conditions of the scenario
% Mandatory: Create objects for scenario (Type[enum], Name[char])
object_1 = class_scenario_properties(enum_object_types.EGO, 'Ego');
object_2 = class_scenario_properties(enum_object_types.TARGET, 'Target');
object_3 = class_scenario_properties(enum_object_types.TARGET, 'Target');
object_4 = class_scenario_properties(enum_object_types.TARGET, 'Target');

% Mandatory: Define start objects dimensions (Width[m], Length[m], Pivot_Point[m]) OR (Preset[enum])
object_1.set_dimension(enum_object_specific_variants.VEHICLE);
object_2.set_dimension(enum_object_specific_variants.VEHICLE);
object_3.set_dimension(enum_object_specific_variants.MOTORCYCLE);
object_4.set_dimension(enum_object_specific_variants.TRUCK);

% Mandatory: Define objects starting values (Speed[kph], Heading[deg])
object_1.set_starting_values(25, 0);
object_2.set_starting_values(80, 0);
object_3.set_starting_values(60, 0);
object_4.set_starting_values(61, 0);

% Optional: Define objects to end its scenario together with ego

% Optional: Define objects to have collision with Ego (Collision_Point[enum], CP-Lat-Offset[%], CP-Long-Offset[%])

% Optional: Define end position offsets for targets (Lat.[m] / Long.[m])
object_2.set_start_pos_offsets(4, -80, 0);
object_3.set_start_pos_offsets(2, -80, 0);
object_4.set_start_pos_offsets(5.8, -80, 0);

%% Define trajectories of the objects
section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
section_generic_properties.precision = 5;
object_1.add_straight_section(25, 100, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
section_generic_properties.precision = 5;
object_2.add_straight_section(80, 300, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
section_generic_properties.precision = 5;
object_3.add_straight_section(60, 300, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
section_generic_properties.precision = 5;
object_4.add_straight_section(61, 300, section_generic_properties);


%% Create scenario property, containing all of the objects.
scenario = class_scenario_creator();
scenario.set_version(enum_scenario_file_versions.VERSION_11);
scenario.set_polarion_info('CSCSA-84266', '');
scenario.set_test_type('positive');
scenario.set_default_timestep(0.05);
scenario.add_object(object_1);
scenario.add_object(object_2);
scenario.add_object(object_3);
scenario.add_object(object_4);
