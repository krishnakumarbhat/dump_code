% The end position of Target_left is shifted by Lateral-Offset: -4 m, Longitudinal-Offset: -50 mHeading: 0°.
% Register signal Ego with: Name: ew_elatch_sense_stt, Interpolation: enum_interpolation.PREVIOUS).
% Change signal value Ego: Name: ew_elatch_sense_stt, Value: 0).
% Add a stationary section to Ego with: Duration: 6 s, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Change signal value Ego: Name: ew_elatch_sense_stt, Value: 1).
% Add a stationary section to Ego with: Duration: 6 s, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Change signal value Ego: Name: ew_elatch_sense_stt, Value: 2).
% Add a stationary section to Ego with: Duration: 6 s, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Target_right with: End-Speed: 36 kph, Distance: 60 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Target_left with: End-Speed: 36 kph, Distance: 60 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a stationary section to Target_right with: Duration: 6 s, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
