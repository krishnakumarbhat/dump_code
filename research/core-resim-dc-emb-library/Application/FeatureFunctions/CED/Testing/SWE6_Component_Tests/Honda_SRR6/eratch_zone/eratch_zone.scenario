% Add a stationary section to Target_left with: Duration: 12 s, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Target_left with: End-Speed: 36 kph, Distance: 60 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).

%% Set up enums
[enum_object_types, enum_object_specific_variants]  = enum_base.get_by_name('enum_object_types', 'enum_object_specific_variants');
[enum_track_status_T, enum_collision_point, enum_track_object_class] = enum_base.get_by_name('enum_track_status_T', 'enum_collision_point', 'enum_track_object_class');

%% Create Objects and define start and end conditions of the scenario
% Mandatory: Create objects for scenario (Type[enum], Name[char])
object_1 = class_scenario_properties(enum_object_types.EGO, 'Ego');
object_2 = class_scenario_properties(enum_object_types.TARGET, 'Target_right');
object_3 = class_scenario_properties(enum_object_types.TARGET, 'Target_left');
object_4 = class_scenario_properties(enum_object_types.TARGET, 'Target_right');
object_5 = class_scenario_properties(enum_object_types.TARGET, 'Target_left');
object_6 = class_scenario_properties(enum_object_types.TARGET, 'Target_right');
object_7 = class_scenario_properties(enum_object_types.TARGET, 'Target_left');

% Mandatory: Define start objects dimensions (Width[m], Length[m], Pivot_Point[m]) OR (Preset[enum])
object_1.set_dimension(enum_object_specific_variants.VEHICLE);
object_2.set_dimension(enum_object_specific_variants.VEHICLE);
object_3.set_dimension(enum_object_specific_variants.VEHICLE);
object_4.set_dimension(enum_object_specific_variants.VEHICLE);
object_5.set_dimension(enum_object_specific_variants.VEHICLE);
object_6.set_dimension(enum_object_specific_variants.VEHICLE);
object_7.set_dimension(enum_object_specific_variants.VEHICLE);

% Mandatory: Define objects starting values (Speed[kph], Heading[deg])
object_1.set_starting_values(0, 0);
object_2.set_starting_values(36, 0);
object_3.set_starting_values(36, 0);
object_4.set_starting_values(36, 0);
object_5.set_starting_values(36, 0);
object_6.set_starting_values(36, 0);
object_7.set_starting_values(36, 0);

% Optional: Define objects to end its scenario together with ego

% Optional: Define objects to have collision with Ego (Collision_Point[enum], CP-Lat-Offset[%], CP-Long-Offset[%])

% Optional: Define end position offsets for targets (Lat.[m] / Long.[m])
object_2.set_end_pos_offsets(3.5, -50, 0);
object_3.set_end_pos_offsets(-4, -50, 0);
object_4.set_end_pos_offsets(3, -50, 0);
object_5.set_end_pos_offsets(-3.5, -50, 0);
object_6.set_end_pos_offsets(3.5, -50, 0);
object_7.set_end_pos_offsets(-4, -50, 0);

%% Define trajectories of the objects
object_1.add_section_signal_register('ew_elatch_sense_stt', enum_interpolation.PREVIOUS);
object_1.add_section_signal_change('ew_elatch_sense_stt', 0);
section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_1.add_stationary_section(6, section_generic_properties);

object_1.add_section_signal_change('ew_elatch_sense_stt', 1);
section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_1.add_stationary_section(6, section_generic_properties);

object_1.add_section_signal_change('ew_elatch_sense_stt', 2);
section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_1.add_stationary_section(6, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_2.add_straight_section(36, 60, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_3.add_straight_section(36, 60, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_4.add_stationary_section(6, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_4.add_straight_section(36, 60, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_5.add_stationary_section(6, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_5.add_straight_section(36, 60, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_6.add_stationary_section(12, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_6.add_straight_section(36, 60, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_7.add_stationary_section(12, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_7.add_straight_section(36, 60, section_generic_properties);


%% Create scenario property, containing all of the objects.
scenario = class_scenario_creator();
scenario.set_version(enum_scenario_file_versions.VERSION_11);
scenario.set_polarion_info('CSCSA-46459', '');
scenario.set_test_type('positive');
scenario.set_default_timestep(0.05);
scenario.add_object(object_1);
scenario.add_object(object_2);
scenario.add_object(object_3);
scenario.add_object(object_4);
scenario.add_object(object_5);
scenario.add_object(object_6);
scenario.add_object(object_7);
