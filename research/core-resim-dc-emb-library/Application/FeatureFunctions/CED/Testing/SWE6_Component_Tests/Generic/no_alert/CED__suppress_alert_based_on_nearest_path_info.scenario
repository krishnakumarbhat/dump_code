%% This is a scenario file, which can be read in by the MATE-Scenario-Creator-Plugin.
% File Version: VERSION_11

%% Scenario Description:
% This scenario includes the EGO-object, named 'Ego'. Internal name is 'object_1'.
% This scenario includes the TARGET-object, named 'Target_To_Suppress'. Internal name is 'object_2'.
% This scenario includes the TARGET-object, named 'Target_Build_Path'. Internal name is 'object_3'.
% The dimensions of Ego are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The dimensions of Target_To_Suppress are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The dimensions of Target_Build_Path are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The initial conditions of Ego are set to: [Start-Speed: 0 kph, Start-Heading: 0 deg].
% The initial conditions of Target_To_Suppress are set to: [Start-Speed: 50 kph, Start-Heading: 17 deg].
% The initial conditions of Target_Build_Path are set to: [Start-Speed: 50 kph, Start-Heading: -10 deg].
% The path of Target_To_Suppress is shifted so that it ends together with Ego in time.
% The end position of Target_To_Suppress is shifted by Lateral-Offset: -1 m, Longitudinal-Offset: -38 mHeading: 0°.
% The end position of Target_Build_Path is shifted by Lateral-Offset: -10 m, Longitudinal-Offset: -40 mHeading: 0°.
% Add a stationary section to Ego with: Duration: 15 s, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a stationary section to Target_To_Suppress with: Duration: 8 s, Section-Generic-Properties().
% Add a straight section to Target_To_Suppress with: End-Speed: 50 kph, Distance: 10 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a stationary section to Target_To_Suppress with: Duration: 10 s, Section-Generic-Properties().
% Add a straight section to Target_Build_Path with: End-Speed: 50 kph, Distance: 80 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).

%% Set up enums
[enum_object_types, enum_object_specific_variants]  = enum_base.get_by_name('enum_object_types', 'enum_object_specific_variants');
[enum_track_status_T, enum_collision_point, enum_track_object_class] = enum_base.get_by_name('enum_track_status_T', 'enum_collision_point', 'enum_track_object_class');

%% Create Objects and define start and end conditions of the scenario
% Mandatory: Create objects for scenario (Type[enum], Name[char])
object_1 = class_scenario_properties(enum_object_types.EGO, 'Ego');
object_2 = class_scenario_properties(enum_object_types.TARGET, 'Target_To_Suppress');
object_3 = class_scenario_properties(enum_object_types.TARGET, 'Target_Build_Path');

% Mandatory: Define start objects dimensions (Width[m], Length[m], Pivot_Point[m]) OR (Preset[enum])
object_1.set_dimension(enum_object_specific_variants.VEHICLE);
object_2.set_dimension(enum_object_specific_variants.VEHICLE);
object_3.set_dimension(enum_object_specific_variants.VEHICLE);

% Mandatory: Define objects starting values (Speed[kph], Heading[deg])
object_1.set_starting_values(0, 0);
object_2.set_starting_values(50, 17);
object_3.set_starting_values(50, -10);

% Optional: Define objects to end its scenario together with ego
object_2.set_alignment_to_end_time();

% Optional: Define objects to have collision with Ego (Collision_Point[enum], CP-Lat-Offset[%], CP-Long-Offset[%])

% Optional: Define end position offsets for targets (Lat.[m] / Long.[m])
object_2.set_end_pos_offsets(-1, -38, 0);
object_3.set_end_pos_offsets(-10, -40, 0);

%% Define trajectories of the objects
section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_1.add_stationary_section(15, section_generic_properties);

section_generic_properties = class_section_generic_properties();
object_2.add_stationary_section(8, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_2.add_straight_section(50, 10, section_generic_properties);

section_generic_properties = class_section_generic_properties();
object_2.add_stationary_section(10, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_3.add_straight_section(50, 80, section_generic_properties);


%% Create scenario property, containing all of the objects.
scenario = class_scenario_creator();
scenario.set_version(enum_scenario_file_versions.VERSION_11);
scenario.set_polarion_info('CSCSA-46271', 'SF-48');
scenario.set_test_type('Simulation');
scenario.set_default_timestep(0.05);
scenario.add_object(object_1);
scenario.add_object(object_2);
scenario.add_object(object_3);
