%% This is a scenario file, which can be read in by the MATE-Scenario-Creator-Plugin.
% File Version: VERSION_11

%% Scenario Description:
% This scenario includes the EGO-object, named 'Ego'. Internal name is 'object_1'.
% This scenario includes the TARGET-object, named 'Target'. Internal name is 'object_2'.
% The dimensions of Ego are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The dimensions of Target are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The initial conditions of Ego are set to: [Start-Speed: 0 kph, Start-Heading: 0 deg].
% The initial conditions of Target are set to: [Start-Speed: 30 kph, Start-Heading: 0 deg].
% The start position of Target is shifted by Lateral-Offset: 3.1 m, Longitudinal-Offset: -25 mHeading: 0°.
% Register signal Ego with: Name: k_ced_alert_holding_cycles, Interpolation: enum_interpolation.PREVIOUS).
% Change signal value Ego: Name: k_ced_alert_holding_cycles, Value: 0).
% Add a straight section to Target with: End-Speed: 30 kph, Distance: 5 m, Section-Generic-Properties( Tracker-Data.Status: MATURE  Precision: 3 ).
% Add a circle section to Target with: Speed: 30 kph, Radius: 50 m, End-Heading: 3 deg, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a circle section to Target with: Speed: 30 kph, Radius: 50 m, End-Heading: -3 deg, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Target with: End-Speed: 30 kph, Distance: 10 m, Section-Generic-Properties( Tracker-Data.Status: MATURE  Precision: 3 ).

%% Set up enums
[enum_object_types, enum_object_specific_variants]  = enum_base.get_by_name('enum_object_types', 'enum_object_specific_variants');
[enum_track_status_T, enum_collision_point, enum_track_object_class] = enum_base.get_by_name('enum_track_status_T', 'enum_collision_point', 'enum_track_object_class');

%% Create Objects and define start and end conditions of the scenario
% Mandatory: Create objects for scenario (Type[enum], Name[char])
object_1 = class_scenario_properties(enum_object_types.EGO, 'Ego');
object_2 = class_scenario_properties(enum_object_types.TARGET, 'Target');

% Mandatory: Define start objects dimensions (Width[m], Length[m], Pivot_Point[m]) OR (Preset[enum])
object_1.set_dimension(enum_object_specific_variants.VEHICLE);
object_2.set_dimension(enum_object_specific_variants.VEHICLE);

% Mandatory: Define objects starting values (Speed[kph], Heading[deg])
object_1.set_starting_values(0, 0);
object_2.set_starting_values(30, 0);

% Optional: Define objects to end its scenario together with ego

% Optional: Define objects to have collision with Ego (Collision_Point[enum], CP-Lat-Offset[%], CP-Long-Offset[%])

% Optional: Define end position offsets for targets (Lat.[m] / Long.[m])
object_2.set_start_pos_offsets(3.1, -25, 0);

%% Define trajectories of the objects
object_1.add_section_signal_register('k_ced_alert_holding_cycles', enum_interpolation.PREVIOUS);
object_1.add_section_signal_change('k_ced_alert_holding_cycles', 0);
object_1.add_section_signal_register('k_ced_warning_pred_lat_dist_max_histeresis', enum_interpolation.PREVIOUS);
object_1.add_section_signal_change('k_ced_warning_pred_lat_dist_max_histeresis', 0.5);
object_1.add_section_signal_register('k_ced_third_warning_pred_lat_dist_max', enum_interpolation.PREVIOUS);
object_1.add_section_signal_change('k_ced_third_warning_pred_lat_dist_max', 0.5);
object_1.add_section_signal_register('k_ced_second_warning_pred_lat_dist_max', enum_interpolation.PREVIOUS);
object_1.add_section_signal_change('k_ced_second_warning_pred_lat_dist_max', 1.5);
object_1.add_section_signal_register('k_ced_collision_zone_width', enum_interpolation.PREVIOUS);
object_1.add_section_signal_change('k_ced_collision_zone_width', 2.0);
section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
section_generic_properties.precision = 3;
object_2.add_straight_section(30, 5, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_2.add_circle_section(30, 50, 3, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_2.add_circle_section(30, 50, -3, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
section_generic_properties.precision = 3;
object_2.add_straight_section(30, 10, section_generic_properties);


%% Create scenario property, containing all of the objects.
scenario = class_scenario_creator();
scenario.set_version(enum_scenario_file_versions.VERSION_11);
scenario.set_polarion_info('CSCSA-261280', 'CSCSA-261239');
scenario.set_test_type('Simulation');
scenario.set_default_timestep(0.05);
scenario.add_object(object_1);
scenario.add_object(object_2);
