%% This is a scenario file, which can be read in by the MATE-Scenario-Creator-Plugin.
% File Version: VERSION_11

%% Scenario Description:
% This scenario includes the EGO-object, named 'Host'. Internal name is 'object_1'.
% This scenario includes the TARGET-object, named 'Target vehicle'. Internal name is 'object_2'.
% This scenario includes the TARGET-object, named 'Target right'. Internal name is 'object_3'.
% This scenario includes the TARGET-object, named 'Target left'. Internal name is 'object_4'.
% The dimensions of 'object_1' are set to [Width: 2 m, Length: 5 m, PivotPoint: 0 m].
% The dimensions of 'object_2' are set to [Width: 2 m, Length: 5 m, PivotPoint: 0 m].
% The dimensions of 'object_3' are set to [Width: 2 m, Length: 5 m, PivotPoint: 0 m].
% The dimensions of 'object_4' are set to [Width: 2 m, Length: 5 m, PivotPoint: 0 m].
% The initial conditions of Host are set to: [Start-Speed: 0 kph, Start-Heading: 0 deg].
% The initial conditions of Target vehicle are set to: [Start-Speed: 30 kph, Start-Heading: -90 deg].
% The initial conditions of Target right are set to: [Start-Speed: 0 kph, Start-Heading: 0 deg].
% The initial conditions of Target left are set to: [Start-Speed: 0 kph, Start-Heading: 0 deg].
% The start position of Target vehicle is shifted by Lateral-Offset: -8 m, Longitudinal-Offset: -50 mHeading: 0°.
% The start position of Target right is shifted by Lateral-Offset: 3 m, Longitudinal-Offset: -0.15 mHeading: 0°.
% The start position of Target left is shifted by Lateral-Offset: -3 m, Longitudinal-Offset: -0.15 mHeading: 0°.
% Add a stationary section to Host with: Duration: 10 s, Section-Generic-Properties().
% Add a straight section to Target vehicle with: End-Speed: 30 kph, Distance: 40 m, Section-Generic-Properties( Tracker-Data.Status: COASTED ).
% Add a straight section to Target vehicle with: End-Speed: 30 kph, Distance: 20 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a stationary section to Target right with: Duration: 10 s, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a stationary section to Target left with: Duration: 10 s, Section-Generic-Properties( Tracker-Data.Status: MATURE ).

%% Set up enums
[enum_object_types, enum_object_specific_variants]  = enum_base.get_by_name('enum_object_types', 'enum_object_specific_variants');
[enum_track_status_T, enum_collision_point, enum_track_object_class] = enum_base.get_by_name('enum_track_status_T', 'enum_collision_point', 'enum_track_object_class');

%% Create Objects and define start and end conditions of the scenario
% Mandatory: Create objects for scenario (Type[enum], Name[char])
object_1 = class_scenario_properties(enum_object_types.EGO, 'Host');
object_2 = class_scenario_properties(enum_object_types.TARGET, 'Target vehicle');
object_3 = class_scenario_properties(enum_object_types.TARGET, 'Target right');
object_4 = class_scenario_properties(enum_object_types.TARGET, 'Target left');

% Mandatory: Define start objects dimensions (Width[m], Length[m], Pivot_Point[m]) OR (Preset[enum])
object_1.set_dimension(2, 5, 0);
object_2.set_dimension(2, 5, 0);
object_3.set_dimension(2, 5, 0);
object_4.set_dimension(2, 5, 0);

% Mandatory: Define objects starting values (Speed[kph], Heading[deg])
object_1.set_starting_values(0, 0);
object_2.set_starting_values(30, -90);
object_3.set_starting_values(0, 0);
object_4.set_starting_values(0, 0);

% Optional: Define objects to end its scenario together with ego

% Optional: Define objects to have collision with Ego (Collision_Point[enum], CP-Lat-Offset[%], CP-Long-Offset[%])

% Optional: Define end position offsets for targets (Lat.[m] / Long.[m])
object_2.set_start_pos_offsets(-8, -50, 0);
object_3.set_start_pos_offsets(3, -0.15, 0);
object_4.set_start_pos_offsets(-3, -0.15, 0);

%% Define trajectories of the objects
section_generic_properties = class_section_generic_properties();
object_1.add_stationary_section(10, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.COASTED;
object_2.add_straight_section(30, 40, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_2.add_straight_section(30, 20, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_3.add_stationary_section(10, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_4.add_stationary_section(10, section_generic_properties);


%% Create scenario property, containing all of the objects.
scenario = class_scenario_creator();
scenario.set_version(enum_scenario_file_versions.VERSION_11);
scenario.set_polarion_info('CSCSA-46498', 'SF-205,SF-200');
scenario.set_test_type('Simulation');
scenario.set_default_timestep(0.05);
scenario.add_object(object_1);
scenario.add_object(object_2);
scenario.add_object(object_3);
scenario.add_object(object_4);
