%% This is a scenario file, which can be read in by the MATE-Scenario-Creator-Plugin.
% File Version: VERSION_11

%% Scenario Description:
% This scenario includes the EGO-object, named 'Ego'. Internal name is 'object_1'.
% This scenario includes the TARGET-object, named 'Target_1'. Internal name is 'object_2'.
% This scenario includes the TARGET-object, named 'Target_2'. Internal name is 'object_3'.
% The dimensions of Ego are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The dimensions of Target_1 are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The dimensions of Target_2 are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The initial conditions of Ego are set to: [Start-Speed: 0 kph, Start-Heading: 0 deg].
% The initial conditions of Target_1 are set to: [Start-Speed: 20 kph, Start-Heading: 135 deg].
% The initial conditions of Target_2 are set to: [Start-Speed: 0 kph, Start-Heading: 0 deg].
% Shift the scenario of Target_1 so that it has a collision with the Ego at following Collision-Points:
% -> Ego-Collision-Point: REAR_LEFT (Lateral offset: 0%, Longitudinal offset: 0%).
% -> Target-Collision-Point: FRONT_LEFT (Lateral offset: 0%, Longitudinal offset: 0%).
% Shift the scenario of Target_2 so that it has a collision with the Ego at following Collision-Points:
% -> Ego-Collision-Point: REAR_LEFT (Lateral offset: 0%, Longitudinal offset: 0%).
% -> Target-Collision-Point: REAR_RIGHT (Lateral offset: 0%, Longitudinal offset: 0%).
% The start position of Target_1 is shifted by Lateral-Offset: 2.5 m, Longitudinal-Offset: 10 mHeading: 0°.
% The start position of Target_2 is shifted by Lateral-Offset: -0.7 m, Longitudinal-Offset: -0.4 mHeading: 0°.
% Add a stationary section to Ego with: Duration: 10 s, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Target_1 with: End-Speed: 20 kph, Distance: 70 m, Section-Generic-Properties( Tracker-Data.Status: MATURE  Precision: 2 ).
% Add a stationary section to Target_2 with: Duration: 10 s, Section-Generic-Properties( Tracker-Data.Status: MATURE ).

%% Set up enums
[enum_object_types, enum_object_specific_variants]  = enum_base.get_by_name('enum_object_types', 'enum_object_specific_variants');
[enum_track_status_T, enum_collision_point, enum_track_object_class] = enum_base.get_by_name('enum_track_status_T', 'enum_collision_point', 'enum_track_object_class');

%% Create Objects and define start and end conditions of the scenario
% Mandatory: Create objects for scenario (Type[enum], Name[char])
object_1 = class_scenario_properties(enum_object_types.EGO, 'Ego');
object_2 = class_scenario_properties(enum_object_types.TARGET, 'Target_1');
object_3 = class_scenario_properties(enum_object_types.TARGET, 'Target_2');

% Mandatory: Define start objects dimensions (Width[m], Length[m], Pivot_Point[m]) OR (Preset[enum])
object_1.set_dimension(enum_object_specific_variants.VEHICLE);
object_2.set_dimension(enum_object_specific_variants.VEHICLE);
object_3.set_dimension(enum_object_specific_variants.VEHICLE);

% Mandatory: Define objects starting values (Speed[kph], Heading[deg])
object_1.set_starting_values(0, 0);
object_2.set_starting_values(20, 135);
object_3.set_starting_values(0, 0);

% Optional: Define objects to end its scenario together with ego

% Optional: Define objects to have collision with Ego (Collision_Point[enum], CP-Lat-Offset[%], CP-Long-Offset[%])
object_2.set_egos_collision_point(enum_collision_point.REAR_LEFT, 0, 0);
object_2.set_targets_collision_point(enum_collision_point.FRONT_LEFT, 0, 0);
object_3.set_egos_collision_point(enum_collision_point.REAR_LEFT, 0, 0);
object_3.set_targets_collision_point(enum_collision_point.REAR_RIGHT, 0, 0);

% Optional: Define end position offsets for targets (Lat.[m] / Long.[m])
object_2.set_start_pos_offsets(2.5, 10, 0);
object_3.set_start_pos_offsets(-0.7, -0.4, 0);

%% Define trajectories of the objects
section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_1.add_stationary_section(10, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
section_generic_properties.precision = 2;
object_2.add_straight_section(20, 70, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_3.add_stationary_section(10, section_generic_properties);


%% Create scenario property, containing all of the objects.
scenario = class_scenario_creator();
scenario.set_version(enum_scenario_file_versions.VERSION_11);
scenario.set_polarion_info('', '');
scenario.set_test_type('');
scenario.set_default_timestep(0.05);
scenario.add_object(object_1);
scenario.add_object(object_2);
scenario.add_object(object_3);
