%% This is a scenario file, which can be read in by the MATE-Scenario-Creator-Plugin.
% File Version: VERSION_11

%% Scenario Description:
% This scenario includes the EGO-object, named 'Ego'. Internal name is 'object_1'.
% This scenario includes the TARGET-object, named 'Target'. Internal name is 'object_2'.
% This scenario includes the TARGET-object, named 'Target'. Internal name is 'object_3'.
% The dimensions of Ego are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The dimensions of Target are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The dimensions of Target are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The initial conditions of Ego are set to: [Start-Speed: 40 kph, Start-Heading: 0 deg].
% The initial conditions of Target are set to: [Start-Speed: 50 kph, Start-Heading: 0 deg].
% The initial conditions of Target are set to: [Start-Speed: 100 kph, Start-Heading: 0 deg].
% The start position of Target is shifted by Lateral-Offset: -3.5 m, Longitudinal-Offset: -30 mHeading: 0°.
% The start position of Target is shifted by Lateral-Offset: -7 m, Longitudinal-Offset: -40 mHeading: 0°.
% Register signal Ego with: Name: k_esa_f_allow_obj_critical_ttc_and_deceleration, Interpolation: enum_interpolation.PREVIOUS).
% Change signal value Ego: Name: k_esa_f_allow_obj_critical_ttc_and_deceleration, Value: 0).
% Register signal Ego with: Name: k_esa_f_allow_obj_selection_deceleration, Interpolation: enum_interpolation.PREVIOUS).
% Change signal value Ego: Name: k_esa_f_allow_obj_selection_deceleration, Value: 0).
% Register signal Ego with: Name: k_esa_f_allow_obj_selection_ttc, Interpolation: enum_interpolation.PREVIOUS).
% Change signal value Ego: Name: k_esa_f_allow_obj_selection_ttc, Value: 0).
% Register signal Ego with: Name: k_esa_f_allow_obj_selection_long_distance, Interpolation: enum_interpolation.PREVIOUS).
% Change signal value Ego: Name: k_esa_f_allow_obj_selection_long_distance, Value: 1).
% Add a straight section to Ego with: End-Speed: 40 kph, Distance: 40 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Target with: End-Speed: 50 kph, Distance: 50 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Target with: End-Speed: 100 kph, Distance: 30 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Target with: End-Speed: 70 kph, Distance: 10 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a clothoide section to Target with: End-Speed: 100 kph, End-Radius: 3 m, End-Heading: 45 deg, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a clothoide section to Target with: End-Speed: 100 kph, End-Radius: 3 m, End-Heading: -45 deg, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Target with: End-Speed: 50 kph, Distance: 30 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).

%% Set up enums
[enum_object_types, enum_object_specific_variants]  = enum_base.get_by_name('enum_object_types', 'enum_object_specific_variants');
[enum_track_status_T, enum_collision_point, enum_track_object_class] = enum_base.get_by_name('enum_track_status_T', 'enum_collision_point', 'enum_track_object_class');

%% Create Objects and define start and end conditions of the scenario
% Mandatory: Create objects for scenario (Type[enum], Name[char])
object_1 = class_scenario_properties(enum_object_types.EGO, 'Ego');
object_2 = class_scenario_properties(enum_object_types.TARGET, 'Target');
object_3 = class_scenario_properties(enum_object_types.TARGET, 'Target');

% Mandatory: Define start objects dimensions (Width[m], Length[m], Pivot_Point[m]) OR (Preset[enum])
object_1.set_dimension(enum_object_specific_variants.VEHICLE);
object_2.set_dimension(enum_object_specific_variants.VEHICLE);
object_3.set_dimension(enum_object_specific_variants.VEHICLE);

% Mandatory: Define objects starting values (Speed[kph], Heading[deg])
object_1.set_starting_values(40, 0);
object_2.set_starting_values(50, 0);
object_3.set_starting_values(100, 0);

% Optional: Define objects to end its scenario together with ego

% Optional: Define objects to have collision with Ego (Collision_Point[enum], CP-Lat-Offset[%], CP-Long-Offset[%])

% Optional: Define end position offsets for targets (Lat.[m] / Long.[m])
object_2.set_start_pos_offsets(-3.5, -30, 0);
object_3.set_start_pos_offsets(-7, -40, 0);

%% Define trajectories of the objects
object_1.add_section_signal_register('k_esa_f_allow_obj_critical_ttc_and_deceleration', enum_interpolation.PREVIOUS);
object_1.add_section_signal_change('k_esa_f_allow_obj_critical_ttc_and_deceleration', 0);
object_1.add_section_signal_register('k_esa_f_allow_obj_selection_deceleration', enum_interpolation.PREVIOUS);
object_1.add_section_signal_change('k_esa_f_allow_obj_selection_deceleration', 0);
object_1.add_section_signal_register('k_esa_f_allow_obj_selection_ttc', enum_interpolation.PREVIOUS);
object_1.add_section_signal_change('k_esa_f_allow_obj_selection_ttc', 0);
object_1.add_section_signal_register('k_esa_f_allow_obj_selection_long_distance', enum_interpolation.PREVIOUS);
object_1.add_section_signal_change('k_esa_f_allow_obj_selection_long_distance', 1);
section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_1.add_straight_section(40, 40, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_2.add_straight_section(50, 50, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_3.add_straight_section(100, 30, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_3.add_straight_section(70, 10, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_3.add_clothoide_by_tau_section(100, 3, 45, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_3.add_clothoide_by_tau_section(100, 3, -45, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_3.add_straight_section(50, 30, section_generic_properties);


%% Create scenario property, containing all of the objects.
scenario = class_scenario_creator();
scenario.set_version(enum_scenario_file_versions.VERSION_11);
scenario.set_polarion_info('CSCSA-139085', 'CSCSA-68596,CSCSA-68598,CSCSA-69927,CSCSA-69925');
scenario.set_test_type('positive');
scenario.set_default_timestep(0.05);
scenario.add_object(object_1);
scenario.add_object(object_2);
scenario.add_object(object_3);
