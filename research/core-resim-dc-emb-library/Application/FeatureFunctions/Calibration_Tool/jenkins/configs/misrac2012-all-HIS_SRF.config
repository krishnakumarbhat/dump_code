// Do not edit this file! Make a copy and edit it to produce your own configuration
// Configuration for MISRA C-2012, rule categories: Required, Advisory, Mandatory
{
    "version": "2.0",
    "standard": "misrac2012",
    "title": "MISRA C-2012 All Rules with HIS Metrics",
    "deviations": [
        { deviation: "Directive 4.8", reason: "based on the team'e2'80'99s analysis, decided to disable MISRA directive 4.8 from the checks, since it is not adding any value." },
        { deviation: "Directive 4.9", reason: "This rule has been disabled in Coverity and will be supported via peer review." },
     ],

    HIS_Metrics : {
         raw_metrics_filename : "raw-metrics.txt",     // file in the output folder to which to dump the raw metrics for each function
         html_report_filename : "HIS_report.html",   // The HTML report file
         policies : [    // Optional list of policies for each HIS metric
            {
                 name :  "COMF",          // Could be one COMF, PATH, GOTO, CCM, CALLING, CALLS, PARAM, STMT, LEVEL, RETURN, VOCF, CYCLE
                 compliant_range : {low : 0.2, }     // High and low values for the compliant range for this metric. Both are optional.
            },
            {
                 name :  "PATH",          // Could be one COMF, PATH, GOTO, CCM, CALLING, CALLS, PARAM, STMT, LEVEL, RETURN, VOCF, CYCLE
                 compliant_range : {low : 1, high : 80,}     // High and low values for the compliant range for this metric. Both are optional.
            },
            {
                 name :  "GOTO",          // Could be one COMF, PATH, GOTO, CCM, CALLING, CALLS, PARAM, STMT, LEVEL, RETURN, VOCF, CYCLE
                 compliant_range : {high : 0,}     // High and low values for the compliant range for this metric. Both are optional.
            },
            {
                 name :  "CCM",          // Could be one COMF, PATH, GOTO, CCM, CALLING, CALLS, PARAM, STMT, LEVEL, RETURN, VOCF, CYCLE
                 compliant_range : {low : 0, high : 15,}     // High and low values for the compliant range for this metric. Both are optional.
            },
            {
                 name :  "CALLING",          // Could be one COMF, PATH, GOTO, CCM, CALLING, CALLS, PARAM, STMT, LEVEL, RETURN, VOCF, CYCLE
                 compliant_range : {low : 0, high : 5,}     // High and low values for the compliant range for this metric. Both are optional.
            },
            {
                 name :  "CALLS",          // Could be one COMF, PATH, GOTO, CCM, CALLING, CALLS, PARAM, STMT, LEVEL, RETURN, VOCF, CYCLE
                 compliant_range : {low : 0, high : 7,}     // High and low values for the compliant range for this metric. Both are optional.
            },
            {
                 name :  "PARAM",          // Could be one COMF, PATH, GOTO, CCM, CALLING, CALLS, PARAM, STMT, LEVEL, RETURN, VOCF, CYCLE
                 compliant_range : {low : 0, high : 5,}     // High and low values for the compliant range for this metric. Both are optional.
            },
            {
                 name :  "STMT",          // Could be one COMF, PATH, GOTO, CCM, CALLING, CALLS, PARAM, STMT, LEVEL, RETURN, VOCF, CYCLE
                 compliant_range : {low : 1, high : 50,}     // High and low values for the compliant range for this metric. Both are optional.
            },
            {
                 name :  "LEVEL",          // Could be one COMF, PATH, GOTO, CCM, CALLING, CALLS, PARAM, STMT, LEVEL, RETURN, VOCF, CYCLE
                 compliant_range : {low : 0, high : 4,}     // High and low values for the compliant range for this metric. Both are optional.
            },
            {
                 name :  "RETURN",          // Could be one COMF, PATH, GOTO, CCM, CALLING, CALLS, PARAM, STMT, LEVEL, RETURN, VOCF, CYCLE
                 compliant_range : {low : 0, high : 1,}     // High and low values for the compliant range for this metric. Both are optional.
            },
            {
                 name :  "VOCF",          // Could be one COMF, PATH, GOTO, CCM, CALLING, CALLS, PARAM, STMT, LEVEL, RETURN, VOCF, CYCLE
                 compliant_range : {low : 1, high : 4,}     // High and low values for the compliant range for this metric. Both are optional.
            },
            {
                 name :  "CYCLE",          // Could be one COMF, PATH, GOTO, CCM, CALLING, CALLS, PARAM, STMT, LEVEL, RETURN, VOCF, CYCLE
                 compliant_range : {high : 0,}     // High and low values for the compliant range for this metric. Both are optional.
            }
         ]
    }
}
