%% This is a scenario file, which can be read in by the MATE-Scenario-Creator-Plugin.
% File Version: VERSION_11

%% Scenario Description:
% This scenario includes the EGO-object, named 'Ego'. Internal name is 'object_1'.
% This scenario includes the TARGET-object, named 'Target_right'. Internal name is 'object_2'.
% This scenario includes the TARGET-object, named 'Target_left'. Internal name is 'object_3'.
% The dimensions of Ego are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The dimensions of Target_right are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The dimensions of Target_left are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The initial conditions of Ego are set to: [Start-Speed: 50 kph, Start-Heading: 0 deg].
% The initial conditions of Target_right are set to: [Start-Speed: 50 kph, Start-Heading: 0 deg].
% The initial conditions of Target_left are set to: [Start-Speed: 50 kph, Start-Heading: 0 deg].
% The start position of Target_right is shifted by Lateral-Offset: 7 m, Longitudinal-Offset: 0 mHeading: 0°.
% The start position of Target_left is shifted by Lateral-Offset: -7 m, Longitudinal-Offset: 0 mHeading: 0°.
% Add a straight section to Ego with: End-Speed: 50 kph, Distance: 20.8 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Ego with: End-Speed: 50 kph, Distance: 100 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Ego with: End-Speed: 50 kph, Distance: 50 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Target_right with: End-Speed: 50 kph, Distance: 20.8 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Target_right with: End-Speed: 50 kph, Distance: 50 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a clothoide section to Target_right with: End-Speed: 50 kph, End-Radius: -90 m, Arc-Length: 25 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a clothoide section to Target_right with: End-Speed: 50 kph, End-Radius: 90 m, Arc-Length: 25 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Target_right with: End-Speed: 50 kph, Distance: 50 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Target_left with: End-Speed: 50 kph, Distance: 20.8 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Target_left with: End-Speed: 50 kph, Distance: 50 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a clothoide section to Target_left with: End-Speed: 50 kph, End-Radius: 90 m, Arc-Length: 25 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a clothoide section to Target_left with: End-Speed: 50 kph, End-Radius: -90 m, Arc-Length: 25 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Target_left with: End-Speed: 50 kph, Distance: 50 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).

%% Set up enums
[enum_object_types, enum_object_specific_variants]  = enum_base.get_by_name('enum_object_types', 'enum_object_specific_variants');
[enum_track_status_T, enum_collision_point, enum_track_object_class] = enum_base.get_by_name('enum_track_status_T', 'enum_collision_point', 'enum_track_object_class');

%% Create Objects and define start and end conditions of the scenario
% Mandatory: Create objects for scenario (Type[enum], Name[char])
object_1 = class_scenario_properties(enum_object_types.EGO, 'Ego');
object_2 = class_scenario_properties(enum_object_types.TARGET, 'Target_right');
object_3 = class_scenario_properties(enum_object_types.TARGET, 'Target_left');

% Mandatory: Define start objects dimensions (Width[m], Length[m], Pivot_Point[m]) OR (Preset[enum])
object_1.set_dimension(enum_object_specific_variants.VEHICLE);
object_2.set_dimension(enum_object_specific_variants.VEHICLE);
object_3.set_dimension(enum_object_specific_variants.VEHICLE);

% Mandatory: Define objects starting values (Speed[kph], Heading[deg])
object_1.set_starting_values(50, 0);
object_2.set_starting_values(50, 0);
object_3.set_starting_values(50, 0);

% Optional: Define objects to end its scenario together with ego

% Optional: Define objects to have collision with Ego (Collision_Point[enum], CP-Lat-Offset[%], CP-Long-Offset[%])

% Optional: Define end position offsets for targets (Lat.[m] / Long.[m])
object_2.set_start_pos_offsets(7, 0, 0);
object_3.set_start_pos_offsets(-7, 0, 0);


%% BMW SP25 specific input signals
object_1.add_section_signal_register('speed_kph', enum_interpolation.PREVIOUS);
object_1.add_section_signal_change('speed_kph', 50);
object_1.add_section_signal_register('vehicle_driving_direction', enum_interpolation.PREVIOUS);
object_1.add_section_signal_change('vehicle_driving_direction', 1);
object_1.add_section_signal_register('vehicle_condition', enum_interpolation.PREVIOUS);
object_1.add_section_signal_change('vehicle_condition', 10);

%% Define trajectories of the objects
section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_1.add_straight_section(50, 20.8, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_1.add_straight_section(50, 100, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_1.add_straight_section(50, 50, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_2.add_straight_section(50, 20.8, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_2.add_straight_section(50, 50, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_2.add_clothoide_by_length_section(50, -90, 25, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_2.add_clothoide_by_length_section(50, 90, 25, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_2.add_straight_section(50, 50, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_3.add_straight_section(50, 20.8, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_3.add_straight_section(50, 50, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_3.add_clothoide_by_length_section(50, 90, 25, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_3.add_clothoide_by_length_section(50, -90, 25, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_3.add_straight_section(50, 50, section_generic_properties);


%% Create scenario property, containing all of the objects.
scenario = class_scenario_creator();
scenario.set_version(enum_scenario_file_versions.VERSION_11);
scenario.set_polarion_info('CSCSA-47238', 'SF-2100,SF-2099,SF-2101');
scenario.set_test_type('positive');
scenario.set_default_timestep(0.05);
scenario.add_object(object_1);
scenario.add_object(object_2);
scenario.add_object(object_3);
