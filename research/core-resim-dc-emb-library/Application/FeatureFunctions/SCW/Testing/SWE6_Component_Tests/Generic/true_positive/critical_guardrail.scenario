%% This is a scenario file, which can be read in by the MATE-Scenario-Creator-Plugin.
% File Version: VERSION_11

%% Scenario Description:
% This scenario includes the EGO-object, named 'Ego'. Internal name is 'object_1'.
% The dimensions of Ego are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The initial conditions of Ego are set to: [Start-Speed: 50 kph, Start-Heading: 0 deg].
% Register signal Ego with: Name: guardrail_lateral_position_1, Interpolation: enum_interpolation.LINEAR).
% Register signal Ego with: Name: guardrail_lateral_position_2, Interpolation: enum_interpolation.LINEAR).
% Register signal Ego with: Name: guardrail_existence_probability_1, Interpolation: enum_interpolation.PREVIOUS).
% Register signal Ego with: Name: guardrail_existence_probability_2, Interpolation: enum_interpolation.PREVIOUS).
% Register signal Ego with: Name: guardrail_f_active_1, Interpolation: enum_interpolation.PREVIOUS).
% Register signal Ego with: Name: guardrail_f_active_2, Interpolation: enum_interpolation.PREVIOUS).
% Register signal Ego with: Name: f_guardrail_present_1, Interpolation: enum_interpolation.PREVIOUS).
% Register signal Ego with: Name: f_guardrail_present_2, Interpolation: enum_interpolation.PREVIOUS).
% Register signal Ego with: Name: guardrail_status_1, Interpolation: enum_interpolation.PREVIOUS).
% Register signal Ego with: Name: guardrail_status_2, Interpolation: enum_interpolation.PREVIOUS).
% Register signal Ego with: Name: guardrail_age_1, Interpolation: enum_interpolation.PREVIOUS).
% Register signal Ego with: Name: guardrail_age_2, Interpolation: enum_interpolation.PREVIOUS).
% Change signal value Ego: Name: guardrail_lateral_position_1, Value: -2).
% Change signal value Ego: Name: guardrail_lateral_position_2, Value: 2).
% Change signal value Ego: Name: guardrail_existence_probability_1, Value: 100).
% Change signal value Ego: Name: guardrail_existence_probability_2, Value: 100).
% Change signal value Ego: Name: guardrail_status_1, Value: 2).
% Change signal value Ego: Name: guardrail_status_2, Value: 2).
% Change signal value Ego: Name: guardrail_age_1, Value: 10).
% Change signal value Ego: Name: guardrail_age_2, Value: 10).
% Change signal value Ego: Name: guardrail_f_active_1, Value: 1).
% Change signal value Ego: Name: guardrail_f_active_2, Value: 1).
% Change signal value Ego: Name: f_guardrail_present_1, Value: 1).
% Change signal value Ego: Name: f_guardrail_present_2, Value: 1).
% Add a straight section to Ego with: End-Speed: 50 kph, Distance: 20.8 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Ego with: End-Speed: 50 kph, Distance: 100 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Ego with: End-Speed: 50 kph, Distance: 50 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).

%% Set up enums
[enum_object_types, enum_object_specific_variants]  = enum_base.get_by_name('enum_object_types', 'enum_object_specific_variants');
[enum_track_status_T, enum_collision_point, enum_track_object_class] = enum_base.get_by_name('enum_track_status_T', 'enum_collision_point', 'enum_track_object_class');

%% Create Objects and define start and end conditions of the scenario
% Mandatory: Create objects for scenario (Type[enum], Name[char])
object_1 = class_scenario_properties(enum_object_types.EGO, 'Ego');

% Mandatory: Define start objects dimensions (Width[m], Length[m], Pivot_Point[m]) OR (Preset[enum])
object_1.set_dimension(enum_object_specific_variants.VEHICLE);

% Mandatory: Define objects starting values (Speed[kph], Heading[deg])
object_1.set_starting_values(50, 0);

% Optional: Define objects to end its scenario together with ego

% Optional: Define objects to have collision with Ego (Collision_Point[enum], CP-Lat-Offset[%], CP-Long-Offset[%])

% Optional: Define end position offsets for targets (Lat.[m] / Long.[m])

%% Define trajectories of the objects
object_1.add_section_signal_register('guardrail_lateral_position_1', enum_interpolation.LINEAR);
object_1.add_section_signal_register('guardrail_lateral_position_2', enum_interpolation.LINEAR);
object_1.add_section_signal_register('guardrail_existence_probability_1', enum_interpolation.PREVIOUS);
object_1.add_section_signal_register('guardrail_existence_probability_2', enum_interpolation.PREVIOUS);
object_1.add_section_signal_register('guardrail_f_active_1', enum_interpolation.PREVIOUS);
object_1.add_section_signal_register('guardrail_f_active_2', enum_interpolation.PREVIOUS);
object_1.add_section_signal_register('f_guardrail_present_1', enum_interpolation.PREVIOUS);
object_1.add_section_signal_register('f_guardrail_present_2', enum_interpolation.PREVIOUS);
object_1.add_section_signal_register('guardrail_status_1', enum_interpolation.PREVIOUS);
object_1.add_section_signal_register('guardrail_status_2', enum_interpolation.PREVIOUS);
object_1.add_section_signal_register('guardrail_age_1', enum_interpolation.PREVIOUS);
object_1.add_section_signal_register('guardrail_age_2', enum_interpolation.PREVIOUS);
object_1.add_section_signal_change('guardrail_lateral_position_1', -2);
object_1.add_section_signal_change('guardrail_lateral_position_2', 2);
object_1.add_section_signal_change('guardrail_existence_probability_1', 100);
object_1.add_section_signal_change('guardrail_existence_probability_2', 100);
object_1.add_section_signal_change('guardrail_status_1', 2);
object_1.add_section_signal_change('guardrail_status_2', 2);
object_1.add_section_signal_change('guardrail_age_1', 10);
object_1.add_section_signal_change('guardrail_age_2', 10);
object_1.add_section_signal_change('guardrail_f_active_1', 1);
object_1.add_section_signal_change('guardrail_f_active_2', 1);
object_1.add_section_signal_change('f_guardrail_present_1', 1);
object_1.add_section_signal_change('f_guardrail_present_2', 1);
section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_1.add_straight_section(50, 20.8, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_1.add_straight_section(50, 100, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_1.add_straight_section(50, 50, section_generic_properties);


%% Create scenario property, containing all of the objects.
scenario = class_scenario_creator();
scenario.set_version(enum_scenario_file_versions.VERSION_11);
scenario.set_polarion_info('CSCSA-226506', 'SF-2119,SF-2120,SF-2137');
scenario.set_test_type('Simulation');
scenario.set_default_timestep(0.05);
scenario.add_object(object_1);
