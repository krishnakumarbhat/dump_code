%% This is a scenario file, which can be read in by the MATE-Scenario-Creator-Plugin.
% File Version: VERSION_11

%% Scenario Description:
% This scenario includes the EGO-object, named 'Ego'. Internal name is 'object_1'.
% This scenario includes the TARGET-object, named 'Target'. Internal name is 'object_2'.
% The dimensions of Ego are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The dimensions of Target are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The initial conditions of Ego are set to: [Start-Speed: 50 kph, Start-Heading: 0 deg].
% The initial conditions of Target are set to: [Start-Speed: 50 kph, Start-Heading: 0 deg].
% The start position of Target is shifted by Lateral-Offset: 7 m, Longitudinal-Offset: -12 mHeading: 0°.
% Register signal Ego with: Name: f_trailer_present, Interpolation: enum_interpolation.PREVIOUS).
% Change signal value Ego: Name: f_trailer_present, Value: 1).
% Register signal Ego with: Name: trailer_length, Interpolation: enum_interpolation.PREVIOUS).
% Change signal value Ego: Name: trailer_length, Value: 5).
% Register signal Ego with: Name: trailer_width, Interpolation: enum_interpolation.PREVIOUS).
% Change signal value Ego: Name: trailer_width, Value: 2).
% Add a straight section to Ego with: End-Speed: 50 kph, Distance: 50 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a clothoide section to Ego with: End-Speed: 50 kph, End-Radius: 90 m, Arc-Length: 25 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a clothoide section to Ego with: End-Speed: 50 kph, End-Radius: -90 m, Arc-Length: 25 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Ego with: End-Speed: 50 kph, Distance: 50 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Target with: End-Speed: 50 kph, Distance: 50 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a clothoide section to Target with: End-Speed: 50 kph, End-Radius: -90 m, Arc-Length: 25 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a clothoide section to Target with: End-Speed: 50 kph, End-Radius: 90 m, Arc-Length: 25 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Target with: End-Speed: 50 kph, Distance: 50 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).

%% Set up enums
[enum_object_types, enum_object_specific_variants]  = enum_base.get_by_name('enum_object_types', 'enum_object_specific_variants');
[enum_track_status_T, enum_collision_point, enum_track_object_class] = enum_base.get_by_name('enum_track_status_T', 'enum_collision_point', 'enum_track_object_class');

%% Create Objects and define start and end conditions of the scenario
% Mandatory: Create objects for scenario (Type[enum], Name[char])
object_1 = class_scenario_properties(enum_object_types.EGO, 'Ego');
object_2 = class_scenario_properties(enum_object_types.TARGET, 'Target');

% Mandatory: Define start objects dimensions (Width[m], Length[m], Pivot_Point[m]) OR (Preset[enum])
object_1.set_dimension(enum_object_specific_variants.VEHICLE);
object_2.set_dimension(enum_object_specific_variants.VEHICLE);

% Mandatory: Define objects starting values (Speed[kph], Heading[deg])
object_1.set_starting_values(50, 0);
object_2.set_starting_values(50, 0);

% Optional: Define objects to end its scenario together with ego

% Optional: Define objects to have collision with Ego (Collision_Point[enum], CP-Lat-Offset[%], CP-Long-Offset[%])

% Optional: Define end position offsets for targets (Lat.[m] / Long.[m])
object_2.set_start_pos_offsets(7, -12, 0);

%% Define trajectories of the objects
object_1.add_section_signal_register('f_trailer_present', enum_interpolation.PREVIOUS);
object_1.add_section_signal_change('f_trailer_present', 1);
object_1.add_section_signal_register('trailer_length', enum_interpolation.PREVIOUS);
object_1.add_section_signal_change('trailer_length', 5);
object_1.add_section_signal_register('trailer_width', enum_interpolation.PREVIOUS);
object_1.add_section_signal_change('trailer_width', 2);
section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_1.add_straight_section(50, 50, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_1.add_clothoide_by_length_section(50, 90, 25, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_1.add_clothoide_by_length_section(50, -90, 25, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_1.add_straight_section(50, 50, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_2.add_straight_section(50, 50, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_2.add_clothoide_by_length_section(50, -90, 25, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_2.add_clothoide_by_length_section(50, 90, 25, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_2.add_straight_section(50, 50, section_generic_properties);


%% Create scenario property, containing all of the objects.
scenario = class_scenario_creator();
scenario.set_version(enum_scenario_file_versions.VERSION_11);
scenario.set_polarion_info('CSCSA-113392', 'CSCSA-232451,CSCSA-230232,CSCSA-230230,CSCSA-229333,CSCSA-230231,CSCSA-181169,CSCSA-230785,CSCSA-181168,CSCSA-181170,CSCSA-184088,CSCSA-184101,CSCSA-184092,CSCSA-184093,CSCSA-184090,CSCSA-184100,CSCSA-231793,CSCSA-230775,CSCSA-231795,CSCSA-230918,CSCSA-230924,CSCSA-231790,CSCSA-230919,CSCSA-230920,CSCSA-231794,CSCSA-231792,CSCSA-230774,CSCSA-231786,CSCSA-231789,CSCSA-231788,CSCSA-230922,CSCSA-231785,CSCSA-231791,CSCSA-230921,CSCSA-230699,CSCSA-231784,CSCSA-230733,CSCSA-231787');
scenario.set_test_type('Simulation');
scenario.set_default_timestep(0.05);
scenario.add_object(object_1);
scenario.add_object(object_2);
