%% This is a scenario file, which can be read in by the MATE-Scenario-Creator-Plugin.
% File Version: VERSION_11

%% Scenario Description:
% This scenario includes the TARGET-object, named 'Target1'. Internal name is 'object_1'.
% This scenario includes the EGO-object, named 'Ego'. Internal name is 'object_2'.
% This scenario includes the TARGET-object, named 'Target2_moving_long'. Internal name is 'object_3'.
% The dimensions of Target1 are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The dimensions of Ego are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The dimensions of Target2_moving_long are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The initial conditions of Target1 are set to: [Start-Speed: 30 kph, Start-Heading: 0 deg].
% The initial conditions of Ego are set to: [Start-Speed: 0 kph, Start-Heading: 0 deg].
% The initial conditions of Target2_moving_long are set to: [Start-Speed: 30 kph, Start-Heading: 0 deg].
% The start position of Target1 is shifted by Lateral-Offset: 5 m, Longitudinal-Offset: -25 mHeading: 0°.
% The start position of Target2_moving_long is shifted by Lateral-Offset: 5 m, Longitudinal-Offset: -20 mHeading: 0°.
% Add a straight section to Target1 with: End-Speed: 30 kph, Distance: 50 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a stationary section to Ego with: Duration: 10 s, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a stationary section to Target2_moving_long with: Duration: 7 s, Section-Generic-Properties().
% Add a straight section to Target2_moving_long with: End-Speed: 20 kph, Distance: 30 m, Section-Generic-Properties().

%% Set up enums
[enum_object_types, enum_object_specific_variants]  = enum_base.get_by_name('enum_object_types', 'enum_object_specific_variants');
[enum_track_status_T, enum_collision_point, enum_track_object_class] = enum_base.get_by_name('enum_track_status_T', 'enum_collision_point', 'enum_track_object_class');

%% Create Objects and define start and end conditions of the scenario
% Mandatory: Create objects for scenario (Type[enum], Name[char])
object_1 = class_scenario_properties(enum_object_types.TARGET, 'Target1');
object_2 = class_scenario_properties(enum_object_types.EGO, 'Ego');
object_3 = class_scenario_properties(enum_object_types.TARGET, 'Target2_moving_long');

% Mandatory: Define start objects dimensions (Width[m], Length[m], Pivot_Point[m]) OR (Preset[enum])
object_1.set_dimension(enum_object_specific_variants.VEHICLE);
object_2.set_dimension(enum_object_specific_variants.VEHICLE);
object_3.set_dimension(enum_object_specific_variants.VEHICLE);

% Mandatory: Define objects starting values (Speed[kph], Heading[deg])
object_1.set_starting_values(30, 0);
object_2.set_starting_values(0, 0);
object_3.set_starting_values(30, 0);

% Optional: Define objects to end its scenario together with ego

% Optional: Define objects to have collision with Ego (Collision_Point[enum], CP-Lat-Offset[%], CP-Long-Offset[%])

% Optional: Define end position offsets for targets (Lat.[m] / Long.[m])
object_1.set_start_pos_offsets(5, -25, 0);
object_3.set_start_pos_offsets(5, -20, 0);

%% Define trajectories of the objects
section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_1.add_straight_section(30, 50, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_2.add_stationary_section(10, section_generic_properties);

section_generic_properties = class_section_generic_properties();
object_3.add_stationary_section(7, section_generic_properties);

section_generic_properties = class_section_generic_properties();
object_3.add_straight_section(20, 30, section_generic_properties);


%% Create scenario property, containing all of the objects.
scenario = class_scenario_creator();
scenario.set_version(enum_scenario_file_versions.VERSION_11);
scenario.set_polarion_info('CSCSA-47077', 'SF-1564');
scenario.set_test_type('negative');
scenario.set_default_timestep(0.05);
scenario.add_object(object_1);
scenario.add_object(object_2);
scenario.add_object(object_3);
