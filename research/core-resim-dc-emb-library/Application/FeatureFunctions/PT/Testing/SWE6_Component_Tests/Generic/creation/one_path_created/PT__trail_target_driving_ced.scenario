%% This is a scenario file, which can be read in by the MATE-Scenario-Creator-Plugin.
% File Version: VERSION_10

%% Scenario Description:
% This scenario includes the EGO-object, named 'Ego'. Internal name is 'object_1'.
% The dimensions of Ego are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The initial conditions of Ego are set to: [Start-Speed: 20 kph, Start-Heading: 0 deg].
% Add a straight section to Ego with: End-Speed: 20 kph, Distance: 40 m, Precision: 1, Tracker-data( Track-Status: MATURE ).
% Add a clothoide section to Ego with: End-Speed: 20 kph, End-Radius: 6 m, End-Heading: 40 deg, Precision: 1, Tracker-data( Track-Status: MATURE ).
% Add a clothoide section to Ego with: End-Speed: 20 kph, End-Radius: 6 m, End-Heading: -40 deg, Precision: 1, Tracker-data( Track-Status: MATURE ).
% Add a straight section to Ego with: End-Speed: 10 kph, Distance: 5 m, Precision: 1, Tracker-data( Track-Status: MATURE ).
% Add a straight section to Ego with: End-Speed: 10 kph, Distance: 10 m, Precision: 1, Tracker-data( Track-Status: MATURE ).
% Add a stationary section to Ego with: Duration: 3 s, Tracker-data( Track-Status: MATURE ).

%% Set up enums
[enum_object_types, enum_object_specific_variants]  = enum_base.get_by_name('enum_object_types', 'enum_object_specific_variants');
[enum_track_status_T, enum_collision_point, enum_track_object_class] = enum_base.get_by_name('enum_track_status_T', 'enum_collision_point', 'enum_track_object_class');

%% Create Objects and define start and end conditions of the scenario
% Mandatory: Create objects for scenario (Type[enum], Name[char])
object_1 = class_scenario_properties(enum_object_types.EGO, 'Ego');

% Mandatory: Define start objects dimensions (Width[m], Length[m], Pivot_Point[m]) OR (Preset[enum])
object_1.set_dimension(enum_object_specific_variants.VEHICLE);

% Mandatory: Define objects starting values (Speed[kph], Heading[deg])
object_1.set_starting_values(20, 0);

% Optional: Define objects to end its scenario together with ego

% Optional: Define objects to have collision with Ego (Collision_Point[enum], CP-Lat-Offset[%], CP-Long-Offset[%])

% Optional: Define end position offsets for targets (Lat.[m] / Long.[m])

%% Define trajectories of the objects
tracker_data = class_scenario_tracker_data();
tracker_data.status = enum_track_status_T.MATURE;
object_1.add_straight_section(20, 40, 1, tracker_data);

tracker_data = class_scenario_tracker_data();
tracker_data.status = enum_track_status_T.MATURE;
object_1.add_clothoide_by_tau_section(20, 6, 40, 1, tracker_data);

tracker_data = class_scenario_tracker_data();
tracker_data.status = enum_track_status_T.MATURE;
object_1.add_clothoide_by_tau_section(20, 6, -40, 1, tracker_data);

tracker_data = class_scenario_tracker_data();
tracker_data.status = enum_track_status_T.MATURE;
object_1.add_straight_section(10, 5, 1, tracker_data);

tracker_data = class_scenario_tracker_data();
tracker_data.status = enum_track_status_T.MATURE;
object_1.add_straight_section(10, 10, 1, tracker_data);

tracker_data = class_scenario_tracker_data();
tracker_data.status = enum_track_status_T.MATURE;
object_1.add_stationary_section(3, tracker_data);


%% Create scenario property, containing all of the objects.
scenario = class_scenario_creator();
scenario.set_version(enum_scenario_file_versions.VERSION_10);
scenario.set_polarion_info('CSCSA-47085', '');
scenario.set_test_type('negative');
scenario.set_default_timestep(0.05);
scenario.add_object(object_1);
