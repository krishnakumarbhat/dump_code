% Add a stationary section to Target_ghost6 with: Duration: 3.8 s, Tracker-data( Track-Status: MATURE ).
% Add a straight section to Target_ghost6 with: End-Speed: 60 kph, Distance: 5 m, Precision: 1, Tracker-data( Track-Status: MATURE ).

%% Set up enums
[enum_object_types, enum_object_specific_variants]  = enum_base.get_by_name('enum_object_types', 'enum_object_specific_variants');
[enum_track_status_T, enum_collision_point, enum_track_object_class] = enum_base.get_by_name('enum_track_status_T', 'enum_collision_point', 'enum_track_object_class');

%% Create Objects and define start and end conditions of the scenario
% Mandatory: Create objects for scenario (Type[enum], Name[char])
object_1 = class_scenario_properties(enum_object_types.EGO, 'Ego');
object_2 = class_scenario_properties(enum_object_types.TARGET, 'Target');
object_3 = class_scenario_properties(enum_object_types.TARGET, 'Target_ghost');
object_4 = class_scenario_properties(enum_object_types.TARGET, 'Target_ghost2');
object_5 = class_scenario_properties(enum_object_types.TARGET, 'Target2');
object_6 = class_scenario_properties(enum_object_types.TARGET, 'Target_ghost3');
object_7 = class_scenario_properties(enum_object_types.TARGET, 'Target_ghost4');
object_8 = class_scenario_properties(enum_object_types.TARGET, 'Target_ghost5');
object_9 = class_scenario_properties(enum_object_types.TARGET, 'Target_ghost6');

% Mandatory: Define start objects dimensions (Width[m], Length[m], Pivot_Point[m]) OR (Preset[enum])
object_1.set_dimension(enum_object_specific_variants.VEHICLE);
object_2.set_dimension(enum_object_specific_variants.VEHICLE);
object_3.set_dimension(enum_object_specific_variants.VEHICLE);
object_4.set_dimension(enum_object_specific_variants.VEHICLE);
object_5.set_dimension(enum_object_specific_variants.VEHICLE);
object_6.set_dimension(enum_object_specific_variants.VEHICLE);
object_7.set_dimension(enum_object_specific_variants.VEHICLE);
object_8.set_dimension(enum_object_specific_variants.VEHICLE);
object_9.set_dimension(enum_object_specific_variants.VEHICLE);

% Mandatory: Define objects starting values (Speed[kph], Heading[deg])
object_1.set_starting_values(0, 0);
object_2.set_starting_values(50, 90);
object_3.set_starting_values(60, 30);
object_4.set_starting_values(60, -30);
object_5.set_starting_values(50, 180);
object_6.set_starting_values(60, 90);
object_7.set_starting_values(60, -90);
object_8.set_starting_values(60, 150);
object_9.set_starting_values(60, -150);

% Optional: Define objects to end its scenario together with ego

% Optional: Define objects to have collision with Ego (Collision_Point[enum], CP-Lat-Offset[%], CP-Long-Offset[%])

% Optional: Define end position offsets for targets (Lat.[m] / Long.[m])
object_2.set_start_pos_offsets(15, -30);
object_3.set_start_pos_offsets(2, -18);
object_4.set_start_pos_offsets(1, -20);
object_5.set_start_pos_offsets(15, -30);
object_6.set_start_pos_offsets(5, -18);
object_7.set_start_pos_offsets(10, 10);
object_8.set_start_pos_offsets(2, 15);
object_9.set_start_pos_offsets(6, 20);

%% Define trajectories of the objects
tracker_data = class_scenario_tracker_data();
tracker_data.status = enum_track_status_T.MATURE;
object_1.add_stationary_section(6, tracker_data);

tracker_data = class_scenario_tracker_data();
tracker_data.status = enum_track_status_T.MATURE;
object_2.add_straight_section(50, 70, 1, tracker_data);

tracker_data = class_scenario_tracker_data();
tracker_data.status = enum_track_status_T.MATURE;
object_3.add_stationary_section(3.8, tracker_data);

tracker_data = class_scenario_tracker_data();
tracker_data.status = enum_track_status_T.MATURE;
object_3.add_straight_section(60, 5, 1, tracker_data);

