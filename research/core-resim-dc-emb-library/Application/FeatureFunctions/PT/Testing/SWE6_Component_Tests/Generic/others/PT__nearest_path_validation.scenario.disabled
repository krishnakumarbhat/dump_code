tracker_data.status = enum_track_status_T.MATURE;
object_4.add_stationary_section(3.8, tracker_data);

tracker_data = class_scenario_tracker_data();
tracker_data.status = enum_track_status_T.MATURE;
object_4.add_straight_section(60, 5, 1, tracker_data);

tracker_data = class_scenario_tracker_data();
tracker_data.status = enum_track_status_T.MATURE;
object_5.add_straight_section(50, 70, 1, tracker_data);

tracker_data = class_scenario_tracker_data();
tracker_data.status = enum_track_status_T.MATURE;
object_6.add_stationary_section(3.8, tracker_data);

tracker_data = class_scenario_tracker_data();
tracker_data.status = enum_track_status_T.MATURE;
object_6.add_straight_section(60, 5, 1, tracker_data);

tracker_data = class_scenario_tracker_data();
tracker_data.status = enum_track_status_T.MATURE;
object_7.add_stationary_section(3.8, tracker_data);

tracker_data = class_scenario_tracker_data();
tracker_data.status = enum_track_status_T.MATURE;
object_7.add_straight_section(60, 5, 1, tracker_data);

tracker_data = class_scenario_tracker_data();
tracker_data.status = enum_track_status_T.MATURE;
object_8.add_stationary_section(3.8, tracker_data);

tracker_data = class_scenario_tracker_data();
tracker_data.status = enum_track_status_T.MATURE;
object_8.add_straight_section(60, 5, 1, tracker_data);

tracker_data = class_scenario_tracker_data();
tracker_data.status = enum_track_status_T.MATURE;
object_9.add_stationary_section(3.8, tracker_data);

tracker_data = class_scenario_tracker_data();
tracker_data.status = enum_track_status_T.MATURE;
object_9.add_straight_section(60, 5, 1, tracker_data);


%% Create scenario property, containing all of the objects.
scenario = class_scenario_creator();
scenario.set_version(enum_scenario_file_versions.VERSION_10);
scenario.set_polarion_info('', '');
scenario.set_test_type('');
scenario.set_default_timestep(0.05);
scenario.add_object(object_1);
scenario.add_object(object_2);
scenario.add_object(object_3);
scenario.add_object(object_4);
scenario.add_object(object_5);
scenario.add_object(object_6);
scenario.add_object(object_7);
scenario.add_object(object_8);
scenario.add_object(object_9);
