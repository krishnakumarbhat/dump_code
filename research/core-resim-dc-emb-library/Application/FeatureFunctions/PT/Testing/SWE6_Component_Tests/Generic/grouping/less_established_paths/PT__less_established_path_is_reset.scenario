%% This is a scenario file, which can be read in by the MATE-Scenario-Creator-Plugin.
% File Version: VERSION_11

%% Scenario Description:
% This scenario includes the EGO-object, named 'Ego'. Internal name is 'object_1'.
% This scenario includes the TARGET-object, named 'Tgt_1_mature_path_builder'. Internal name is 'object_2'.
% This scenario includes the TARGET-object, named 'Tgt_2_mature_path_builder'. Internal name is 'object_3'.
% This scenario includes the TARGET-object, named 'Tgt_3_mature_path_builder'. Internal name is 'object_4'.
% This scenario includes the TARGET-object, named 'Tgt_less_established_path'. Internal name is 'object_5'.
% The dimensions of Ego are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The dimensions of Tgt_1_mature_path_builder are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The dimensions of Tgt_2_mature_path_builder are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The dimensions of Tgt_3_mature_path_builder are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The dimensions of Tgt_less_established_path are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The initial conditions of Ego are set to: [Start-Speed: 0 kph, Start-Heading: 0 deg].
% The initial conditions of Tgt_1_mature_path_builder are set to: [Start-Speed: 30 kph, Start-Heading: 0 deg].
% The initial conditions of Tgt_2_mature_path_builder are set to: [Start-Speed: 30 kph, Start-Heading: 0 deg].
% The initial conditions of Tgt_3_mature_path_builder are set to: [Start-Speed: 30 kph, Start-Heading: 0 deg].
% The initial conditions of Tgt_less_established_path are set to: [Start-Speed: 30 kph, Start-Heading: 0 deg].
% The start position of Tgt_1_mature_path_builder is shifted by Lateral-Offset: 5 m, Longitudinal-Offset: -40 mHeading: 0°.
% The start position of Tgt_2_mature_path_builder is shifted by Lateral-Offset: 5 m, Longitudinal-Offset: -40 mHeading: 0°.
% The start position of Tgt_3_mature_path_builder is shifted by Lateral-Offset: 5 m, Longitudinal-Offset: -40 mHeading: 0°.
% The start position of Tgt_less_established_path is shifted by Lateral-Offset: 5.3 m, Longitudinal-Offset: -40 mHeading: 0°.
% Add a stationary section to Ego with: Duration: 15 s, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Tgt_1_mature_path_builder with: End-Speed: 50 kph, Distance: 80 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a stationary section to Tgt_2_mature_path_builder with: Duration: 1 s, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Tgt_2_mature_path_builder with: End-Speed: 50 kph, Distance: 80 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a stationary section to Tgt_3_mature_path_builder with: Duration: 2 s, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Tgt_3_mature_path_builder with: End-Speed: 50 kph, Distance: 80 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a stationary section to Tgt_less_established_path with: Duration: 5 s, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to Tgt_less_established_path with: End-Speed: 50 kph, Distance: 80 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).

%% Set up enums
[enum_object_types, enum_object_specific_variants]  = enum_base.get_by_name('enum_object_types', 'enum_object_specific_variants');
[enum_track_status_T, enum_collision_point, enum_track_object_class] = enum_base.get_by_name('enum_track_status_T', 'enum_collision_point', 'enum_track_object_class');

%% Create Objects and define start and end conditions of the scenario
% Mandatory: Create objects for scenario (Type[enum], Name[char])
object_1 = class_scenario_properties(enum_object_types.EGO, 'Ego');
object_2 = class_scenario_properties(enum_object_types.TARGET, 'Tgt_1_mature_path_builder');
object_3 = class_scenario_properties(enum_object_types.TARGET, 'Tgt_2_mature_path_builder');
object_4 = class_scenario_properties(enum_object_types.TARGET, 'Tgt_3_mature_path_builder');
object_5 = class_scenario_properties(enum_object_types.TARGET, 'Tgt_less_established_path');

% Mandatory: Define start objects dimensions (Width[m], Length[m], Pivot_Point[m]) OR (Preset[enum])
object_1.set_dimension(enum_object_specific_variants.VEHICLE);
object_2.set_dimension(enum_object_specific_variants.VEHICLE);
object_3.set_dimension(enum_object_specific_variants.VEHICLE);
object_4.set_dimension(enum_object_specific_variants.VEHICLE);
object_5.set_dimension(enum_object_specific_variants.VEHICLE);

% Mandatory: Define objects starting values (Speed[kph], Heading[deg])
object_1.set_starting_values(0, 0);
object_2.set_starting_values(30, 0);
object_3.set_starting_values(30, 0);
object_4.set_starting_values(30, 0);
object_5.set_starting_values(30, 0);

% Optional: Define objects to end its scenario together with ego

% Optional: Define objects to have collision with Ego (Collision_Point[enum], CP-Lat-Offset[%], CP-Long-Offset[%])

% Optional: Define end position offsets for targets (Lat.[m] / Long.[m])
object_2.set_start_pos_offsets(5, -40, 0);
object_3.set_start_pos_offsets(5, -40, 0);
object_4.set_start_pos_offsets(5, -40, 0);
object_5.set_start_pos_offsets(5.3, -40, 0);

%% Define trajectories of the objects
section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_1.add_stationary_section(15, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_2.add_straight_section(50, 80, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_3.add_stationary_section(1, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_3.add_straight_section(50, 80, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_4.add_stationary_section(2, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_4.add_straight_section(50, 80, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_5.add_stationary_section(5, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_5.add_straight_section(50, 80, section_generic_properties);


%% Create scenario property, containing all of the objects.
scenario = class_scenario_creator();
scenario.set_version(enum_scenario_file_versions.VERSION_11);
scenario.set_polarion_info('CSCSA-47067', 'SF-1537,SF-1577');
scenario.set_test_type('positive');
scenario.set_default_timestep(0.05);
scenario.add_object(object_1);
scenario.add_object(object_2);
scenario.add_object(object_3);
scenario.add_object(object_4);
scenario.add_object(object_5);
