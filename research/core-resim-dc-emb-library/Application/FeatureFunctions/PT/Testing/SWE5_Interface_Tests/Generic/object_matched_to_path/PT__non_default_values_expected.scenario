%% This is a scenario file, which can be read in by the MATE-Scenario-Creator-Plugin.
% File Version: VERSION_11

%% Scenario Description:
% This scenario includes the EGO-object, named 'Ego'. Internal name is 'object_1'.
% This scenario includes the TARGET-object, named 'test_vehicle'. Internal name is 'object_2'.
% This scenario includes the TARGET-object, named 'Test_vehicle2'. Internal name is 'object_3'.
% The dimensions of Ego are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The dimensions of test_vehicle are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The dimensions of Test_vehicle2 are set to the VEHICLE-Preset: [Width: 1.83 m, Length: 4.65 m, PivotPoint: -3.5 m].
% The initial conditions of Ego are set to: [Start-Speed: 0 kph, Start-Heading: 0 deg].
% The initial conditions of test_vehicle are set to: [Start-Speed: 50 kph, Start-Heading: 90 deg].
% The initial conditions of Test_vehicle2 are set to: [Start-Speed: 30 kph, Start-Heading: 90 deg].
% The start position of test_vehicle is shifted by Lateral-Offset: 10 m, Longitudinal-Offset: -85 mHeading: 0°.
% The start position of Test_vehicle2 is shifted by Lateral-Offset: 9.5 m, Longitudinal-Offset: -85 mHeading: 0°.
% Add a stationary section to Ego with: Duration: 30 s, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a straight section to test_vehicle with: End-Speed: 50 kph, Distance: 180 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).
% Add a stationary section to Test_vehicle2 with: Duration: 3 s, Section-Generic-Properties().
% Add a straight heading overwrite section to Test_vehicle2 with: End-Speed: 30 kph, End-Heading: 5 deg, Distance: 180 m, Section-Generic-Properties( Tracker-Data.Status: MATURE ).

%% Set up enums
[enum_object_types, enum_object_specific_variants]  = enum_base.get_by_name('enum_object_types', 'enum_object_specific_variants');
[enum_track_status_T, enum_collision_point, enum_track_object_class] = enum_base.get_by_name('enum_track_status_T', 'enum_collision_point', 'enum_track_object_class');

%% Create Objects and define start and end conditions of the scenario
% Mandatory: Create objects for scenario (Type[enum], Name[char])
object_1 = class_scenario_properties(enum_object_types.EGO, 'Ego');
object_2 = class_scenario_properties(enum_object_types.TARGET, 'test_vehicle');
object_3 = class_scenario_properties(enum_object_types.TARGET, 'Test_vehicle2');

% Mandatory: Define start objects dimensions (Width[m], Length[m], Pivot_Point[m]) OR (Preset[enum])
object_1.set_dimension(enum_object_specific_variants.VEHICLE);
object_2.set_dimension(enum_object_specific_variants.VEHICLE);
object_3.set_dimension(enum_object_specific_variants.VEHICLE);

% Mandatory: Define objects starting values (Speed[kph], Heading[deg])
object_1.set_starting_values(0, 0);
object_2.set_starting_values(50, 90);
object_3.set_starting_values(30, 90);

% Optional: Define objects to end its scenario together with ego

% Optional: Define objects to have collision with Ego (Collision_Point[enum], CP-Lat-Offset[%], CP-Long-Offset[%])

% Optional: Define end position offsets for targets (Lat.[m] / Long.[m])
object_2.set_start_pos_offsets(10, -85, 0);
object_3.set_start_pos_offsets(9.5, -85, 0);

%% Define trajectories of the objects
section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_1.add_stationary_section(30, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_2.add_straight_section(50, 180, section_generic_properties);

section_generic_properties = class_section_generic_properties();
object_3.add_stationary_section(3, section_generic_properties);

section_generic_properties = class_section_generic_properties();
section_generic_properties.tracker_data.status = enum_track_status_T.MATURE;
object_3.add_straight_heading_overwrite_section(30, 5, 180, section_generic_properties);


%% Create scenario property, containing all of the objects.
scenario = class_scenario_creator();
scenario.set_version(enum_scenario_file_versions.VERSION_11);
scenario.set_polarion_info('CSCSA-45864', 'SF-2896,SF-2917,SF-2914,SF-2919,SF-2918');
scenario.set_test_type('positive');
scenario.set_default_timestep(0.05);
scenario.add_object(object_1);
scenario.add_object(object_2);
scenario.add_object(object_3);
