"""
Bazel file defining all building blocks, local and remote.

Many times, developers will need to override the http_archive calls to develop their building block code locally.
To do this, use the override_repository flag during build.
This can be either added on the command line, or for convenience it can be added to a user.bazelrc file in the root of the repo.
Simply create this user.bazelrc file and add one of the following lines (or similar) and that parameter will be appended to all build commands.

Example for Linux:
common --override_repository=afbb=/home/timb/Projects/Core_Radar_Gen7_SAF85xx_Angle_Finding
Example for Windows:
common --override_repository=afbb=C:/Projects/Core_Radar_Gen7_SAF85xx_Angle_Finding

If not using the user.bazelrc file, the build command might look like this:
bazel build //:gen7 --override_repository=afbb=C:/Projects/Core_Radar_Gen7_SAF85xx_Angle_Finding
"""

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "sfl",
    build_file = "//sil/emb_lib/ff_emb_lib:sfl/archive.BUILD",
    patch_cmds_win = ["rm (Get-ChildItem -Filter BUILD -Recurse -ErrorAction SilentlyContinue -Force).fullname"],
    url = "https://gitgerrit.asux.aptiv.com/a/plugins/gitiles/CORECOMP/ALSW/SFL_SideFeatureLogic/+archive/refs/tags/24_PI3_S6.tar",
)

