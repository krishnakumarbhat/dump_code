http_archive(
    name = "pugixml",
    build_file_content = """
load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(
    name = "pugixml",
    srcs = [
        "pugixml.cpp",
    ],
    hdrs = [
        "pugiconfig.hpp",
        "pugixml.hpp",
    ],
    copts = ["-w"],
    # SIL engine and emb lib both link statically to possibly different
    # versions of pugixml, this leads to emb_lib calling into SIL engine's
    # copy of pugixml which might not be compatible
    #
    # To fix this, we rename pugi's namespace to ensure different symbols
    defines = ["pugi=pugi_emb_lib"],
    visibility = ["//visibility:public"],
)
    """,
    sha256 = "86a2b2f16d3e107b9ea5043ef9c458306b94d38f6203d58a196dc9b9dc6351a6",
    strip_prefix = "pugixml-1.14/src",
    url = "https://github.com/zeux/pugixml/archive/refs/tags/v1.14.zip",
)

