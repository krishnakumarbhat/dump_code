    patches = ["//sil/emb_lib/boost_pfr:array_fix.patch"],
    # sha256 = "c26d93ba963f86b32ae6a24bc88b3bef9200b1d83aa6ba8114a587ece3279663",
    strip_prefix = "pfr-8cd1a9675d327a058101ef0802789f1830ac2a7e",
