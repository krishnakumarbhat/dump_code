<p style="font-size:16px; margin:6px 0;">Delta Failures in Test Cases: <span style="font-weight:bold; color:${theme.failValue};">${NEW_TEST_FAIL}</span></p>

<p style="font-size:16px; margin:6px 0;">Delta Failures in SRS (Requirements): <span style="font-weight:bold; color:${theme.failValue};">${NEW_SRS_FAIL}</span></p>
</div>

<br>

<div style="font-size:12px; color:${theme.noteText}; font-style:italic;">
<b>Note:</b><br>

    &nbsp;&nbsp;• Delta represents newly introduced failures compared to the previous run.<br>
&nbsp;&nbsp;• Refer attachments for detailed reports.

</div>

<!-- ROTATION SCHEDULE -->
<div style="background:${theme.cardBg};margin-top:20px;padding:18px;border-radius:10px;${theme.cardBorder}">
<h3 style="color:${theme.sectionTitle};margin-top:0;">📅 Test Rotation Schedule (5-Day Cycle)</h3>
<p style="font-size:12px;color:${theme.subText};margin-top:2px;">Each day a different variant + protocol combination is tested automatically.</p>
<table style="width:100%;border-collapse:collapse;font-size:13px;margin-top:10px;">
<tr style="background:#1e40af;">
  <th style="padding:10px 12px;text-align:left;color:#ffffff;font-size:14px;border-bottom:2px solid #3b82f6;">Date</th>
  <th style="padding:10px 12px;text-align:left;color:#ffffff;font-size:14px;border-bottom:2px solid #3b82f6;">Variant</th>
  <th style="padding:10px 12px;text-align:left;color:#ffffff;font-size:14px;border-bottom:2px solid #3b82f6;">XCP Protocol</th>
</tr>
${testScheduleHtml}
</table>
</div>

<!-- EMAIL SIGNATURE -->
<p style="margin-top:30px;">Best Regards,<br>
<b style="color:#00539C;">Gen8 SWE6 CI</b><br>
<a href="${swe6_flr8_job_url}" style="color:#0078D7;">♾️ CI-Job Link</a>
</p>

<!-- FOOTER -->
<div style="margin-top:20px;font-size:12px;color:${theme.footerText};text-align:center;">

📎 Attached Reports: HTML Test Execution, Results Summary & Delta Failures
</div>

</div>
</body>
</html>

"""
            )

            // ---- Teams Notification via Power Automate Webhook ----
            // Posts an Adaptive Card to the Teams channel. The webhook URL is stored
            // as a Jenkins credential (string secret ID: ADVRADAR_SWE6_TEAMS_WEBHOOK_URL).
            // If not configured, this block is silently skipped.
            try {
              withCredentials([string(credentialsId: 'ADVRADAR_SWE6_TEAMS_WEBHOOK_URL', variable: 'TEAMS_WEBHOOK_URL')]) {
                // Null-safe int coercion so a missing/non-numeric metric does not throw NPE and silently suppress the Teams card.
                def toIntSafe = { v -> (v == null) ? 0 : (v.toString().trim().isInteger() ? v.toString().trim().toInteger() : 0) }
                def hasFail = (toIntSafe(FAILED) > 0 || toIntSafe(ERRORS) > 0 || toIntSafe(NEW_TEST_FAIL) > 0)
                // Single-backslash \u escapes are decoded by the Groovy compiler into
                // the actual unicode glyphs, so JsonOutput.toJson serializes them as
                // real characters (or proper JSON \uXXXX escapes), which Teams renders.
                // Double-backslash (\\u274c) emits the literal 6-char text "\u274c".
                def teamsStatus = hasFail ? "\u274c FAILED" : "\u2705 PASSED"
                def statusColor = hasFail ? "Attention" : "Good"
                def cardTitle = "Gen8 SWE6 (FLR8) Nightly #${env.BUILD_NUMBER}"

                // Build upcoming schedule (next 3 days)
                def scheduleMatrix = [
                  [variant: 'flr8_standalone',             xcp: 'Eth_Direct'],
                  [variant: 'flr8_al_can_standalone',      xcp: 'CAN'],
                  [variant: 'flr8_al_can_standalone',      xcp: 'Eth_Direct'],
                  [variant: 'flr8_satellite_can',          xcp: 'CAN'],
                  [variant: 'flr8_satellite_can',          xcp: 'Eth_Direct'],
                  [variant: 'flr8_satellite_eth_high_det', xcp: 'Eth_Direct'],
                ]
                def doy = new Date().format("D").toInteger()
                def upcomingLines = []
                for (int i = 1; i < Math.min(4, scheduleMatrix.size()); i++) {
                  def ci = (doy + i) % scheduleMatrix.size()
                  def c = scheduleMatrix[ci]
                  def dl = (new Date() + i).format('EEE MMM dd')
                  upcomingLines.add("${dl}: ${c.variant} [${c.xcp}]")
                }
                def upcomingText = upcomingLines.join("\n\n")

                def cardPayload = [
                  type: "message",
                  attachments: [[
                    contentType: "application/vnd.microsoft.card.adaptive",
                    content: [
                      type: "AdaptiveCard",
                      '$schema': "http://adaptivecards.io/schemas/adaptive-card.json",
                      version: "1.4",
                      body: [
                        [type:"TextBlock", size:"Large", weight:"Bolder", color:"Accent", text:cardTitle],
                        [type:"TextBlock", weight:"Bolder", color:statusColor, text:teamsStatus],
                        [type:"TextBlock", wrap:true, text:"**Variant:** ${todayVariant}  |  **XCP:** ${todayXcp}  |  **Commit:** ${env.SHORT_COMMIT_HASH}"],
                        [type:"TextBlock", wrap:true, color:"Good", text:"\u2705 Tests PASSED: ${PASSED}"],
                        [type:"TextBlock", wrap:true, color:"Attention", text:"\u274c Tests FAILED: ${FAILED}  |  Errors: ${ERRORS}"],
                        [type:"TextBlock", wrap:true, color:"Warning", text:"\u26a0\ufe0f Tests SKIPPED: ${SKIPPED}  |  New Failures: ${NEW_TEST_FAIL}"],
                        [type:"TextBlock", wrap:true, color:"Good", text:"\u2705 SRS: ${SRS_PASSED} passed / ${SRS_FAILED} failed / ${SRS_ERRORS} errors"],
                        [type:"TextBlock", wrap:true, isSubtle:true, separator:true, text:"**New Failures:** ${NEW_TEST_FAIL} test / ${NEW_SRS_FAIL} SRS"],
                        [type:"TextBlock", wrap:true, separator:true, size:"Small", weight:"Bolder", text:"Upcoming Schedule:"],
                        [type:"TextBlock", wrap:true, size:"Small", isSubtle:true, text:upcomingText],
                        [type:"TextBlock", wrap:true, text:"[CI Job](${swe6_flr8_job_url}) | [Latest Report](${static_jfrog_html_url}) | [All Reports](${jfrog_all_reports}) | [Platform Health](${grafanaDashboardPath})"]
                      ]
                    ]
                  ]]
                ]

                def jsonPayload = groovy.json.JsonOutput.toJson(cardPayload)
                // Write to temp file to avoid shell quoting issues
                writeFile file: 'teams_card_payload.json', text: jsonPayload

                try {
                  bat 'powershell -NoProfile -Command "Invoke-RestMethod -Uri $env:TEAMS_WEBHOOK_URL -Method Post -ContentType \'application/json\' -Body (Get-Content -Raw teams_card_payload.json)"'
                  echo "Teams notification sent successfully."
                } finally {
                  // Always remove the payload file, even when the POST fails, so it does not leak on the agent workspace.
                  bat 'if exist teams_card_payload.json del /f /q teams_card_payload.json'
                }
              }
            } catch (Exception teamsErr) {
              echo "Teams notification skipped or failed: ${teamsErr.message}"
            }
          }
        }
      }
    }
    // ----------------------------------------- SWE6 (FLR8): End ---------------------------------------
  }
}
