<tr><td style="color:${theme.labelColor};">XCP Protocol:</td><td><strong style="color:${theme.xcpColor};">${todayXcp}</strong></td></tr>
<tr><td style="color:${theme.labelColor};">Commit ID:</td><td><code style="color:${theme.commitColor};">${fullCommitID}</code></td></tr>
</table>
</div>

<!-- ================= TWO COLUMN ================= -->
<table width="100%" cellpadding="10" cellspacing="0" style="margin-top:25px;">
<tr>

<!-- TEST -->
<td width="50%" valign="top">
<div style="background:${theme.cardBg};border-radius:10px;padding:15px;${theme.cardBorder}">

<div style="text-align:center;margin-bottom:12px;">
<span style="background:${theme.badgeBg};padding:6px 16px;border-radius:20px;font-weight:bold;color:${theme.badgeText};">

