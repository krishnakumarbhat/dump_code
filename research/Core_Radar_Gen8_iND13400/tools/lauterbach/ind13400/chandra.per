                    newline
                    bitfld.long 0x00 12. "TEIF,There is no bit to enable or disable the handling of TEIF" "0,1"
                    bitfld.long 0x00 11. "TTIF,TTIF will be set if TTIE is set and the cycle time is equal to the trigger time TT_TRIG" "0,1"
                    newline
                    bitfld.long 0x00 10. "EPIF,EPIF will be activated if EPASS changes and if EPIE=1" "0,1"
                    bitfld.long 0x00 9. "ALIF,Arbitration Lost Interrupt Flag" "0,1"
                    newline
                    bitfld.long 0x00 8. "BEIF,Bus Error Interrupt Flag" "0,1"
                    bitfld.long 0x00 7. "RIF,Receive Interrupt Flag" "0: No frame has been received,1: Data or a remote frame has been received and.."
                    newline
                    bitfld.long 0x00 6. "ROIF,In case of an overrun both ROIF and RFIF will be set" "0: No RB overwritten,1: At least one received message has been.."
                    bitfld.long 0x00 5. "RFIF,RB Full Interrupt Flag" "0: The RB FIFO is not full,1: All RBs are full"
                    newline
                    bitfld.long 0x00 4. "RAFIF,RB Almost-Full Interrupt Flag" "0: number of filled RB slots is less than AFWL_i,1: number of filled RB slots is equal or bigger.."
                    bitfld.long 0x00 3. "TPIF,In TTCAN mode TPIF will never be set" "0: No transmission of the PTB has been completed,1: The requested transmission of the PTB has.."
                    newline
                    bitfld.long 0x00 2. "TSIF,In TTCAN mode TSIF will signal all successful transmissions regardless of storage location of the frame" "0: No transmission of the STB has been completed..,1: The requested transmission of the STB has.."
                    bitfld.long 0x00 1. "EIF,Error Interrupt Flag" "0: There has been no change,1: The border of the error warning limit has.."
                    newline
                    bitfld.long 0x00 0. "AIF,The AIF does not have an associated enable register" "0: No abort has been executed,1: After setting TPA or TSA the appropriated.."
            group.long 0x18++0x03
                line.long 0x00 "INTE,Interrupt Enable Register"
                    bitfld.long 0x00 18. "SWIE,DMR / TMR: Safety Warning Interrupt Enable" "0,1"
                    bitfld.long 0x00 14. "MDWIE,Memory Protection (ECC): Data Warning Interrupt Enable" "0,1"
