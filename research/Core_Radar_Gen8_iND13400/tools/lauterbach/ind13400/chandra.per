            bitfld.long 0x00 16. "SMBUS_QUICK_CMD_BIT,This bit indicates the R/W bit of the Quick command received" "0: SMBUS QUICK CMD Read/write is set to 0,1: SMBUS QUICK CMD Read/write is set to 1"
            newline
            bitfld.long 0x00 13.--15. "RSVD_IC_STATUS_1,RSVD_IC_STATUS_1 Reserved bits - Read Only" "0,1,2,3,4,5,6,7"
