            newline
            rbitfld.long 0x00 7. "Reserved_7,Reserved" "0,1"
            newline
            hexmask.long.byte 0x00 0.--6. 1. "SPLOFST,Split Offset These bits indicate the value of offset from the beginning of Length/Type field at which header split should take place when the appropriate SPLM is selected"

