            newline
            rbitfld.long 0x00 6. "AINC,Address Increment" "0: No Change,1: Increment"
            newline
            rbitfld.long 0x00 5. "RSVD_DMACR5,Reserved bits - read as zero" "0,1"
            newline
            rbitfld.long 0x00 3.--4. "ATW,AXI transfer width for DMA transfers mapped to arsize/awsize" "0: 1 byte,1: 2 bytes,2: 4 bytes,3: 8 bytes"
            newline
            rbitfld.long 0x00 2. "IDMAE,Internal DMA Enable" "0,1"
            newline
            bitfld.long 0x00 1. "TDMAE,Transmit DMA Enable" "0: Transmit DMA disabled,1: Transmit DMA enabled"
