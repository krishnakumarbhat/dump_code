tree "SYSCTRL ()"
    base ad:0x89000000
    rgroup.long 0x00++0x03
        line.long 0x00 "NAME,ASIC name"
            hexmask.long 0x00 0.--31. 1. "NAME,A read from this register will return the ASIC name (CHND)"
    rgroup.long 0x04++0x03
        line.long 0x00 "REV,Silicon Revision"
            hexmask.long.word 0x00 0.--15. 1. "REV,A read from this register will return the silicon revision (e.g. B0)"

    group.long 0x08++0x03
        line.long 0x00 "RETAIN_0,Retained data 0"
            hexmask.long 0x00 0.--31. 1. "RETAIN_0,Only reset by RSTN pin"
    group.long 0x0C++0x03
        line.long 0x00 "RETAIN_1,Retained data 1"
            hexmask.long 0x00 0.--31. 1. "RETAIN_1,Only reset by RSTN pin"
    group.long 0x10++0x03
        line.long 0x00 "RETAIN_2,Retained data 2"
            hexmask.long 0x00 0.--31. 1. "RETAIN_2,This register is either reset by RSTN pin WDT or CRG.RESETREQ.ALL"
    group.long 0x14++0x03
        line.long 0x00 "RETAIN_3,Retained data 3"
            hexmask.long 0x00 0.--31. 1. "RETAIN_3,This register is either reset by RSTN pin WDT or CRG.RESETREQ.ALL"
    group.long 0x18++0x03
        line.long 0x00 "RETAIN_4,Retained data 4"
