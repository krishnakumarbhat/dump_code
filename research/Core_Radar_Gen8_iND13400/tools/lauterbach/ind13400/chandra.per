                    bitfld.long 0x00 3.--4. "TSTRCFG,TSTRCFG is writeable if RESET=1 and write-locked if 0" "0: PTB using TPE store & forward,1: PTB using TPE cut-through,2: STB using TSONE store & forward,3: STB using TSALL store & forward"
                    bitfld.long 0x00 2. "TSTREN,If enabled then frames to be transmitted are stored in the transmit buffer" "0: disabled,1: enabled"
                    newline
                    bitfld.long 0x00 1. "RSTREN,If enabled then received frames are forwarded to the reception stream interface" "0: disabled,1: enabled"
                    bitfld.long 0x00 0. "RBUFEN,If enabled then received frames are forwarded to RBUF" "0: disabled,1: enabled"
            group.long 0x10B4++0x03
                line.long 0x00 "LLCFORMAT,LLC Frame Calculator Input"
                    hexmask.long 0x00 0.--31. 1. "LLCFORMAT,A write access to LLCFORMAT results in the automatic calculation of the size information of an LLC frame inside LLCSIZE*"

            rgroup.long 0x10B8++0x03
                line.long 0x00 "LLCSIZE,LLC Frame Calculator Output"
                    hexmask.long.word 0x00 16.--31. 1. "LLCAOT,LLCAOT provides the address offset of the reception time-stamps (value T) of an LLC frame* depending on the value inside LLCFORMAT"
                    hexmask.long.word 0x00 0.--15. 1. "LLCPBYTES,LLCPBYTES provides the number of payload data bytes inside LLC frame** depending on the value inside LLCFORMAT"
        tree.end
    repeat.end
tree.end

