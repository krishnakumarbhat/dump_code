                    bitfld.long 0x00 13. "WTIE,Watch Trigger Interrupt Enable" "0: DISABLED,1: ENABLED"
                    bitfld.long 0x00 11. "TTIE,If TTIE is set then TTIF will be set if the cycle time is equal to the trigger time TT_TRIG" "0,1"
                    newline
