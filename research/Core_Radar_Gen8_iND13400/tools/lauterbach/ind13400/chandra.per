                    bitfld.long 0x00 10. "TSONE,TSONE stays set until the frame has been transmitted successfully or it is aborted using TSA" "0: No transmission for the STB,1: Transmission enable of one in the STB"
                    newline
                    bitfld.long 0x00 9. "TSALL,TSALL stays set until all frames have been transmitted successfully or they are aborted using TSA" "0: No transmission for the STB,1: Transmission enable of all frames in the STB"
                    bitfld.long 0x00 8. "TSA,The bit has to be set by the host controller and will be reset by CAN-CTRL" "0: DISABLED,1: Aborts a transmission from STB which has been.."
                    newline
                    bitfld.long 0x00 7. "RESET,Some register (e.g for node configuration) can only be modified if RESET=1" "0: No local reset of CAN-CTRL,1: The host controller performs a local reset of.."
                    bitfld.long 0x00 6. "LBME,LBME cannot be changed while a transmission is active" "0: DISABLED,1: ENABLED"
                    newline
                    bitfld.long 0x00 5. "LBMI,LBMI cannot be changed while a transmission is active" "0: DISABLED,1: ENABLED"
                    bitfld.long 0x00 0. "BUSOFF,Writing a 1 to BUSOFF will reset TECNT and RECNT" "0: The controller status is bus on,1: The controller status is bus off"
            group.long 0x2C++0x03
                line.long 0x00 "CAN_WORD_2C,CAN Controller WORD 2C Register"
                    hexmask.long.byte 0x00 24.--31. 1. "TECNT,TECNT is incremented and decremented as defined in the CAN specification"
                    hexmask.long.byte 0x00 16.--23. 1. "RECNT,RECNT is incremented and decremented as defined in the CAN specification"
                    newline
                    rbitfld.long 0x00 13.--15. "KOER,KOER is updated with each new error" "0: NO_ERROR,1: BIT_ERROR,2: FORM_ERROR,3: STUFF_ERROR,4: Acknowledgement Error,5: CRC_ERROR,6: Other Error (dominant bits after own error..,7: PCRC_ERROR (CAN XL only"
