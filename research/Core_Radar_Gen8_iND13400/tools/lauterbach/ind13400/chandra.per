        line.long 0x00 "GPIO_SWPORTB_DDR,Port B Data Direction Register"
            hexmask.long.tbyte 0x00 8.--31. 1. "RSVD_GPIO_SWPORTB_DDR,RSVD_GPIO_SWPORTB_DDR Reserved bits - read as zero"
            newline
