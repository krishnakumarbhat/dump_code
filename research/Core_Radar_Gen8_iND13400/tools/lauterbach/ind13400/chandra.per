            bitfld.long 0x00 2. "ADC_OFFSET_AVG,When high use averaging mechanism in the ADC offset correction scheme" "0,1"
            newline
            bitfld.long 0x00 1. "ADC_OFFSET_BST,When high increase the offset correction range to 2x the original" "0,1"
            newline
