    group.long 0x1C++0x03
        line.long 0x00 "GPIO_SWPORTC_DDR,Port C Data Direction Register"
            hexmask.long.tbyte 0x00 8.--31. 1. "RSVD_GPIO_SWPORTC_DDR,RSVD_GPIO_SWPORTC_DDR Reserved bits - read as zero"
