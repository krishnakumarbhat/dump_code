            bitfld.long 0x00 10. "HW_PORTC,The value of this register is derived from the GPIO_HW_PORTC configuration parameter" "0: Port C has external auxiliary hardware..,1: Port C has external auxiliary hardware.."
            newline
            bitfld.long 0x00 9. "HW_PORTB,The value of this register is derived from the GPIO_HW_PORTB configuration parameter" "0: Port B has external auxiliary hardware..,1: Port B has external auxiliary hardware.."
            newline
            bitfld.long 0x00 8. "HW_PORTA,The value of this register is derived from the GPIO_HW_PORTA configuration parameter" "0: Port A has external auxiliary hardware..,1: Port A has external auxiliary hardware.."
            newline
            bitfld.long 0x00 7. "PORTD_SINGLE_CTL,The value of this register is derived from the GPIO_PORTD_SINGLE_CTL configuration parameter" "0: PORTD is not controlled from a single source,1: PORTD is controlled from a single source"
            newline
            bitfld.long 0x00 6. "PORTC_SINGLE_CTL,The value of this register is derived from the GPIO_PORTC_SINGLE_CTL configuration parameter" "0: PORTC is not controlled from a single source,1: PORTC is controlled from a single source"
