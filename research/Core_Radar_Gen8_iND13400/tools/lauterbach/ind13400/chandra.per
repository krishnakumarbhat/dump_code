tree "ETHER_SEC ()"
    base ad:0x91934000
    rgroup.long 0x00++0x03
        line.long 0x00 "CORE_VER_NUM,IP Version Number"
            hexmask.long.word 0x00 16.--31. 1. "RESERVED_31_16,Reserved and read as zero"
            hexmask.long.word 0x00 0.--15. 1. "VERSION_NUM,Indicates the coreKit release version number in BCD format"
    rgroup.long 0x04++0x03
        line.long 0x00 "CORE_VER_TYPE,IP Version Type Register"
            hexmask.long.word 0x00 16.--31. 1. "RESERVED_31_16,Reserved and read as zero"
            bitfld.long 0x00 12.--15. "TYPE_ENUM,Indicates the coreKit release type" "0: TYPE_ENUM_REG,?..."
            bitfld.long 0x00 8.--11. "PKG_NUM,Indicates the alphabetical packaging number of coreKit ID" "0: PKG_NUM_REG,?..."
            hexmask.long.byte 0x00 0.--7. 1. "TYPE_NUM,Indicates the coreKit release version type number in BCD format"

    group.long 0x08++0x03
        line.long 0x00 "IRQ_EN,Interrupt Enable Register"
            bitfld.long 0x00 31. "OUTPUT,Enables O_cfg_irq output" "0: UNKN_DESC,?..."
            hexmask.long.word 0x00 18.--30. 1. "RESERVED_31_18,Reserved and read as zero"
            bitfld.long 0x00 17. "FSM_PAR_ERR,Enables interrupt indicating that an FSM parity error has been detected" "0: FSM_PAR_ERR_REG,?..."
            bitfld.long 0x00 16. "REG_PAR_ERR,Enables interrupt indicating that a register parity error has been detected" "0: REG_PAR_ERR_REG,?..."
            newline
            hexmask.long.word 0x00 5.--15. 1. "RESERVED_15_5,Reserved and read as zero"
            bitfld.long 0x00 4. "CTX_IDX_ERR,Enables interrupt indicating that a context index error has been detected" "0: CTX_IDX_ERR_REG,?..."
            rbitfld.long 0x00 2.--3. "RESERVED_3_2,Reserved and read as zero" "0,1,2,3"
            bitfld.long 0x00 0. "KEY_DONE,Enables interrupt indicating that a key load has completed" "0: KEY_DONE_REG,?..."
    group.long 0x0C++0x03
        line.long 0x00 "IRQ_STAT,Interrupt Status Register"
            bitfld.long 0x00 17. "FSM_PAR_ERR,Status of interrupt indicating that an FSM parity error has been detected" "0: FSM_PAR_ERR_REG,?..."
            bitfld.long 0x00 16. "REG_PAR_ERR,Status of interrupt indicating that a register parity error has been detected" "0: REG_PAR_ERR_REG,?..."
            bitfld.long 0x00 4. "CTX_IDX_ERR,Status of interrupt indicating that a context index error has been detected" "0: CTX_IDX_ERR_REG,?..."
            bitfld.long 0x00 0. "KEY_DONE,Status of interrupt indicating that a key load has completed" "0: KEY_DONE_REG,?..."
    group.long 0x14++0x03
        line.long 0x00 "CTRL,Control Register"
            hexmask.long.word 0x00 20.--31. 1. "RESERVED_31_20,Reserved and read as zero"
            bitfld.long 0x00 18. "ENCRYPT,Encrypt/Decrypt selector for the key" "0: ENCRYPT_REG,?..."
            bitfld.long 0x00 16. "KEY_SZ,Size of the key: - 0:128-bit" "?,1: KEY_SZ_REG"
            bitfld.long 0x00 0.--4. "CTX_IDX,Key context index to load the key into" "0: CTX_IDX_REG,?..."

    rgroup.long 0x18++0x03
        line.long 0x00 "STAT,Status Register"
            hexmask.long 0x00 2.--31. 1. "RESERVED_31_2,Reserved and read as zero"
            bitfld.long 0x00 0. "BUSY,Indicates that the core is busy installing a key" "0: UNKN_DESC,?..."

    wgroup.long 0x20++0x03
        line.long 0x00 "KEY_0,Key 0 Register"
            hexmask.long 0x00 0.--31. 1. "KEY,Key bytes: {00 01 02 03}"
    wgroup.long 0x24++0x03
        line.long 0x00 "KEY_1,Key 1 Register"
            hexmask.long 0x00 0.--31. 1. "KEY,Key bytes: {04 05 06 07}"
    wgroup.long 0x28++0x03
        line.long 0x00 "KEY_2,Key 2 Register"
            hexmask.long 0x00 0.--31. 1. "KEY,Key bytes: {08 09 10 11}"
    wgroup.long 0x2C++0x03
        line.long 0x00 "KEY_3,Key 3 Register"
            hexmask.long 0x00 0.--31. 1. "KEY,Key bytes: {12 13 14 15}"
    wgroup.long 0x30++0x03
        line.long 0x00 "KEY_4,Key 4 Register"
            hexmask.long 0x00 0.--31. 1. "KEY,Key bytes: {16 17 18 19} (256-bit key only)"
    wgroup.long 0x34++0x03
        line.long 0x00 "KEY_5,Key 5 Register"
            hexmask.long 0x00 0.--31. 1. "KEY,Key bytes: {20 21 22 23} (256-bit key only)"
    wgroup.long 0x38++0x03
        line.long 0x00 "KEY_6,Key 6 Register"
            hexmask.long 0x00 0.--31. 1. "KEY,Key bytes: {24 25 26 27} (256-bit key only)"
    wgroup.long 0x3C++0x03
        line.long 0x00 "KEY_7,Key 7 Register"
            hexmask.long 0x00 0.--31. 1. "KEY,Key bytes: {28 29 30 31} (256-bit key only)"
tree.end

