    base ad:0x91600000
    group.long 0x00++0x03
        line.long 0x00 "CH0_CTL,CRC Channel 0 Control Register"
            bitfld.long 0x00 24.--26. "POLY,Polynomial selection on channel 0 to generate CRC" "0: (poly = 0x1D),1: (poly = 0x2F),2: (poly = 0x1021),3: (poly = 0x04C11DB7),4: (poly = 0xF4ACFB13),?..."
            bitfld.long 0x00 18. "OUT_POL,Flip polarity of CRC channel 0 when set to 1" "0,1"
            bitfld.long 0x00 16. "OUT_REV,Reverse output bit endianness of CRC channel 0 when set to 1" "0,1"
            newline
            bitfld.long 0x00 4.--5. "BYTE_SHIFT,Number of bytes to right shift input Data after byte and bit reversing for channel 0" "0: No right shift,1: right shift by 1 byte,2: right shift by 2 byte,3: right shift by 3 byte"
            bitfld.long 0x00 3. "BIT_REV,Reverse Bit Order of Data written into CRC engine within byte boundary for channel 0" "0: standard bit order of CRC,1: Reverse bit order of CRC"
            bitfld.long 0x00 2. "BYTE_REV,Reverse Byte Order of Data written into CRC engine for channel 0" "0: standard byte order of CRC,1: Reverse byte order of CRC"
            newline
            bitfld.long 0x00 0.--1. "PAR,Parallelism selection for channel 0" "0: bits [7:0] of input data is unmasked while..,1: bits [15:0] of input data is unmasked while..,2: bits [24:0] of input data is unmasked while..,3: bits [31:0] of input data is unmasked while.."
    group.long 0x04++0x03
