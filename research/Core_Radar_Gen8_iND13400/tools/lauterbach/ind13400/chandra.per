tree "ARTIE ()"
    base ad:0x89003000
    group.long 0x00++0x03
        line.long 0x00 "CAN0_CTRL,CAN0 Control Registers"
            bitfld.long 0x00 8.--10. "CAN0_TIMER_DIV_SEL,Division by increasing powers of two" "0,1,2,3,4,5,6,7"
            newline
            bitfld.long 0x00 5. "CAN0_TIMER_CLEAR,Division by increasing powers of two" "0,1"
            newline
            bitfld.long 0x00 4. "CAN0_TIMER_ENABLE,Currently unused/unsupported" "0,1"
            newline
            bitfld.long 0x00 0. "CAN0_FD_ENABLE,Enable FD features within the CAN module" "0,1"
    group.long 0x04++0x03
        line.long 0x00 "CAN1_CTRL,CAN1 Control Registers"
            bitfld.long 0x00 8.--10. "CAN1_TIMER_DIV_SEL,Division by increasing powers of two" "0,1,2,3,4,5,6,7"
            newline
            bitfld.long 0x00 5. "CAN1_TIMER_CLEAR,Division by increasing powers of two" "0,1"
            newline
            bitfld.long 0x00 4. "CAN1_TIMER_ENABLE,Currently unused/unsupported" "0,1"
            newline
            bitfld.long 0x00 0. "CAN1_FD_ENABLE,Enable FD features within the CAN module" "0,1"
    group.long 0x08++0x03
        line.long 0x00 "ETHER_CTRL,Ethernet Control Registers"
            bitfld.long 0x00 10. "ETH_SIGDET_BYPASS_VAL,Ethernet signal detect override value" "0,1"
            newline
            bitfld.long 0x00 9. "ETH_SIGDET_BYPASS,eth_sigdet_bypass" "0: Ethernet Signal detect value taken directly..,1: Ethernet Signal detect value bypassing SERDES.."
            newline
            bitfld.long 0x00 8. "ETH_MACSEC_BYPASS,eth_macsec_bypass" "0: Ethernet MAC Security Enabled,1: Ethernet MAC Security Disabled"
            newline
            rbitfld.long 0x00 6.--7. "ETH_SGMII_SPEED,eth_sgmii_speed" "0: Ethernet SGMII running at 10 Mbps,1: Ethernet SGMII running at 100 Mbps,2: Ethernet SGMII running at 1000 Mbps,?..."
            newline
            rbitfld.long 0x00 4.--5. "ETH_MAC_SPEED,eth_mac_speed" "0: Ethernet MAC running at 10 Mbps,1: Ethernet MAC running at 100 Mbps,2: Ethernet MAC running at 1000 Mbps,3: Ethernet MAC running at 2500 Mbps"
            newline
            bitfld.long 0x00 0.--1. "ETH_PHY_SEL,eth_phy_sel" "0: Interface to Ethernet MAC Reserved for future..,1: Ethernet MAC connected to SGMII phy,2: Interface to Ethernet MAC Reserved for future..,3: Ethernet MAC connected to SMII phy"
    group.long 0x0C++0x03
        line.long 0x00 "SP_MAIN_CFG,Supervisory Processor Main Configuration Register"
            hexmask.long.word 0x00 16.--26. 1. "CFGPERIPHBASE,Base address of the GIC Distributor Unit (GDU) registers"
            newline
            bitfld.long 0x00 1. "CFGRAMPROTEN,RAM (caches and TCMs) memory protection enable out of reset" "0,1"
            newline
            bitfld.long 0x00 0. "ETM_TS_DISABLE,When set tie the ETM TS binary value (TSVALUEB) to zero" "0,1"
    group.long 0x10++0x03
        line.long 0x00 "SP0_CFG0,Supervisory Processor 0 Configuration Register 0"
            hexmask.long 0x00 5.--31. 1. "CFGVECTABLE0,Vector table base address out of reset"
            newline
            bitfld.long 0x00 3. "CFGTHUMBEXCEPTIONS0,Instruction set state (A32 or T32) and value of HSCTLR.TE out of reset" "0,1"
            newline
            bitfld.long 0x00 2. "CFGTCMBOOT0,ATCM enabled and at address 0x0 out of reset" "0,1"
            newline
            bitfld.long 0x00 1. "CFGL1CACHEINVDIS0,Automatic post-reset L1 cache invalidate disable" "0,1"
            newline
            bitfld.long 0x00 0. "CPUHALT0,Core 0 waits out of reset before taking reset exception and fetching instructions" "0,1"

