            hexmask.long.word 0x00 0.--15. 1. "LO_ETHERTYPE,Lower bound value of EtherType filter for RULE_NUM in the RX Lookup block"
    group.long 0x140++0x03
        line.long 0x00 "RX_LKUP_SWAP,Writing this register causes the active and in-active pages of the lookup database to swap"
            hexmask.long 0x00 1.--31. 1. "reserved,Reserved bits"
            bitfld.long 0x00 0. "SWAP,Writing this register causes the active and in-active pages of the lookup database to swap" "0: SWAP,?..."

    rgroup.long 0x148++0x03
        line.long 0x00 "RX_LKUP_STAT,Indicates the current active/inactive page index of the lookup database"
            hexmask.long 0x00 2.--31. 1. "reserved,Reserved bits"
            bitfld.long 0x00 1. "PAGE,Indicates the current active page index of the lookup database" "0: PAGE,?..."
            newline
            bitfld.long 0x00 0. "RDY,Indicates that the inactive page is ready to be written to by the host" "0: RDY,?..."

    group.long 0x200++0x03
        line.long 0x00 "TX_SRC_FILT_1,Filter for the source MAC address used for the TX Lookup"
            hexmask.long.word 0x00 16.--31. 1. "reserved,Reserved bits"
            hexmask.long.word 0x00 0.--15. 1. "ADR,Filter for the source MAC address used for the TX Lookup"
    group.long 0x204++0x03
        line.long 0x00 "TX_SRC_FILT_0,Filter for the source MAC address used for the TX Lookup"
            hexmask.long 0x00 0.--31. 1. "ADR,Filter for the source MAC address used for the TX Lookup"
    group.long 0x208++0x03
        line.long 0x00 "TX_DST_FILT_1,Filter for the destination MAC address used for the TX lookup"
            hexmask.long.word 0x00 17.--31. 1. "reserved,Reserved bits"
            bitfld.long 0x00 16. "WILD,Write this bit to indicate that the dst_addr is a wildcard and all values are matched" "0: WILD,?..."
            newline
            hexmask.long.word 0x00 0.--15. 1. "ADR,Filter for the source MAC address used for the TX Lookup"
    group.long 0x20C++0x03
        line.long 0x00 "TX_DST_FILT_0,Filter for the destination MAC address used for the TX lookup"
            hexmask.long 0x00 0.--31. 1. "ADR,Filter for the source MAC address used for the TX Lookup"
    group.long 0x210++0x03
        line.long 0x00 "TX_PRG_LUT,Writing to this register causes the information contained in TX_SRC_FILT TX_DST_FILT and TX_PRG_LUT to be loaded into the entry of the Lookup Table corresponding to PHY_PORT and ENTRY being programmed"
            hexmask.long.word 0x00 16.--31. 1. "ETH_TYPE,Filter for the EtherType"
            bitfld.long 0x00 12.--15. "CA,CA value associated with the search parameters programmed" "0: CA,?..."
            newline
            rbitfld.long 0x00 10.--11. "reserved,Reserved bits" "0,1,2,3"
            bitfld.long 0x00 8.--9. "OUTCOME,Indicates the outcome when a match occurs for this SC" "0: OUTCOME,?..."
            newline
            bitfld.long 0x00 4.--7. "ENTRY,ENTRY in the Lookup Table of the PHY_PORT being programmed" "0: ENTRY,?..."
            rbitfld.long 0x00 1.--3. "reserved_1,Reserved bits" "0: Reserved_1,?..."
            newline
            bitfld.long 0x00 0. "PHY_PORT,Writing to this register causes the information contained in TX_SRC_FILT TX_DST_FILT and TX_PRG_LUT to be loaded into the entry of the Lookup Table corresponding to PHY_PORT and ENTRY being programmed" "0: PHY_PORT,?..."

    rgroup.long 0x218++0x03
        line.long 0x00 "TX_PG,When high indicates that an entry is either being inserted or deleted into the TX Lookup Table"
            hexmask.long 0x00 1.--31. 1. "reserved,Reserved bits"
            bitfld.long 0x00 0. "BUSY,When high indicates that an entry is either being inserted or deleted into the TX Lookup Table" "0: BUSY,?..."

    group.long 0x240++0x03
        line.long 0x00 "TX_ACTIVE_AN,Each bit of this register corresponds to the active SA for the corresponding CA to indicate which SA is currently active"
            hexmask.long.word 0x00 16.--31. 1. "reserved,Reserved bits"
            hexmask.long.word 0x00 0.--15. 1. "ACT_SA,When high indicates that an entry is either being inserted or deleted into the TX Lookup Table"
    group.long 0x800++0x03
        line.long 0x00 "MIB_CMD,The MIB_CMD register allows a user to indirectly access the MIB counters"
            hexmask.long.word 0x00 20.--31. 1. "reserved_0,Reserved bits"
            bitfld.long 0x00 16.--19. "OBJ_ID,Index of the counter's SA or SC to be read/written that counter can be either on a global SA or SC basis" "0: OBJ_ID,?..."
            newline
            rbitfld.long 0x00 15. "reserved_1,Reserved bit" "0,1"
            hexmask.long.byte 0x00 8.--14. 1. "CTR_ID,ID of the counter to access"
            newline
            rbitfld.long 0x00 6.--7. "reserved_2,Reserved bit" "0,1,2,3"
            bitfld.long 0x00 5. "CLR,If this bit is set the corresponding registers are cleared atomically with the read transaction" "0: CLR,?..."
            newline
            bitfld.long 0x00 4. "DIR,Specify the direction" "0: DIR,?..."
            rbitfld.long 0x00 3. "reserved_3,Reserved bit" "0,1"
            newline
            bitfld.long 0x00 0.--2. "CMD,The MIB_CMD register allows a user to indirectly access the MIB counters" "0: CMD,?..."

    rgroup.long 0x808++0x03
        line.long 0x00 "MIB_CMD_STAT,When high indicates that a MIB_CMD operation is underway"
            hexmask.long 0x00 1.--31. 1. "reserved,Reserved bits"
            bitfld.long 0x00 0. "BUSY,When high indicates that a MIB_CMD operation is underway" "0: BUSY,?..."

    group.long 0x810++0x03
        line.long 0x00 "MIB_VALIDATE,Each bit in this register indicates the default VALIDATE_FRAMES setting for each physical port"
            hexmask.long 0x00 1.--31. 1. "reserved,Reserved bits"
            bitfld.long 0x00 0. "PHY_MAP,Each bit in this register indicates the default VALIDATE_FRAMES setting for each physical port (as passed in the Pre-Control command)" "0: PHY_MAP,?..."
    group.long 0x820++0x03
        line.long 0x00 "MIB_WR_DATA_HIGH,Counter MSB value to be loaded when executing a write command (not applicable in a SA counter)"
            hexmask.long 0x00 0.--31. 1. "DATA,Counter MSB value to be loaded when executing a write command (not applicable in a SA counter"
    group.long 0x824++0x03
        line.long 0x00 "MIB_WR_DATA_LOW,Counter LSB value to be loaded when executing a write command"
            hexmask.long 0x00 0.--31. 1. "DATA,Counter LSB value to be loaded when executing a write command"

    rgroup.long 0xA00++0x03
        line.long 0x00 "MIB_CMD_D_BUF_HIGH_0,Contains the return MSB value of the 64 bit MIB Counter (Not applicable for SA counters as they are 32 bit values)"
