                line.long 0x00 "TIMER1CONTROLREG,Control Register for Timer N"
                    hexmask.long 0x00 5.--31. 1. "RSVD_TimerNControlReg,TimerNControlReg 31to5 Reserved field"
                    rbitfld.long 0x00 4. "RSVD_TIMER_0N100PWM_EN,TimerNControlReg 4 Reserved field" "0: UNKN_DESC,1: UNKN_DESC"
                    newline
