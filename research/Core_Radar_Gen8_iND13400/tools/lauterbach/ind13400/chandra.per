            hexmask.long.word 0x00 0.--9. 1. "IC_SAR2,The IC_SAR2 holds the slave address 2 when the I2C is operating as a slave"

    rgroup.long 0x11C++0x03
        line.long 0x00 "IC_CLR_WR_REQ,Clear WR_REQ Interrupt Register"
            hexmask.long 0x00 1.--31. 1. "RSVD_IC_CLR_WR_REQ,IC_CLR_WR_REQ Reserved bits - Read Only"
            newline
            bitfld.long 0x00 0. "CLR_WR_REQ,Read this register to clear the WR_REQ interrupt (bit 15) of the IC_RAW_INTR_STAT register" "0,1"
    rgroup.long 0x120++0x03
        line.long 0x00 "IC_CLR_SLV_ADDR_TAG,Clear CLR_SLV_ADDR_TAG Interrupt Register"
            hexmask.long 0x00 1.--31. 1. "RSVD_IC_CLR_SLV_ADDR_TAG,IC_CLR_SLV_ADDR_TAG Reserved bits - Read Only"
            newline
            bitfld.long 0x00 0. "CLR_SLV_ADDR_TAG,Read this register to clear all SLV_ADDRx_TAG (Where x is 1 through IC_NUM_SARS) interrupts (bit 16 ...(16+IC_NUM_SARS-1)) of the IC_RAW_INTR_STAT register" "0,1"
tree.end

