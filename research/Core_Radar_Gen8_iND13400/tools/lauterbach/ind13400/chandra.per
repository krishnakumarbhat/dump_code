    group.long 0x20++0x03
        line.long 0x00 "RETAIN_6,Retained data 6"
            hexmask.long 0x00 0.--31. 1. "RETAIN_6,This register is either reset by RSTN pin WDT or CRG.RESETREQ.ALL"
    group.long 0x24++0x03
        line.long 0x00 "RETAIN_7,Retained data 7"
            hexmask.long 0x00 0.--31. 1. "RETAIN_7,This register is either reset by RSTN pin WDT or CRG.RESETREQ.ALL"
    group.long 0x28++0x03
        line.long 0x00 "RETAIN_8,Retained data 8"
            hexmask.long 0x00 0.--31. 1. "RETAIN_8,This register is either reset by RSTN pin WDT or CRG.RESETREQ.ALL"
    group.long 0x2C++0x03
        line.long 0x00 "RETAIN_9,Retained data 9"
            hexmask.long 0x00 0.--31. 1. "RETAIN_9,This register is either reset by RSTN pin WDT or CRG.RESETREQ.ALL"
    group.long 0x30++0x03
        line.long 0x00 "RETAIN_A,Retained data A"
            hexmask.long 0x00 0.--31. 1. "RETAIN_A,This register is either reset by RSTN pin WDT or CRG.RESETREQ.ALL"
    group.long 0x34++0x03
        line.long 0x00 "RETAIN_B,Retained data B"
            hexmask.long 0x00 0.--31. 1. "RETAIN_B,This register is either reset by RSTN pin WDT or CRG.RESETREQ.ALL"
    group.long 0x38++0x03
        line.long 0x00 "RETAIN_C,Retained data C"
            hexmask.long 0x00 0.--31. 1. "RETAIN_C,This register is either reset by RSTN pin WDT or CRG.RESETREQ.ALL"
    group.long 0x3C++0x03
        line.long 0x00 "RETAIN_D,Retained data D"
            hexmask.long 0x00 0.--31. 1. "RETAIN_D,This register is either reset by RSTN pin WDT or CRG.RESETREQ.ALL"
    group.long 0x40++0x03
        line.long 0x00 "RETAIN_E,Retained data E"
            hexmask.long 0x00 0.--31. 1. "RETAIN_E,This register is either reset by RSTN pin WDT or CRG.RESETREQ.ALL"
    group.long 0x44++0x03
        line.long 0x00 "RETAIN_F,Retained data F"
            hexmask.long 0x00 0.--31. 1. "RETAIN_F,This register is either reset by RSTN pin WDT or CRG.RESETREQ.ALL"
    group.long 0x48++0x03
        line.long 0x00 "DEBUG_CODE,Debug access key"
            hexmask.long 0x00 0.--31. 1. "DEBUG_ACCESS_KEY,Write the value 0x1dacce55 to this register to enable debug options"

    rgroup.long 0x4C++0x03
        line.long 0x00 "DEBUG_STS,Debug access enabled"
            bitfld.long 0x00 0. "DEBUG_ACCESS_STATUS,A status flag that is set when debug access is enabled" "0,1"

    group.long 0x50++0x03
        line.long 0x00 "TRIM_CODE,Trim access key"
            hexmask.long 0x00 0.--31. 1. "TRIM_ACCESS_KEY,Write the value 0xCA005AFE to this register to set 'trim access_status' RO field to '1'"
    group.long 0x54++0x03
        line.long 0x00 "TRIM,Trim access enabled"
            bitfld.long 0x00 8.--10. "CTL_BG_RTRIM,BandGap voltage trim" "0,1,2,3,4,5,6,7"
            rbitfld.long 0x00 0. "TRIM_ACCESS_STATUS,A status flag that is set when TRIM_ACCESS_KEY is set to its key value" "0,1"

    rgroup.long 0x58++0x03
        line.long 0x00 "LBIST_SEQ_STAT0,LBIST Sequencer Status Register 0"
            bitfld.long 0x00 31. "STS_LBSC_TIM_EXP,Timeout expired for bootup LBIST" "0,1"
            bitfld.long 0x00 30. "STS_LBSC_TIM_ENA,Timeout was enabled for bootup LBIST" "0,1"
            newline
            hexmask.long.word 0x00 20.--29. 1. "STS_LBSC_LAST_ADDR,Last address as read out from OTP by LBIST sequencer"
            hexmask.long.word 0x00 4.--19. 1. "STS_LBSC_STATE,LBIST sequencer state"
            newline
            bitfld.long 0x00 3. "STS_LBSC_ERR,LBIST sequencer saw pslverr while reading out from OTP" "0,1"
            bitfld.long 0x00 2. "STS_LBSC_GOOD,LBIST sequencer completed and did not fail" "0,1"
            newline
            bitfld.long 0x00 1. "STS_LBSC_DONE,LBIST sequencer has loaded the In-System Test RAM" "0,1"
            bitfld.long 0x00 0. "STS_LBSC_LOADED,LBIST sequencer has loaded the In-System Test RAM" "0,1"

    group.long 0x5C++0x03
        line.long 0x00 "LBIST_MEM_MISC_CTRL0,LBIST Sequencer Memory Control Register"
            bitfld.long 0x00 31. "CTL_LBSC_IRQ_ENA,When this field is set (1) when functional/period LBIST is done an interrupt request will be triggered to supervisory processor" "0,1"
            bitfld.long 0x00 28.--29. "CTL_LBSC_PLBIST_BLK,When running functional/periodic LBIST each individual bit controls LBIST termination and clearing for a LBIST block" "0,1,2,3"
            newline
            bitfld.long 0x00 24. "CTL_LBSC_FUNC_RUN,Run LBIST from a 'functional' state as opposed to on power-up" "0,1"
            hexmask.long.byte 0x00 16.--23. 1. "CTL_LBSC_FUNC_KEY,This field must match 0x9e to allow SFR to kick off an LBIST run"
            newline
            bitfld.long 0x00 12. "CTL_LBSC_OP_WR,If set (1) then do RAM write's" "0,1"
            bitfld.long 0x00 8.--10. "CTL_LBSC_NUM_OPS,Number of operations to execute upon one toggling of CTL_LBSC_OP_GO" "0,1,2,3,4,5,6,7"
            newline
            hexmask.long.byte 0x00 0.--7. 1. "CTL_LBSC_MEM_KEY,This field must match 0xb5 to allow SFR access to the IST Memory"
    group.long 0x60++0x03
        line.long 0x00 "LBIST_MEM_MISC_CTRL1,LBIST Sequencer Memory Address Control Register"
            bitfld.long 0x00 16. "CTL_LBSC_OP_GO,Toggle (write to '1' then '0') to execute operation to IST Memory from SFR" "0,1"
            bitfld.long 0x00 12. "CTL_LBSC_ADDR_PUSH,Toggle (write '1' then '0') this field to push the field CTL_LBSC_ADDR_INIT into internal registers" "0,1"
            newline
            hexmask.long.word 0x00 0.--9. 1. "CTL_LBSC_ADDR_INIT,This field allows user to explicitly set the IST memory address to write or read from"

    rgroup.long 0x64++0x03
        line.long 0x00 "LBIST_MEM_MISC_STAT,LBIST Sequencer Memory Address Status Register"
            bitfld.long 0x00 16. "STS_LBSC_OP_DONE,Operations from toggling CTL_LBSC_OP_GO are complete" "0,1"
