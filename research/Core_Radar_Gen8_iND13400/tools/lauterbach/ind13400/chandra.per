            rbitfld.long 0x00 21.--23. "Reserved_23_21,Reserved" "0,1,2,3,4,5,6,7"
            newline
            bitfld.long 0x00 18.--20. "DSL,Descriptor Skip Length This bit specifies the Dword (64-bit) number of locations to skip between two descriptors" "0,1,2,3,4,5,6,7"
            newline
            rbitfld.long 0x00 17. "Reserved_17,Reserved" "0,1"
            newline
            bitfld.long 0x00 16. "PBLx8,8xPBL mode" "0: 8xPBL mode is disabled,1: 8xPBL mode is enabled"
