            newline
            hexmask.long.byte 0x00 0.--7. 1. "GPIO_INTEN,Allows each bit of Port A to be configured for interrupts"
    group.long 0x34++0x03
        line.long 0x00 "GPIO_INTMASK,Interrupt mask register Note: This register is available only if Port A is configured to generate interrupts (GPIO_PORTA_INTR = Include (1))"
