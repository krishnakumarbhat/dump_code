    group.long 0x11B4++0x03
        line.long 0x00 "DMA_CH1_Interrupt_Enable,The Channel1 Interrupt Enable register enables the interrupts reported by the Status register"
            hexmask.long.word 0x00 16.--31. 1. "Reserved_31_16,Reserved"
            newline
