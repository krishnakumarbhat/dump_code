                line.long 0x00 "TIMER7EOI,Name: Timer7 End-of-Interrupt Register Size: 1 bit Address Offset: 132 Read/Write Access: Read"
                    hexmask.long 0x00 1.--31. 1. "RSVD_TIMER7EOI,TimerNEOI 31to1 Reserved field"
                    bitfld.long 0x00 0. "TIMER7EOI,Reading from this register returns all zeroes (0) and clears the interrupt from Timer7" "0,1"
            rgroup.long 0x88++0x03
                line.long 0x00 "TIMER7INTSTAT,Name: Timer7 Interrupt Status Register Size: 1 bit Address Offset: 136 Read/Write Access: Read"
                    hexmask.long 0x00 1.--31. 1. "RSVD_TIMER7INTSTAT,TimerNIntStatus 31to1 Reserved field"
                    bitfld.long 0x00 0. "TIMER7INTSTAT,Contains the interrupt status for Timer7" "0: Timer7 Interrupt is inactive,1: Timer7 Interrupt is active"

            group.long 0x8C++0x03
                line.long 0x00 "TIMER8LOADCOUNT,Name: Timer8 Load Count Register Size: 8-32 bits Address Offset: 140 Read/Write Access: Read/"
                    hexmask.long 0x00 0.--31. 1. "TIMER8LOADCOUNT,Value to be loaded into Timer8"

            rgroup.long 0x90++0x03
                line.long 0x00 "TIMER8CURRENTVAL,Name: Timer8 Current Value Size: 8-32 bits Address Offset: 144 Read/Write Access: Read"
                    hexmask.long 0x00 0.--31. 1. "TIMER8CURRENTVAL,Current Value of Timer8"

            group.long 0x94++0x03
                line.long 0x00 "TIMER8CONTROLREG,Name: Timer8 Control Register Size: 4 bits Address Offset: 148 Read/Write Access: Read/Write This register controls enabling operating mode (free-running or defined-count) and interrupt mask of Timer8"
                    hexmask.long 0x00 5.--31. 1. "RSVD_TIMER8CONTROLREG,TimerNControlReg 31to5 Reserved field"
                    rbitfld.long 0x00 4. "RSVD_TIMER_0N100PWM_EN,TimerNControlReg 4 Reserved field" "0: UNKN_DESC,1: UNKN_DESC"
                    newline
                    bitfld.long 0x00 3. "TIMER_PWM,Pulse Width Modulation of timer_8_toggle output" "0: PWM for timer_8_toggle o/p is disabled,1: PWM for timer_8_toggle o/p is enabled"
                    bitfld.long 0x00 2. "TIMER_INTERRUPT_MASK,Timer interrupt mask for Timer8" "0: Timer8 interrupt is unmasked,1: Timer8 interrupt is masked"
                    newline
                    bitfld.long 0x00 1. "TIMER_MODE,Timer mode for Timer8" "0: Free Running mode of operation,1: User-Defined mode of operation"
                    bitfld.long 0x00 0. "TIMER_ENABLE,Timer enable bit for Timer8" "0: Timer8 is disabled,1: Timer8 is enabled"

            rgroup.long 0x98++0x03
                line.long 0x00 "TIMER8EOI,Name: Timer8 End-of-Interrupt Register Size: 1 bit Address Offset: 152 Read/Write Access: Read"
                    hexmask.long 0x00 1.--31. 1. "RSVD_TIMER8EOI,TimerNEOI 31to1 Reserved field"
                    bitfld.long 0x00 0. "TIMER8EOI,Reading from this register returns all zeroes (0) and clears the interrupt from Timer8" "0,1"
            rgroup.long 0x9C++0x03
                line.long 0x00 "TIMER8INTSTAT,Name: Timer8 Interrupt Status Register Size: 1 bit Address Offset: 156 Read/Write Access: Read"
                    hexmask.long 0x00 1.--31. 1. "RSVD_TIMER8INTSTAT,TimerNIntStatus 31to1 Reserved field"
                    bitfld.long 0x00 0. "TIMER8INTSTAT,Contains the interrupt status for Timer8" "0: Timer8 Interrupt is inactive,1: Timer8 Interrupt is active"
            rgroup.long 0xA0++0x03
                line.long 0x00 "TimersIntStatus,Contains the interrupt status of all timers in the component"
                    hexmask.long.tbyte 0x00 8.--31. 1. "RSVD_TimersIntStatus,TimersIntStatus 31toNUM_TIMERS Reserved field"
                    hexmask.long.byte 0x00 0.--7. 1. "TimersIntStatus,Contains the interrupt status of all timers in the component"
            rgroup.long 0xA4++0x03
                line.long 0x00 "TimersEOI,Returns all zeroes (0) and clears all active interrupts"
                    hexmask.long.tbyte 0x00 8.--31. 1. "RSVD_TIMERSEOI,TimersEOI 31toNUM_TIMERS Reserved field"
                    hexmask.long.byte 0x00 0.--7. 1. "TIMERSEOI,Reading this register returns all zeroes (0) and clears all active interrupts"
            rgroup.long 0xA8++0x03
                line.long 0x00 "TimersRawIntStatus,Contains the unmasked interrupt status of all timers in the component"
                    hexmask.long.tbyte 0x00 8.--31. 1. "RSVD_TIMERSRAWINTSTAT,TimersRawIntStatus 31toNUM_TIMERS Reserved field"
                    hexmask.long.byte 0x00 0.--7. 1. "TIMERSRAWINTSTAT,The register contains the unmasked interrupt status of all timers in the component"
            rgroup.long 0xAC++0x03
                line.long 0x00 "TIMERS_COMP_VERSION,Current revision number of the DW_apb_timers component"
                    hexmask.long 0x00 0.--31. 1. "TIMERSCOMPVERSION,Current revision number of the DW_apb_timers component.For the value see the releases table in the AMBA 2 release notes"

            group.long 0xB0++0x03
                line.long 0x00 "TIMER1LOADCOUNT2,Value to be loaded into Timer N when toggle output changes from 0 to 1"
                    hexmask.long 0x00 0.--31. 1. "TIMERNLOADCOUNT2,Value to be loaded into Timer N when timer_N_toggle output changes from 0 to 1"
            group.long 0xB4++0x03
                line.long 0x00 "TIMER2LOADCOUNT2,Name: Timer2 Load Count2 Register Size: 8-32 bits Address Offset: 180 Read/Write Access: Read/"
                    hexmask.long 0x00 0.--31. 1. "TIMER2LOADCOUNT2,Value to be loaded into Timer2 when timer_2_toggle output changes from 0 to 1"
            group.long 0xB8++0x03
                line.long 0x00 "TIMER3LOADCOUNT2,Name: Timer3 Load Count2 Register Size: 8-32 bits Address Offset: 184 Read/Write Access: Read/"
                    hexmask.long 0x00 0.--31. 1. "TIMER3LOADCOUNT2,Value to be loaded into Timer3 when timer_3_toggle output changes from 0 to 1"
            group.long 0xBC++0x03
                line.long 0x00 "TIMER4LOADCOUNT2,Name: Timer4 Load Count2 Register Size: 8-32 bits Address Offset: 188 Read/Write Access: Read/"
                    hexmask.long 0x00 0.--31. 1. "TIMER4LOADCOUNT2,Value to be loaded into Timer4 when timer_4_toggle output changes from 0 to 1"
            group.long 0xC0++0x03
                line.long 0x00 "TIMER5LOADCOUNT2,Name: Timer5 Load Count2 Register Size: 8-32 bits Address Offset: 192 Read/Write Access: Read/"
                    hexmask.long 0x00 0.--31. 1. "TIMER5LOADCOUNT2,Value to be loaded into Timer5 when timer_5_toggle output changes from 0 to 1"
            group.long 0xC4++0x03
                line.long 0x00 "TIMER6LOADCOUNT2,Name: Timer6 Load Count2 Register Size: 8-32 bits Address Offset: 196 Read/Write Access: Read/"
                    hexmask.long 0x00 0.--31. 1. "TIMER6LOADCOUNT2,Value to be loaded into Timer6 when timer_6_toggle output changes from 0 to 1"
            group.long 0xC8++0x03
                line.long 0x00 "TIMER7LOADCOUNT2,Name: Timer7 Load Count2 Register Size: 8-32 bits Address Offset: 200 Read/Write Access: Read/"
                    hexmask.long 0x00 0.--31. 1. "TIMER7LOADCOUNT2,Value to be loaded into Timer7 when timer_7_toggle output changes from 0 to 1"
            group.long 0xCC++0x03
                line.long 0x00 "TIMER8LOADCOUNT2,Name: Timer8 Load Count2 Register Size: 8-32 bits Address Offset: 204 Read/Write Access: Read/"
