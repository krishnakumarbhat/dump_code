tree "TIMERS ()"
    repeat 2. (list 0. 1.) (list ad:0x91923000 ad:0x91926000)
        tree "TIMERS$1"
            base $2
            group.long 0x00++0x03
                line.long 0x00 "TIMER1LOADCOUNT,Value to be loaded into Timer N"
                    hexmask.long 0x00 0.--31. 1. "TIMER1LOADCOUNT,Value to be loaded into Timer 1"

            rgroup.long 0x04++0x03
                line.long 0x00 "TIMER1CURRENTVAL,Current value of Timer N"
                    hexmask.long 0x00 0.--31. 1. "TIMER1CURRENTVAL,Current Value of Timer 1"

