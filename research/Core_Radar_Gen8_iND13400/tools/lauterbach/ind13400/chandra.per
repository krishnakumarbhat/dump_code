    group.long 0x198++0x03
        line.long 0x00 "IRQ_ERR_STAT0,Error IRQ Status"
            hexmask.long.tbyte 0x00 0.--23. 1. "STS_ERR,Each bit corresponds to an error"
    group.long 0x19C++0x03
        line.long 0x00 "IRQ_INFO_ENA_CTRL0,IRQ Enable control"
            bitfld.long 0x00 2.--3. "CTL_IDMA_TRIG_ENA,Bit enables of direct triggering of BBE's IDMA" "0: Finished writing to an input buffer based on..,1: Aux Accelerator datapath finished processing of,?..."
