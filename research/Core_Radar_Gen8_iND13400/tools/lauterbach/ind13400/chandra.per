tree "GPIO (General Purpose I/O Ports And Peripheral I/O Lines)"
    base ad:0x91925000
    group.long 0x00++0x03
        line.long 0x00 "GPIO_SWPORTA_DR,Port A data register"
            hexmask.long.tbyte 0x00 8.--31. 1. "RSVD_GPIO_SWPORTA_DR,RSVD_GPIO_SWPORTA_DR Reserved bits - read as zero"
            newline
            hexmask.long.byte 0x00 0.--7. 1. "GPIO_SWPORTA_DR,Values written to this register are output on the I/O signals for Port A if the corresponding data direction bits for Port A are set to Output mode and the corresponding control bit for Port A is set to Software mode"
    group.long 0x04++0x03
        line.long 0x00 "GPIO_SWPORTA_DDR,Port A Data Direction Register"
            hexmask.long.tbyte 0x00 8.--31. 1. "RSVD_GPIO_SWPORTA_DDR,RSVD_GPIO_SWPORTA_DDR Reserved bits - read as zero"
            newline
            hexmask.long.byte 0x00 0.--7. 1. "GPIO_SWPORTA_DDR,Values written to this register independently control the direction of the corresponding data bit in Port A"
    group.long 0x0C++0x03
        line.long 0x00 "GPIO_SWPORTB_DR,Port B data register"
            hexmask.long.tbyte 0x00 8.--31. 1. "RSVD_GPIO_SWPORTB_DR,RSVD_GPIO_SWPORTB_DR Reserved bits - read as zero"
            newline
