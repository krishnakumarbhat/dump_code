        line.long 0x00 "MAC_System_Time_Seconds,The System Time Seconds register along with System Time Nanoseconds register indicates the current value of the system time maintained by the MAC"
            hexmask.long 0x00 0.--31. 1. "TSS,Timestamp Second The value in this field indicates the current value in seconds of the System Time maintained by the MAC"
    rgroup.long 0xB0C++0x03
        line.long 0x00 "MAC_System_Time_Nanoseconds,The System Time Nanoseconds register along with System Time Seconds register indicates the current value of the system time maintained by the MAC"
            bitfld.long 0x00 31. "Reserved_31,Reserved" "0,1"
            newline
