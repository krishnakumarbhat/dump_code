            newline
            rbitfld.long 0x00 29. "XIP_PREFETCH_EN,Enables XIP pre-fetch functionality in DWC_ssi" "0,1"
            newline
            rbitfld.long 0x00 28. "RSVD_SPI_CTRLR0_28,Reserved bits - read as zero" "0,1"
            newline
            rbitfld.long 0x00 26.--27. "XIP_MBL,XIP Mode bits length" "0: Mode bits length equal to 2,1: Mode bits length equal to 4,2: Mode bits length equal to 8,3: Mode bits length equal to 16"
            newline
            rbitfld.long 0x00 25. "SPI_RXDS_SIG_EN,Enable rxds signaling during address and command phase of Hypebus transfer" "0,1"
            newline
            rbitfld.long 0x00 24. "SPI_DM_EN,SPI data mask enable bit" "0,1"
