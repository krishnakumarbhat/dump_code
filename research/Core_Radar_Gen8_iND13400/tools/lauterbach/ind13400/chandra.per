    rgroup.long 0x2BC++0x03
        line.long 0x00 "DEBUG_REG_2,Debug register"
            bitfld.long 0x00 28. "DDM_READ_MODE_ERR,It is asserted if the DDM mode is enabled and the input_manager is bypassed or a non-power of 2 size is used" "0,1"
            newline
            bitfld.long 0x00 27. "REAL_TO_COMPLEX_MODE_ERR,It is asserted under two condition: If IN_FETCH_MODE is set to 6 and a real FFT type is set or If IN_FETCH_MODE is set to 6 and the IN_SIZE is bigger than 127" "0,1"
            newline
            bitfld.long 0x00 26. "EST_READ_SIZE_ERR,It is asserted when a read with reorder is commanded from the output stage to any estimator and the IN_SIZE is not a power of 2 minus 1" "0,1"
            newline
            bitfld.long 0x00 25. "EST_3_OUTPUT_FORMAT_ERR,It is asserted if output from the estimator 3 is enabled and output format is not set to 1" "0,1"
            newline
            bitfld.long 0x00 24. "EST_2_OUTPUT_FORMAT_ERR,It is asserted if output from the estimator 2 is enabled and output format is not set to 1" "0,1"
            newline
            bitfld.long 0x00 23. "EST_1_OUTPUT_FORMAT_ERR,It is asserted if output from the estimator 1 is enabled and output format is not set to 1" "0,1"
            newline
            bitfld.long 0x00 22. "EST_OUTPUT_READ_ERR,It is asserted if output from estimators is enabled and the processing stage is active or the output stage is inactive or if read from any estimator is not enabled" "0,1"
            newline
            bitfld.long 0x00 21. "ALTERNATE_BANKS_ERR,If dpmem access is used and alterante_dpmem_banks is active one of the generic counters must be in use" "0,1"
            newline
            bitfld.long 0x00 20. "POSP_INVALID_SIZE_ERR,Post-processor invalid size error is asserted when the block is active (processing stage enabled and post-processor not bypassed) and one of the following conditions is met: - FFT core is not bypassed and PREP_BLOCK_SIZE !=.." "0,1"
            newline
            bitfld.long 0x00 19. "PREP_INVALID_SIZE_ERR,Pre-processor invalid size error is asserted when the block is active (processing stage enabled and pre-processor not bypassed) and one of the following conditions is met: - FFT core is not bypassed and PREP_BLOCK_SIZE !=.." "0,1"
            newline
            bitfld.long 0x00 18. "IN_SIZE_DATA_REORDER_ERR,It is triggered if zero padding is not requested (FFT_TYPE==3 and FORCE_ZERO_PAD!=0) but the IN_SIZE is not power of 2 and the input_manager or output_manager blocks are configured for data reordering" "0,1"
            newline
            bitfld.long 0x00 17. "IN_SIZE_UNCOMP_ERR,If input stage is enable decompressor is bypassed and fetch_mode!=2 in_size shall be odd" "0,1"
            newline
            bitfld.long 0x00 16. "COMP_NO_ITER_ERR,It is asserted if the output stage is active the iteration mode is 0 and the compressor level is not 0" "0,1"
            newline
            bitfld.long 0x00 15. "DECOMP_NO_ITER_ERR,It is asserted if the input stage is active the iteration mode is 0 and the decompressor level is not 0 and the IN_FETCH_MODE is not 2" "0,1"
            newline
            bitfld.long 0x00 14. "FFT_REAL_ERR,It is asserted if FFT_TYPE is 1 or 2 (real modes) the output stage is enabled and the OUTPUT_MNGR_MODE!=0" "0,1"
            newline
            bitfld.long 0x00 13. "FFT_SIZE_ERR,Is asserted if FFT_TYPE!=3 and IN_SIZE is not a power of 2 minus 1 and INPUT_MNGR_MODE==3 (bypass)" "0,1"
            newline
            bitfld.long 0x00 12. "FETCH_MODE_MIPI_ADDR_ERR,It's asserted if IN_FETCH_MODE==2 and input stage is enabled and IN_ADDR_START is different from the MIPI's address" "0,1"
            newline
            bitfld.long 0x00 11. "FETCH_MODE_MIPI_FFT_ERR,It's asserted if IN_FETCH_MODE==2 and input stage is enabled and FFT_TYPE is different from 2 (Real 2N) or 3 (bypass)" "0,1"
            newline
            bitfld.long 0x00 10. "OUT_MNGR_MODE_2_ERR,It's asserted if OUTPUT_MNGR_MODE==2 (bypass) and any of the following conditions happen: - PROC_OP_SET and OUT_OP_SET aren't either both 1 or both" "0,1"
            newline
            bitfld.long 0x00 9. "IN_MNGR_MODE_3_ERR,It is asserted in two conditions: - If the input manager is bypassed and IN_OP_SET and PROC_OP_SET are neither both 1 nor both 0" "0,1"
            newline
            bitfld.long 0x00 8. "IN_MNGR_MODE_1_ERR,It is asserted if INPUT_MNGR_MODE=1 and IN_OP_SET=1 or IN_SIZE is different from 31 63 127 or 255 (zero padding is needed)" "0,1"
            newline
            hexmask.long.byte 0x00 0.--6. 1. "INVALID_CMD_ID,CMD_ID of the last invalid command"

