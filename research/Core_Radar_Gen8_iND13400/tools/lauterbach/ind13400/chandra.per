tree "UART (Universal Asynchronous Receiver/Transmitter)"
    base ad:0x91924000
    rgroup.long 0x00++0x03
        line.long 0x00 "RBR,Receive Buffer Register"
            hexmask.long.tbyte 0x00 8.--31. 1. "RSVD_RBR,RBR 31to9or8 Reserved bits and read as zero (0)"
            newline
            hexmask.long.byte 0x00 0.--7. 1. "RBR,Receive Buffer Register"

    group.long 0x04++0x03
        line.long 0x00 "IER,Interrupt Enable Register"
            hexmask.long.tbyte 0x00 8.--31. 1. "RSVD_IER_31to8,IER 31to8 Reserved bits and read as zero (0)"
            newline
            bitfld.long 0x00 7. "PTIME,Programmable THRE Interrupt Mode Enable" "0: Disable Programmable THRE Interrupt Mode,1: Enable Programmable THRE Interrupt Mode"
            newline
            rbitfld.long 0x00 5.--6. "RSVD_IER_6to5,IER 6to5 Reserved bits read as zero (0)" "0,1,2,3"
            newline
            rbitfld.long 0x00 4. "ELCOLR,Interrupt Enable Register: ELCOLR this bit controls the method for clearing the status in the LSR register" "0: Disable ALC,1: Enable ALC"
            newline
            bitfld.long 0x00 3. "EDSSI,Enable Modem Status Interrupt" "0: Disable Modem Status Interrupt,1: Enable Modem Status Interrupt"
            newline
            bitfld.long 0x00 2. "ELSI,Enable Receiver Line Status Interrupt" "0: Disable Receiver Line Status Interrupt,1: Enable Receiver Line Status Interrupt"
            newline
            bitfld.long 0x00 1. "ETBEI,Enable Transmit Holding Register Empty Interrupt" "0: Disable Transmit empty interrupt,1: Enable Transmit empty interrupt"
            newline
            bitfld.long 0x00 0. "ERBFI,Enable Received Data Available Interrupt" "0: Disable Receive data Interrupt,1: Enable Receive data Interrupt"

    rgroup.long 0x08++0x03
        line.long 0x00 "IIR,Interrupt Identification Register"
            hexmask.long.tbyte 0x00 8.--31. 1. "RSVD_IIR_31to8,IIR 31to8 Reserved bits and read as 0"
            newline
            bitfld.long 0x00 6.--7. "FIFOSE,FIFOs Enabled" "0: FIFOs are disabled,?,?,3: FIFOs are enabled"
            newline
            bitfld.long 0x00 4.--5. "RSVD_IIR_5to4,IIR 5to4 Reserved bits read as 0" "0,1,2,3"
            newline
            bitfld.long 0x00 0.--3. "IID,Interrupt ID (or IID)" "0: MODEM_STATUS,1: NO_INTERRUPT_PENDING,2: THR_EMPTY,?,4: RECEIVED_DATA_AVAILABLE,?,6: RECEIVER_LINE_STATUS,7: BUSY_DETECT,?,?,?,?,12: CHARACTER_TIMEOUT,?..."

    group.long 0x0C++0x03
        line.long 0x00 "LCR,Line Control Register"
            hexmask.long.tbyte 0x00 8.--31. 1. "RSVD_LCR_31to8,LCR 31to8 Reserved bits and read as 0"
            newline
            bitfld.long 0x00 7. "DLAB,Divisor Latch Access Bit" "0: Divisor Latch register is writable only when..,1: Divisor Latch register is always readable and.."
            newline
            bitfld.long 0x00 6. "BC,Break Control Bit" "0: Serial output is released for data transmission,1: Serial output is forced to spacing state"
            newline
            bitfld.long 0x00 5. "SP,Stick Parity" "0: Stick parity disabled,1: Stick parity enabled"
            newline
            bitfld.long 0x00 4. "EPS,Even Parity Select" "0: an odd parity is transmitted or checked,1: an even parity is transmitted or checked"
            newline
            bitfld.long 0x00 3. "PEN,Parity Enable" "0: disable parity,1: enable parity"
            newline
            bitfld.long 0x00 2. "STOP,Number of stop bits" "0: 1 stop bit,1: 1.5 stop bits when DLS (LCR[1:0]) is zero.."
            newline
            bitfld.long 0x00 0.--1. "DLS,Data Length Select (or CLS as used in legacy)" "0: 5 data bits per character,1: 6 data bits per character,2: 7 data bits per character,3: 8 data bits per character"
    group.long 0x10++0x03
        line.long 0x00 "MCR,Modem Control Register"
            hexmask.long 0x00 7.--31. 1. "RSVD_MCR_31to7,MCR 31to7 Reserved bits read as 0"
            newline
            rbitfld.long 0x00 6. "SIRE,SIR Mode Enable Writeable only when SIR_MODE == Enabled always readable" "0: IrDA SIR Mode disabled,1: IrDA SIR Mode enabled"
            newline
            rbitfld.long 0x00 5. "AFCE,Auto Flow Control Enable Writeable only when AFCE_MODE == Enabled always readable" "0: Auto Flow Control Mode disabled,1: Auto Flow Control Mode enabled"
            newline
            bitfld.long 0x00 4. "LoopBack,LoopBack Bit This is used to put the UART into a diagnostic mode for test purposes" "0: Loopback mode disabled,1: Loopback mode enabled"
            newline
            bitfld.long 0x00 3. "OUT2,OUT2 This is used to directly control the user-designated Output2 (out2_n) output" "0: out2_n de-asserted (logic 1),1: out2_n asserted (logic 0)"
            newline
            bitfld.long 0x00 2. "OUT1,OUT1 This is used to directly control the user-designated Output1 (out1_n) output" "0: out1_n de-asserted (logic 1),1: out1_n asserted (logic 0)"
            newline
            bitfld.long 0x00 1. "RTS,Request to Send" "0: Request to Send rts_n de-asserted (logic 1),1: Request to Send rts_n asserted (logic 0)"
            newline
            bitfld.long 0x00 0. "DTR,Data Terminal Ready" "0: dtr_n de-asserted (logic1),1: dtr_n asserted (logic 0)"

    rgroup.long 0x14++0x03
        line.long 0x00 "LSR,Line Status Register"
            hexmask.long.tbyte 0x00 9.--31. 1. "RSVD_LSR_31to9,LSR 31to9 Reserved bits read as zero"
            newline
            bitfld.long 0x00 8. "RSVD_ADDR_RCVD,lSR 8 Reserved bit for UART_9BIT_DATA_EN" "0,1"
            newline
            bitfld.long 0x00 7. "RFE,Receiver FIFO Error bit" "0: No error in RX FIFO,1: Error in RX FIFO"
            newline
            bitfld.long 0x00 6. "TEMT,Transmitter Empty bit" "0: Transmitter not empty,1: Transmitter empty"
            newline
            bitfld.long 0x00 5. "THRE,Transmit Holding Register Empty bit" "0: THRE interrupt control is disabled,1: THRE interrupt control is enabled"
            newline
            bitfld.long 0x00 4. "BI,Break Interrupt bit" "0: No break sequence detected,1: Break sequence detected"
            newline
            bitfld.long 0x00 3. "FE,Framing Error bit" "0: NO_FRAMING_ERROR,1: FRAMING_ERROR"
            newline
            bitfld.long 0x00 2. "PE,Parity Error bit" "0: NO_PARITY_ERROR,1: PARITY_ERROR"
            newline
            bitfld.long 0x00 1. "OE,Overrun error bit" "0: NO_OVER_RUN_ERROR,1: OVER_RUN_ERROR"
            newline
            bitfld.long 0x00 0. "DR,Data Ready bit" "0: data not ready,1: data ready"
    rgroup.long 0x18++0x03
        line.long 0x00 "MSR,Whenever bits 0 1 2 or 3 is set to logic one to indicate a change on the modem control inputs a modem status interrupt will be generated if enabled via the IER regardless of when the change occurred"
            hexmask.long.tbyte 0x00 8.--31. 1. "RSVD_MSR_31to8,MSR 31to8 Reserved bits read as 0"
            newline
            bitfld.long 0x00 7. "DCD,Data Carrier Detect" "0: dcd_n input is de-asserted (logic 1),1: dcd_n input is asserted (logic 0)"
            newline
            bitfld.long 0x00 6. "RI,Ring Indicator" "0: ri_n input is de-asserted (logic 1),1: ri_n input is asserted (logic 0)"
            newline
            bitfld.long 0x00 5. "DSR,Data Set Ready" "0: dsr_n input is de-asserted (logic 1),1: dsr_n input is asserted (logic 0)"
            newline
            bitfld.long 0x00 4. "CTS,Clear to Send" "0: cts_n input is de-asserted (logic 1),1: cts_n input is asserted (logic 0)"
            newline
            bitfld.long 0x00 3. "DDCD,Delta Data Carrier Detect" "0: No change on dcd_n since last read of MSR,1: change on dcd_n since last read of MSR"
            newline
            bitfld.long 0x00 2. "TERI,Trailing Edge of Ring Indicator" "0: no change on ri_n since last read of MSR,1: change on ri_n since last read of MSR"
            newline
            bitfld.long 0x00 1. "DDSR,Delta Data Set Ready" "0: no change on dsr_n since last read of MSR,1: change on dsr_n since last read of MSR"
            newline
            bitfld.long 0x00 0. "DCTS,Delta Clear to Send" "0: no change on cts_n since last read of MSR,1: change on cts_n since last read of MSR"

    group.long 0x1C++0x03
