    rgroup.long 0x1080++0x03
        line.long 0x00 "DMA_Safety_Interrupt_Status,This register indicates summary (whether error occurred in DMA/MTL/MAC and correctable/uncorrectable) of the Automotive Safety related error interrupts"
            bitfld.long 0x00 31. "MCSIS,MAC Safety Uncorrectable Interrupt Status Indicates a uncorrectable Safety related Interrupt is set in the MAC module" "0: MAC Safety Uncorrectable Interrupt Status not..,1: MAC Safety Uncorrectable Interrupt Status.."
            newline
            bitfld.long 0x00 30. "Reserved_30,Reserved" "0,1"
            newline
            bitfld.long 0x00 29. "MSUIS,MTL Safety Uncorrectable error Interrupt Status This bit indicates an uncorrectable error interrupt event in MTL" "0: MTL Safety Uncorrectable error Interrupt..,1: MTL Safety Uncorrectable error Interrupt.."
            newline
            bitfld.long 0x00 28. "MSCIS,MTL Safety Correctable error Interrupt Status This bit indicates a correctable error interrupt event in MTL" "0: MTL Safety Correctable error Interrupt Status..,1: MTL Safety Correctable error Interrupt Status.."
            newline
            hexmask.long 0x00 2.--27. 1. "Reserved_27_2,Reserved"
            newline
            bitfld.long 0x00 1. "DEUIS,DMA ECC Uncorrectable error Interrupt Status This bit indicates an interrupt event in the DMA ECC safety feature" "0: DMA ECC Uncorrectable error Interrupt Status..,1: DMA ECC Uncorrectable error Interrupt Status.."
            newline
            bitfld.long 0x00 0. "DECIS,DMA ECC Correctable error Interrupt Status This bit indicates an interrupt event in the DMA ECC safety feature" "0: DMA ECC Correctable error Interrupt Status..,1: DMA ECC Correctable error Interrupt Status.."

    group.long 0x1084++0x03
        line.long 0x00 "DMA_ECC_Interrupt_enable,This register is used to enable the Automotive Safety related TSO memory/DCACHE ECC error interrupt"
