    group.long 0xC30++0x03
        line.long 0x00 "MTL_RxQ_DMA_Map0,This register controls the Dynamic (per packet) or Static (all packets in a Receive Queue) DMA Channel Selection for lower numbered Receive Queues"
            rbitfld.long 0x00 29.--31. "Reserved_31_29,Reserved" "0,1,2,3,4,5,6,7"
