            hexmask.long.word 0x00 16.--31. 1. "RSVD_IC_FS_SCL_LCNT,IC_FS_SCL_LCNT Reserved bits - Read Only"
            newline
            abitfld.long 0x00 0.--15. "IC_FS_SCL_LCNT,This register must be set before any I2C bus transaction can take place to ensure proper I/O timing" "0x0005=5: ((IC_CLK_FREQ_OPTIMIZATION==1) ?,0x0006=6: 8)) Hardware prevents values less than.."

    rgroup.long 0x2C++0x03
        line.long 0x00 "IC_INTR_STAT,I2C Interrupt Status Register"
            hexmask.long.word 0x00 20.--31. 1. "RSVD_IC_INTR_STAT,IC_INTR_STAT Reserved bits - Read Only"
            newline
            bitfld.long 0x00 17. "R_SLV_ADDR2_TAG,See IC_RAW_INTR_STAT for a detailed description of R_SLV_ADDR2_TAG bit" "0: SLV_ADDR2_TAG interrupt is inactive,1: SLV_ADDR2_TAG interrupt is active"
            newline
