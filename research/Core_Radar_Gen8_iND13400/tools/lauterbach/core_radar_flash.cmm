;*===========================================================================
;* End Dialog
;*===========================================================================
IF "&ic0"==""
(
   &n=0
   WHILE &n<10.
   (
      DIALOG.Disable LSYM0[&n]
      &n=&n+1
   )
)
IF "&ic1"==""
(
   &n=0
   WHILE &n<10.
   (
      DIALOG.Disable LSYM1[&n]
      &n=&n+1
   )
)
IF "&ic2"==""
(
   &n=0
   WHILE &n<10.
   (
      DIALOG.Disable LSYM2[&n]
      &n=&n+1
   )
)
IF "&ic3"==""
(
   &n=0
   WHILE &n<10.
   (
      DIALOG.Disable LSYM3[&n]
      &n=&n+1
   )
)
IF "&ic4"==""
(
   &n=0
   WHILE &n<10.
   (
      DIALOG.Disable LSYM4[&n]
      &n=&n+1
   )
)

GOSUB Load_Flash_Session

IF &auto_flash
(
   PRINT "Auto Flashing"
   &clks=CLOCK.SECONDS()
   PRINT "Start Flashing: "+CLOCK.TIME()
   jumpto FlashAll
)
STOP

;*===========================================================================
;* end of scripting for dialog window.
;*===========================================================================

;*===========================================================================*
FlashAll:

; Save the current flash session
&flash_session="&last_flash_session"
GOSUB Save_Flash_Session

; check for flashing request(s)
&n=0
&lcode_flag=(0==1)
WHILE &n<10.
(
   IF DIALOG.BOOLEAN(LCODE[&n])
   (
      &lcode_flag=(0==0)
   )
   &n=&n+1
)

IF ("&pre_flash_scripts"!="")
(
   &scripts="&pre_flash_scripts "
   WHILE STRing.SCAN("&scripts", " ", 0.)!=-1
   (
      PRIVATE &script
      &script=STRing.Split("&scripts", " ", 0.)

      PRINT "pre flash: &core_script_path/&script"
      DO &core_script_path/&script

      &scripts=STRing.Replace("&scripts", "&script ", "", 0.)
   )
)

; load the appropriate flash configuration
PRINT "Configuring Flash"
&flash_offset=0
IF &lcode_flag||DIALOG.BOOLEAN(PRE_ERASE)
(
   DO &core_script_path/&cpu/flash CONFIGURE
)

;*===========================================================================
IF DIALOG.BOOLEAN(PRE_ERASE)
(
   PRINT "Erasing all Flash"

   DO &core_script_path/&cpu/flash ERASE ALL
   PRINT "Complete"
)
;*===========================================================================
PRINT "Programming Flash"
&n=0
WHILE &n<10.
(
   &fname=DIALOG.STRING(LFILE[&n])
   IF "&fname"!=""&&(DIALOG.BOOLEAN(LCODE[&n]))
   (
      PRINT "Loading &fname into flash"
      DO &core_script_path/&cpu/flash PROGRAM "&fname"
   )

   &n=&n+1
)

PRINT "Complete"
;*===========================================================================

;*===========================================================================
;LOAD Symbols
;*===========================================================================*
InterCom ALL sYmbol.RESet
PRINT "Loading Symbols"
&n=0
WHILE &n<10.
(
   &fname=DIALOG.STRING(LFILE[&n])
   IF "&fname"!=""
   (
      &filetype=OS.FILE.EXTENSION("&fname")

      IF "&filetype"==".elf"
      (
         PRINT "Loading symbols from &fname"
         &dload_flags="/NoClear /NoCode"

         IF DIALOG.BOOLEAN(LSYM0[&n])&&("&ic0"!="")
         (
            &ic0 DATA.LOAD.ELF "&fname" &dload_flags
         )
         IF DIALOG.BOOLEAN(LSYM1[&n])&&("&ic1"!="")
         (
            &ic1 DATA.LOAD.ELF "&fname" &dload_flags
         )
         IF DIALOG.BOOLEAN(LSYM2[&n])&&("&ic2"!="")
         (
            &ic2 DATA.LOAD.ELF "&fname" &dload_flags
         )
         IF DIALOG.BOOLEAN(LSYM3[&n])&&("&ic3"!="")
         (
            &ic3 DATA.LOAD.ELF "&fname" &dload_flags
         )
         IF DIALOG.BOOLEAN(LSYM4[&n])&&("&ic4"!="")
         (
            &ic4 DATA.LOAD.ELF "&fname" &dload_flags
         )
      )
   )

   &n=&n+1
)

PRINT "Complete"
;*===========================================================================
;* Create Source Code Paths
;* USE sYmbol.list.spath to see current paths
;*===========================================================================
&n=0
WHILE &n<2.
(
   &fname=DIALOG.STRING(SPATH[&n])
   IF ("&fname"!="")
   (
      PRINT "Setting Source Code Path to &fname"
      sYmbol.SourcePATH.SetRecurseDir &fname
   )
   &n=&n+1
)

&frompath=DIALOG.STRING(SPATHFROM)
&topath=DIALOG.STRING(SPATHTO)
IF ("&frompath"!=""&&"&topath"!="")
(
      PRINT "Translating Source Code Path from &frompath to &topath"
      InterCom ALL sYmbol.SourcePATH.Translate "&frompath" "&topath"
)

;*===========================================================================
;* Make the searches not case sensitive
;*===========================================================================
sYmbol.CASE OFF

;*===========================================================================
PRINT "Flash script completed at "+CLOCK.TIME()

&clke=CLOCK.SECONDS()
&tsecs=&clke-&clks
&tmin=&tsecs/60.
&tsecs=&tsecs%60.

;*===========================================================================
PRINT "Total flash time was &tmin minutes and &tsecs seconds"

&n=0
WHILE &n<5.
(
   &ic_assign="&"+"ic=""&"+"ic"+FORMAT.Decimal(1,&n)+""""
   &&ic_assign
   &start_core_assign="&"+"start_core=""&"+"start_core"+FORMAT.Decimal(1,&n)+""""
   &&start_core_assign
   IF "&ic"!=""&&"&start_core"!=""
   (
      PRINT "start core: &core_script_path/&start_core"
      &ic DO &core_script_path/&start_core
   )
   &n=&n+1
)

IF ("&post_flash_scripts"!="")
(
   &scripts="&post_flash_scripts "
   WHILE STRing.SCAN("&scripts", " ", 0.)!=-1
   (
      PRIVATE &script
      &script=STRing.Split("&scripts", " ", 0.)

      PRINT "post flash: &core_script_path/&script"
      DO &core_script_path/&script

      &scripts=STRing.Replace("&scripts", "&script ", "", 0.)
   )
)

DO &core_script_path/&cpu/reset

Cancel_Flash:
DIALOG.END

ENDDO
;*===========================================================================
;* End of flashd.cmm script.   Return to calling script.
;*===========================================================================*

;*===========================================================================*
ChkLOAD:
;*===========================================================================*
ENTRY &cur
LOCAL &fname
&fname=DIALOG.STRING(LFILE[&cur])
IF "&fname"==""||(!OS.FILE("&fname"))
(
   IF "&fname"==""||(!OS.FILE(&fname))
   (
      DIALOG.OK "File '&fname' does not exist! Can not set..."
      DIALOG.SET LCODE[&cur] "OFF"
      DIALOG.SET LSYM0[&cur] "OFF"
      DIALOG.SET LSYM1[&cur] "OFF"
      DIALOG.SET LSYM2[&cur] "OFF"
      DIALOG.SET LSYM3[&cur] "OFF"
      DIALOG.SET LSYM4[&cur] "OFF"
   )
)

RETURN

Load_Flash_Session:
LOCAL &element &value
IF OS.FILE("&flash_session")
(
   PRINT "Loading flash session"
   OPEN #1 "&flash_session" /Read
   &path=OS.FILE.PATH("&flash_session")
   &pwd=OS.PresentWorkingDirectory()

   PWD "&path"

   WHILE (0==0)
   (
      READ #1 &element &value

      IF "&element"==""
         GOTO DoneRead
      ELSE IF "&element"=="VERSION"&&"&value"!="&version"
      (
         PRINT %COLOR.RED "Flash session may be incompatible with flash utility version &version"
         PRINT %COLOR.RED "Update &flash_session to version &version"
      )
      ELSE IF "&element"=="PROC"&&"&value"!="&cpu"
      (
         DIALOG.OK "Flash session not valid for &cpu"
         PWD "&pwd"
         CLOSE #1
         RETURN
      )
      ELSE IF "&element"!="VERSION"&&"&element"!="PROC"&&"&element"!=";"
      (
         IF "&value"==""
            DIALOG.SET &element
         ELSE IF (STRing.SCAN("&element","LFILE",0)!=-1)
            DIALOG.SET &element OS.FILE.ABSPATH("&value")
         ELSE
            DIALOG.SET &element "&value"
      )
   )

DoneRead:
   PWD "&pwd"
   CLOSE #1
)

;*===========================================================================
;* If file names specified do not exist, then clear them...
;*===========================================================================
&n=0
WHILE &n<10.
(
   &fname=DIALOG.STRING(LFILE[&n])
   IF "&fname"==""||(!OS.FILE("&fname"))
   (
      &file="&filepath\..\*.elf;*.s19;*.ptp;*.bin;*.hex"
      DIALOG.SET LFILE[&n] ""
      DIALOG.SET LCODE[&n] "OFF"
      DIALOG.SET LSYM0[&n] "OFF"
      DIALOG.SET LSYM1[&n] "OFF"
      DIALOG.SET LSYM2[&n] "OFF"
      DIALOG.SET LSYM3[&n] "OFF"
      DIALOG.SET LSYM4[&n] "OFF"
   )
   &n=&n+1
)
;*===========================================================================
;* If path names specified do not exist, then clear them
;*===========================================================================
&n=0
WHILE &n<2.
(
   &file=DIALOG.STRING(SPATH[&n])
   IF (!OS.DIR("&file"))
   (
      &file="&filepath\..\*.elf;*.s19;*.ptp;*.bin;*.hex"
      DIALOG.SET SPATH[&n] ""
   )
   &n=&n+1
)
PRINT "Flash session loaded"
RETURN

Save_Flash_Session:
LOCAL &value

PRINT "Writing &flash_session"
OPEN #1 "&flash_session" /Create
WRITE #1 "VERSION &version"
WRITE #1 "PROC &cpu"
;*===========================================================================
IF DIALOG.BOOLEAN(PRE_ERASE)
(
   WRITE #1 "PRE_ERASE ON"
)
ELSE
(
   WRITE #1 "PRE_ERASE OFF"
)
;*===========================================================================

;*===========================================================================
&n=0
WHILE &n<10.
(
   &value=DIALOG.STRING(LFILE[&n])
   WRITE #1 "LFILE[&n] &value"
   IF DIALOG.BOOLEAN(LCODE[&n])
   (
      WRITE #1 "LCODE[&n] ON"
   )
   ELSE
   (
      WRITE #1 "LCODE[&n] OFF"
   )

   IF DIALOG.BOOLEAN(LSYM0[&n])
   (
      WRITE #1 "LSYM0[&n] ON"
   )
   ELSE
   (
      WRITE #1 "LSYM0[&n] OFF"
   )

   IF DIALOG.BOOLEAN(LSYM1[&n])
   (
      WRITE #1 "LSYM1[&n] ON"
   )
   ELSE
   (
      WRITE #1 "LSYM1[&n] OFF"
   )

   IF DIALOG.BOOLEAN(LSYM2[&n])
   (
      WRITE #1 "LSYM2[&n] ON"
   )
   ELSE
   (
      WRITE #1 "LSYM2[&n] OFF"
   )

   IF DIALOG.BOOLEAN(LSYM3[&n])
   (
      WRITE #1 "LSYM3[&n] ON"
   )
   ELSE
   (
      WRITE #1 "LSYM3[&n] OFF"
   )

   IF DIALOG.BOOLEAN(LSYM4[&n])
   (
      WRITE #1 "LSYM4[&n] ON"
   )
   ELSE
   (
      WRITE #1 "LSYM4[&n] OFF"
   )

   &n=&n+1
)
&n=0
WHILE &n<2.
(
   &value=DIALOG.STRING(SPATH[&n])
   WRITE #1 "SPATH[&n] &value"

   &n=&n+1
)
&value=DIALOG.STRING(SPATHFROM)
WRITE #1 "SPATHFROM &value"
&value=DIALOG.STRING(SPATHTO)
WRITE #1 "SPATHTO &value"
CLOSE #1
RETURN

CPU_Detect:
&cpu="Unknown Processor"
ON ERROR GOSUB
(
   DIALOG.MESSAGE "Connect to a powered target and press OK"
   SYSTEM.DETECT IDCODE
   RETURN
)
SYSTEM.DETECT IDCODE
ON ERROR inherit

IF IDCODE(0)==0x854402B
(
   &cpu="SAF85xx"
)
ELSE IF IDCODE(0)==0x1BB7B02F
(
   &cpu="AWR294x"
)
RETURN
