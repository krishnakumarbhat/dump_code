GLOBAL &cpu
GLOBAL &cname0 &cname1 &cname2 &cname3 &cname4
GLOBAL &start_core0 &start_core1 &start_core2 &start_core3 &start_core4
GLOBAL &pre_flash_scripts &post_flash_scripts
GLOBAL &default_flash_session &auto_flash_session

LOCAL &flash_session &input_flash_session &last_flash_session &auto_flash
ENTRY &input_flash_session

IF VERSION.BUILD()<154087.
(
   DIALOG.OK "Trace32 version update required"
   ENDDO
)

LOCAL &version
&version="2.2"

LOCAL &ic0 &ic1 &ic2 &ic3 &ic4
&n=0
WHILE &n<5.
(
   &core_assign="&"+"core=""&cname"+FORMAT.Decimal(1,&n)+""""
   &&core_assign
   IF "&core"!=""
   (
      IF InterCom.PING(&core)
      (
         &ic_assign="&"+"ic"+FORMAT.Decimal(1,&n)+"=""InterCom &core"""
         &&ic_assign
      )
   )
   &n=&n+1
)

IF "&cpu"==""
(
   GOSUB CPU_Detect
)

IF ("&cpu"=="SAF85xx")&&(VERSION.BUILD()<154087.)
(
   DIALOG.OK "Trace32 version update required"
   ENDDO
)

;* Fall back to local default_flash_session.ini if one was not configured
IF (!OS.FILE("&default_flash_session"))&&(OS.FILE("default_flash_session.ini"))
(
   &default_flash_session="default_flash_session.ini"
)

;*===========================================================================
;* Check if the last or input flash session file exists
;* If it does not then the default flash session is used
;*===========================================================================
&auto_flash=FALSE()
&last_flash_session=OS.FILE.JOINPATH("&core_script_path","last_flash_session.ini")
IF OS.FILE("&input_flash_session")
(
   &flash_session="&input_flash_session"
   &auto_flash=TRUE()
)
ELSE IF OS.FILE("&auto_flash_session")
(
   &flash_session="&auto_flash_session"
   &auto_flash=TRUE()
)
ELSE IF OS.FILE("&last_flash_session")
(
   &flash_session="&last_flash_session"
)
ELSE
(
   &flash_session="&default_flash_session"
)

;*===========================================================================
;* create and display dialog box
;*===========================================================================
LOCAL &clks
WINPOS 15% 10% 120. 21.

DIALOG
(&+
   HEADER "Core Radar Flash Utility for &cpu - Version &version"
   ICON "[=5VTfYD0T0xEl$3$$n$$KMyhR0]"
   CLOSE "jumpto Cancel_Flash"

   POS 0. 0. 120. 21.
   BOX "Flash Session"

;*===========================================================================
   POS 1. 1. 20. 1.
   BUTTON "Load Flash Session..."
   (
      DIALOG.File *.ini
      ENTRY %LINE &file
      IF "&file"==""
      (
         &file="&filepath\..\"
      )
      &flash_session="&file"
      GOSUB Load_Flash_Session
   )
;*===========================================================================
   POS 21. 1. 20. 1.
   BUTTON "Save Flash Session..."
   (
      DIALOG.File *.ini
      ENTRY %LINE &file
      IF "&file"==""
      (
         &file="&filepath\..\"
      )
      &flash_session="&file"
      GOSUB Save_Flash_Session
   )
;*===========================================================================
   POS 41. 1. 20. 1.
   BUTTON "Load Default Flash Session"
   (
      &flash_session="&default_flash_session"
      GOSUB Load_Flash_Session
   )
;*===========================================================================
;* Options
;*===========================================================================
   POS 65. 1. 36. 1.
   PRE_ERASE: CHECKBOX "Erase all memory before flashing" ""
;*===========================================================================
;* file updates
;*===========================================================================
   POS 0. 2. 6.
   LINE "Code"
;*===========================================================================
   POS 5. 2. 20.
   LINE "Symbol"
;*===========================================================================
   POS 24. 2. 96.
