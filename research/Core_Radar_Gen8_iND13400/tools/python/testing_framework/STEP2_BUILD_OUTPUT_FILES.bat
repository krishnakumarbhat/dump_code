@echo off
setlocal EnableDelayedExpansion

:: ============================================================================
::  Gen8 iND13400 - Build & Test Launcher
::  Navigates to repo root and executes bazelisk commands.
::  NOTE: Launches via Git Bash to avoid Windows 32K command-line limit.
:: ============================================================================

:: Navigate to repo root (three levels up from tools\python\testing_framework)
pushd "%~dp0..\..\..\"
set "REPO_ROOT=%CD%"
set "SCRIPT_DIR=%~dp0"
echo.
echo  Repo Root: %REPO_ROOT%
echo.

:: Enable long paths in Git to avoid "Filename too long" errors on Windows
git config --global core.longpaths true >nul 2>&1

:: Convert Windows repo path to WSL/Linux path format
set "REPO_UNIX=%REPO_ROOT:\=/%"
set "REPO_UNIX=/%REPO_UNIX::=%"
set "SCRIPT_UNIX=%SCRIPT_DIR:\=/%"
set "SCRIPT_UNIX=/%SCRIPT_UNIX::=%"

:: --- Priority 1: Try WSL2 (real Linux - no 32K limit, guaranteed success) ---
where wsl >nul 2>&1 && (
    wsl -e bash -c "echo ok" >nul 2>&1 && (
        echo  [INFO] WSL2 detected - launching build via Linux ^(no 32K limit^)
        echo.
        :: Copy Windows .netrc to WSL home for JFrog/Bazel authentication
        wsl -e bash -c "if [ -f /mnt/c/Users/%USERNAME%/.netrc ] && [ ! -f ~/.netrc ]; then cp /mnt/c/Users/%USERNAME%/.netrc ~/.netrc; chmod 600 ~/.netrc; echo '  [INFO] Copied .netrc credentials to WSL home'; fi"
        :: Resolve WSL paths first (avoid nested quotes/parens in the bash -c string below)
        for /f "usebackq delims=" %%W in (`wsl wslpath -a "%REPO_ROOT%"`) do set "REPO_WSL=%%W"
        for /f "usebackq delims=" %%W in (`wsl wslpath -a "%SCRIPT_DIR%STEP2_BUILD_OUTPUT_FILES.sh"`) do set "SCRIPT_WSL=%%W"
        wsl -e bash -c "cd '!REPO_WSL!' && bash '!SCRIPT_WSL!'"
        goto END
    )
)

:: --- Priority 2: Try Git Bash ---
set "GIT_BASH="
where bash >nul 2>&1 && set "GIT_BASH=bash"
if not defined GIT_BASH (
    for /f "tokens=*" %%i in ('where git 2^>nul') do (
        set "GIT_PATH=%%~dpi"
        if exist "!GIT_PATH!..\bin\bash.exe" set "GIT_BASH=!GIT_PATH!..\bin\bash.exe"
        if exist "!GIT_PATH!..\usr\bin\bash.exe" set "GIT_BASH=!GIT_PATH!..\usr\bin\bash.exe"
    )
)

if defined GIT_BASH (
    echo  [INFO] Launching build menu via Git Bash...
    echo  [INFO] Using: !GIT_BASH!
    echo.
    "!GIT_BASH!" --login -i "%SCRIPT_DIR%STEP2_BUILD_OUTPUT_FILES.sh"
    goto END
)

:: --- Priority 3: Fallback to native CMD (may hit 32K limit) ---
echo  ========================================================================
echo   [WARNING] Neither WSL2 nor Git Bash found! Running in native CMD mode.
echo   The BBE32 build may fail due to Windows 32K command-line limit.
echo   Install WSL2 (recommended) or Git for Windows to fix this.
echo  ========================================================================
echo.

:: Use shortest possible output_base to mitigate Windows 32K command-line limit.
set "BZL=bazelisk.exe --output_base=C:/b"

:: --- Auto-generate user.bazelrc if not present ---
if not exist "%REPO_ROOT%\user.bazelrc" (
    echo  [INFO] Creating Windows user.bazelrc ^(short paths + disk cache^)...
    (
        echo # =============================================================================
        echo # Windows local user.bazelrc ^(auto-generated by STEP2_BUILD_OUTPUT_FILES.bat^)
        echo # =============================================================================
        echo.
        echo # Short output base to avoid Windows long path failures ^(32K limit^)
        echo startup --output_base=C:/bzl
        echo.
        echo # Use 80%% of CPU cores for parallel builds
        echo common --jobs=HOST_CPUS*.8
        echo.
        echo # Only download top-level build outputs, not all intermediates
        echo build --remote_download_toplevel
        echo.
        echo # Skip stamping for dev builds ^(prevents cache invalidation on every commit^)
        echo build --nostamp
        echo.
        echo # Disable Build Event Service for local dev ^(saves network I/O^)
        echo build --bes_backend=
        echo build --bes_results_url=
        echo.
        echo # Local disk cache for faster rebuilds
        echo build --disk_cache=C:/bzl_cache
        echo.
        echo # Use available RAM efficiently
        echo build --local_resources=memory=HOST_RAM*.8
        echo.
        echo build --experimental_guard_against_concurrent_changes=false
        echo.
        echo # Use param files to avoid Windows 32K command-line limit ^(for xt-clang/BBE32^)
        echo build:windows --features=compiler_param_file
        echo.
        echo # Short temp dir for unit tests ^(avoids long path issues^)
        echo test:windows --@bazel_platform//quality/ut:tmp_dir=C:/tmp
    ) > "%REPO_ROOT%\user.bazelrc"
    echo  [INFO] user.bazelrc created successfully.
) else (
    echo  [INFO] Existing user.bazelrc found - keeping it.
)

:: Initialize last command tracking
set "LAST_CMD="
set "LAST_CMD_LABEL="

:: ============================================================================
::  MAIN MENU
:: ============================================================================
:MAIN_MENU
echo ============================================================================
echo   Gen8 iND13400 - Build and Test Menu
echo ============================================================================
echo.
echo   --- Clean ---
echo    1)  Bazel Clean
echo    2)  Bazel Clean --expunge  (full deep clean)
echo.
echo   --- Satellite-CAN Builds (Default) ---
echo    3)  FLR8  Satellite-CAN
echo    4)  SRR8P Satellite-CAN
echo.
echo   --- Satellite-SomeIP Builds ---
echo    5)  FLR8  Satellite-SomeIP
echo    6)  SRR8P Satellite-SomeIP
echo.
echo   --- Standalone Builds ---
echo    7)  FLR8  Standalone
echo    8)  SRR8P Standalone
echo.
echo   --- Ashok Leyland (AL) Build ---
echo    9)  SRR8P AL-CAN              (CAN + tracker)
echo.
echo   --- Unit Tests ---
echo   10)  Run ALL Unit Tests
echo   11)  Run BBE-specific Unit Tests
echo.
echo   --- Coverage ---
echo   12)  Generate Full Coverage Report
echo.
echo   --- Coverity Static Analysis ---
echo   13)  Coverity R52  (FLR8)
echo   14)  Coverity R52  (SRR8P)
echo   15)  Coverity BBE32 (FLR8)
echo   16)  Coverity BBE32 (SRR8P)
echo.
echo   --- Compile Database ---
echo   17)  Generate compile_commands.json
echo.
echo   --- Advanced / Custom Build ---
echo   18)  Custom Build with Optional Debug Flags
echo.
echo    0)  Exit
echo ============================================================================
echo.
set "choice="
set /p "choice=Select an option [0-18]: "

if "%choice%"=="0"  goto EXIT
if "%choice%"=="1"  goto CLEAN
if "%choice%"=="2"  goto EXPUNGE
if "%choice%"=="3"  goto FLR8_CAN
if "%choice%"=="4"  goto SRR8P_CAN
if "%choice%"=="5"  goto FLR8_SOMEIP
if "%choice%"=="6"  goto SRR8P_SOMEIP
if "%choice%"=="7"  goto FLR8_STANDALONE
if "%choice%"=="8"  goto SRR8P_STANDALONE
if "%choice%"=="9"  goto SRR8P_AL_CAN
if "%choice%"=="10" goto TEST_ALL
if "%choice%"=="11" goto TEST_BBE
if "%choice%"=="12" goto COVERAGE
if "%choice%"=="13" goto COV_R52_FLR8
if "%choice%"=="14" goto COV_R52_SRR8P
if "%choice%"=="15" goto COV_BBE_FLR8
if "%choice%"=="16" goto COV_BBE_SRR8P
if "%choice%"=="17" goto COMPILEDB
if "%choice%"=="18" goto CUSTOM_BUILD
echo.
echo  [ERROR] Invalid selection: "%choice%"
echo.
goto MAIN_MENU

:: ============================================================================
::  CLEAN
:: ============================================================================
:CLEAN
echo.
echo  [CLEAN] Running bazelisk clean ...
!BZL! clean
echo  [CLEAN] Done.
goto DONE

:EXPUNGE
echo.
echo  [EXPUNGE] Running bazelisk clean --expunge ...
!BZL! clean --expunge
echo  [EXPUNGE] Done. All cached build outputs removed.
goto DONE

:: ============================================================================
::  SATELLITE-CAN BUILDS (Default)
:: ============================================================================
:FLR8_CAN
call :COLLECT_OPTIONAL_FLAGS
set "LAST_CMD=!BZL! build //:gen8 --config=flr8 !EXTRA_FLAGS!"
set "LAST_CMD_LABEL=Satellite-CAN FLR8"
echo.
echo  [BUILD] Satellite-CAN FLR8
echo  Command: !LAST_CMD!
!LAST_CMD!
goto BUILD_DONE

:SRR8P_CAN
call :COLLECT_OPTIONAL_FLAGS
set "LAST_CMD=!BZL! build //:gen8 --config=srr8p !EXTRA_FLAGS!"
set "LAST_CMD_LABEL=Satellite-CAN SRR8P"
echo.
echo  [BUILD] Satellite-CAN SRR8P
echo  Command: !LAST_CMD!
!LAST_CMD!
goto BUILD_DONE

:: ============================================================================
::  SATELLITE-SOMEIP BUILDS
:: ============================================================================
:FLR8_SOMEIP
call :COLLECT_OPTIONAL_FLAGS
set "LAST_CMD=!BZL! build //:gen8 --config=flr8 --veh_com=someip !EXTRA_FLAGS!"
set "LAST_CMD_LABEL=Satellite-SomeIP FLR8"
echo.
echo  [BUILD] Satellite-SomeIP FLR8
echo  Command: !LAST_CMD!
!LAST_CMD!
goto BUILD_DONE

:SRR8P_SOMEIP
call :COLLECT_OPTIONAL_FLAGS
set "LAST_CMD=!BZL! build //:gen8 --config=srr8p --veh_com=someip !EXTRA_FLAGS!"
set "LAST_CMD_LABEL=Satellite-SomeIP SRR8P"
echo.
echo  [BUILD] Satellite-SomeIP SRR8P
echo  Command: !LAST_CMD!
!LAST_CMD!
goto BUILD_DONE

:: ============================================================================
::  STANDALONE BUILDS
:: ============================================================================
:FLR8_STANDALONE
call :COLLECT_OPTIONAL_FLAGS
set "LAST_CMD=!BZL! build //:gen8 --config=flr8 --veh_com=none --tracker_variant=platform_flr8_standalone !EXTRA_FLAGS!"
set "LAST_CMD_LABEL=Standalone-FLR8"
echo.
echo  [BUILD] Standalone-FLR8
echo  Command: !LAST_CMD!
!LAST_CMD!
goto BUILD_DONE

:SRR8P_STANDALONE
call :COLLECT_OPTIONAL_FLAGS
set "LAST_CMD=!BZL! build //:gen8 --config=srr8p --veh_com=none --tracker_variant=platform_srr8p_standalone !EXTRA_FLAGS!"
set "LAST_CMD_LABEL=Standalone-SRR8P"
echo.
echo  [BUILD] Standalone-SRR8P
echo  Command: !LAST_CMD!
!LAST_CMD!
goto BUILD_DONE

:SRR8P_AL_CAN
call :COLLECT_OPTIONAL_FLAGS
set "LAST_CMD=!BZL! build //:gen8 --config=srr8p --veh_com=al_can_standalone --tracker_variant=AL --enable_features=true !EXTRA_FLAGS!"
set "LAST_CMD_LABEL=AL-SRR8P"
echo.
echo  [BUILD] AL-SRR8P (Ashok Leyland CAN + Tracker)
echo  Command: !LAST_CMD!
!LAST_CMD!
goto BUILD_DONE

:: ============================================================================
::  UNIT TESTS
:: ============================================================================
:TEST_ALL
echo.
echo  [TEST] Running ALL unit tests ...
echo  Command: !BZL! test //:all_unit_tests --test_output=all
!BZL! test //:all_unit_tests --test_output=all
goto DONE

:TEST_BBE
echo.
echo  [TEST] Running BBE-specific unit tests ...
echo  Command: !BZL! test //:tests_bbe --test_output=all
!BZL! test //:tests_bbe --test_output=all
goto DONE

:: ============================================================================
::  COVERAGE
:: ============================================================================
:COVERAGE
echo.
echo  [COVERAGE] Generating full coverage report ...
echo  Command: !BZL! test //coverage:report
!BZL! test //coverage:report
goto DONE

:: ============================================================================
::  COVERITY STATIC ANALYSIS
:: ============================================================================
:COV_R52_FLR8
echo.
echo  [COVERITY] R52 analysis - FLR8
echo  Command: !BZL! build //software/r52:windriver_r52_cov --config=flr8
!BZL! build //software/r52:windriver_r52_cov --config=flr8
goto DONE

:COV_R52_SRR8P
echo.
echo  [COVERITY] R52 analysis - SRR8P
echo  Command: !BZL! build //software/r52:windriver_r52_cov --config=srr8p
!BZL! build //software/r52:windriver_r52_cov --config=srr8p
goto DONE

:COV_BBE_FLR8
echo.
echo  [COVERITY] BBE32 analysis - FLR8
echo  Command: !BZL! build //software/bbe32:xtensa_bbe32_cov --config=flr8
!BZL! build //software/bbe32:xtensa_bbe32_cov --config=flr8
goto DONE

:COV_BBE_SRR8P
echo.
echo  [COVERITY] BBE32 analysis - SRR8P
echo  Command: !BZL! build //software/bbe32:xtensa_bbe32_cov --config=srr8p
!BZL! build //software/bbe32:xtensa_bbe32_cov --config=srr8p
goto DONE

:: ============================================================================
::  COMPILE DATABASE
:: ============================================================================
:COMPILEDB
echo.
echo  [COMPILEDB] Generating compile_commands.json ...
echo  Command: !BZL! run //:compiledb
!BZL! run //:compiledb
goto DONE

:: ============================================================================
::  CUSTOM BUILD  - Pick variant + any combination of debug flags
:: ============================================================================
:CUSTOM_BUILD
echo.
echo  ====== Custom Build Configuration ======
echo.

:: --- Step 1: Pick config variant ---
echo  Select platform config:
echo    1) FLR8
echo    2) SRR8P
set /p "cfg_choice=  Config [1-2]: "
if "%cfg_choice%"=="1" ( set "CONFIG=--config=flr8" ) else if "%cfg_choice%"=="2" ( set "CONFIG=--config=srr8p" ) else (
    echo  [ERROR] Invalid config. & goto DONE
)
echo.

:: --- Step 2: Pick vehicle communication ---
echo  Select vehicle communication variant:
echo    1) CAN        (default)
echo    2) SomeIP     (Ethernet high-det)
echo    3) None       (standalone / tracker)
echo    4) AL CAN Standalone  (SRR8P only)
set /p "veh_choice=  VehCom [1-4]: "
set "VEH_COM="
if "%veh_choice%"=="1" ( set "VEH_COM=--veh_com=can" )
if "%veh_choice%"=="2" ( set "VEH_COM=--veh_com=someip" )
if "%veh_choice%"=="3" ( set "VEH_COM=--veh_com=none" )
if "%veh_choice%"=="4" ( set "VEH_COM=--veh_com=al_can_standalone" )
echo.

:: --- Step 3: Tracker variant (only relevant when veh_com=none or al_can_standalone) ---
set "TRACKER="
if "%veh_choice%"=="3" (
    echo  Select tracker variant:
    echo    1) platform_flr8_standalone
    echo    2) platform_srr8p_standalone
    echo    3) platform_srr8p_2_sensor_fusion
    echo    4) disabled
    echo    5) partner_sensor
    echo    6) Skip ^(none^)
    set /p "trk_choice=  Tracker [1-6]: "
    if "!trk_choice!"=="1" set "TRACKER=--tracker_variant=platform_flr8_standalone"
    if "!trk_choice!"=="2" set "TRACKER=--tracker_variant=platform_srr8p_standalone"
    if "!trk_choice!"=="3" set "TRACKER=--tracker_variant=platform_srr8p_2_sensor_fusion"
    if "!trk_choice!"=="4" set "TRACKER=--tracker_variant=disabled"
    if "!trk_choice!"=="5" set "TRACKER=--tracker_variant=partner_sensor"
    echo.
)
if "%veh_choice%"=="4" (
    set "TRACKER=--tracker_variant=AL --enable_features=true"
)

:: --- Step 4: Board and MARS revision ---
echo  Board version [EDU/A0/B0/A2P4] (default=B0, press Enter to skip):
set "BOARD_VER="
set /p "BOARD_VER=  Board: "
if not "%BOARD_VER%"=="" ( set "BOARD_FLAG=--chandra_hw_rev=%BOARD_VER%" ) else ( set "BOARD_FLAG=" )

echo  MARS HW revision [A0/B0] (default=B0, press Enter to skip):
set "MARS_VER="
set /p "MARS_VER=  Mars HW Rev: "
if not "%MARS_VER%"=="" ( set "MARS_FLAG=--mars_hw_rev=%MARS_VER%" ) else ( set "MARS_FLAG=" )
echo.

:: --- Step 5: BBE ASIC/FPGA ---
echo  BBE config [asic/fpga] (default=asic, press Enter to skip):
set "BBE_CFG="
set /p "BBE_CFG=  BBE ASIC/FPGA: "
if not "%BBE_CFG%"=="" ( set "BBE_FLAG=--bbe_asic_fpga=%BBE_CFG%" ) else ( set "BBE_FLAG=" )
echo.

:: --- Step 6: Optional debug flags (Y/N toggles) ---
echo  ====== Optional Debug / Feature Flags (Y to enable, Enter to skip) ======
echo.

set "DBG_FLAGS="

echo  --- Logging and Profiling ---
set /p "f1=  Enable ADC Logging?                [Y/N]: "
if /i "%f1%"=="Y" set "DBG_FLAGS=!DBG_FLAGS! --enable_adc_logging=True"

set /p "f2=  Enable CDC Logging?                [Y/N]: "
if /i "%f2%"=="Y" set "DBG_FLAGS=!DBG_FLAGS! --enable_cdc=True"

set /p "f3=  Enable Chirp Profiling?            [Y/N]: "
if /i "%f3%"=="Y" set "DBG_FLAGS=!DBG_FLAGS! --enable_chirp_profiling=True"

set /p "f4=  Enable UART?                       [Y/N]: "
if /i "%f4%"=="Y" set "DBG_FLAGS=!DBG_FLAGS! --enable_uart=True"

set /p "f5=  Enable Stream Re-generation?       [Y/N]: "
if /i "%f5%"=="Y" set "DBG_FLAGS=!DBG_FLAGS! --enable_stream_generation=True"

echo.
echo  --- Safety / Monitor Disable ---
set /p "f6=  Disable Stack Monitor (R52)?       [Y/N]: "
if /i "%f6%"=="Y" set "DBG_FLAGS=!DBG_FLAGS! --disable_stack_monitor_r52=true"

set /p "f7=  Disable Program Flow Monitor?      [Y/N]: "
if /i "%f7%"=="Y" set "DBG_FLAGS=!DBG_FLAGS! --disable_pfm=true"

set /p "f8=  Disable Internal Watchdog?         [Y/N]: "
if /i "%f8%"=="Y" set "DBG_FLAGS=!DBG_FLAGS! --disable_int_wdg=true"

set /p "f9=  Disable Static Register Safety?    [Y/N]: "
if /i "%f9%"=="Y" set "DBG_FLAGS=!DBG_FLAGS! --static_register_safety_enabled=false"

set /p "f9a= Stub Tracker (disable tracker logic)? [Y/N]: "
if /i "%f9a%"=="Y" set "DBG_FLAGS=!DBG_FLAGS! --stub_tracker=true"

echo.
echo  --- Test Patterns / Injection ---
set /p "f10= Enable Test Pattern Gen?           [Y/N]: "
if /i "%f10%"=="Y" set "DBG_FLAGS=!DBG_FLAGS! --config=use_test_pattern_gen"

set /p "f11= Enable MARS Test Pattern?          [Y/N]: "
if /i "%f11%"=="Y" set "DBG_FLAGS=!DBG_FLAGS! --config=configure_MARS_test_pattern"

set /p "f11a=Enable MARS ADC Test?              [Y/N]: "
if /i "%f11a%"=="Y" set "DBG_FLAGS=!DBG_FLAGS! --config=enable_mars_adc_test"

set /p "f12= Enable RESI Mode?                  [Y/N]: "
if /i "%f12%"=="Y" set "DBG_FLAGS=!DBG_FLAGS! --config=configure_RESI_MODE"

echo.
echo  --- Testing Frameworks ---
set /p "f13= Enable Integration Testing (SWE5)? [Y/N]: "
if /i "%f13%"=="Y" (
    set "DBG_FLAGS=!DBG_FLAGS! --Integration_Testing=true"
    set /p "f13a= Enable Anglefinding IT?        [Y/N]: "
    if /i "!f13a!"=="Y" set "DBG_FLAGS=!DBG_FLAGS! --Anglefinding_IT=true"
)

set /p "f14= Enable SQT Test Cases?             [Y/N]: "
if /i "%f14%"=="Y" set "DBG_FLAGS=!DBG_FLAGS! --enable_sqt_testcases=true"

set /p "f15= Enable SIT Test Cases?             [Y/N]: "
if /i "%f15%"=="Y" set "DBG_FLAGS=!DBG_FLAGS! --enable_sit_testcases=true"

set /p "f15a=Disable XCP Fault Injection Tests? [Y/N]: "
if /i "%f15a%"=="Y" set "DBG_FLAGS=!DBG_FLAGS! --enable_XCP_FAULT_INJECTION_testcases=false"

set /p "f16= Enable Bench Testing?              [Y/N]: "
if /i "%f16%"=="Y" set "DBG_FLAGS=!DBG_FLAGS! --enable_bench_testing=true"

set /p "f17= Enable MCAL Test?                  [Y/N]: "
if /i "%f17%"=="Y" set "DBG_FLAGS=!DBG_FLAGS! --enable_mcal_test=true"

echo.
echo  --- NVM / SIL / Alignment ---
set /p "f18= Enable Alignment NVM Test?         [Y/N]: "
if /i "%f18%"=="Y" set "DBG_FLAGS=!DBG_FLAGS! --alignment_nvm_test=true"

set /p "f19= Enable PSP SIL Config?             [Y/N]: "
if /i "%f19%"=="Y" set "DBG_FLAGS=!DBG_FLAGS! --psp_sil_config=True"

echo.
echo  --- Cache ---
set /p "f20= Bypass Remote Cache?               [Y/N]: "
if /i "%f20%"=="Y" set "DBG_FLAGS=!DBG_FLAGS! --noremote_accept_cached"

echo.

:: --- Step 7: Any extra raw flags ---
echo  Enter any additional raw bazelisk flags (press Enter to skip):
set "RAW_FLAGS="
set /p "RAW_FLAGS=  Extra flags: "
echo.

:: --- Assemble and execute ---
set "FULL_CMD=!BZL! build //:gen8 !CONFIG! !VEH_COM! !TRACKER! !BOARD_FLAG! !MARS_FLAG! !BBE_FLAG! !ROT_FLAG! !DBG_FLAGS! !RAW_FLAGS!"
set "LAST_CMD=!FULL_CMD!"
set "LAST_CMD_LABEL=Custom Build (!CONFIG!)"
echo  ========================================
echo  [CUSTOM BUILD] Executing:
echo  !FULL_CMD!
echo  ========================================
echo.
!FULL_CMD!
goto BUILD_DONE

:: ============================================================================
::  SUBROUTINE: Collect optional flags for standard build menu items
:: ============================================================================
:COLLECT_OPTIONAL_FLAGS
set "EXTRA_FLAGS="
echo.
echo  Add optional flags? (Enter to skip, or type flags)
echo    Examples: --enable_adc_logging=True --enable_cdc=True --noremote_accept_cached
set /p "EXTRA_FLAGS=  Optional flags: "
goto :eof

:: ============================================================================
::  END SECTIONS
:: ============================================================================
:BUILD_DONE
echo.
if %ERRORLEVEL% EQU 0 (
    echo  [SUCCESS] Build completed successfully.
) else (
    echo  [FAILED] Build failed with error code: %ERRORLEVEL%
)
goto POST_BUILD

:POST_BUILD
echo.
echo  ========================================
echo   What would you like to do next?
echo  ========================================
if not defined LAST_CMD goto :POST_BUILD_NO_RETRY
echo    R)  Retry last build: !LAST_CMD_LABEL!
echo    V)  Retry with --verbose_failures
:POST_BUILD_NO_RETRY
echo    M)  Back to Main Menu
echo    0)  Exit
echo  ========================================
set "post_choice="
set /p "post_choice=  Select [R/V/M/0]: "
if /i "!post_choice!"=="R" goto RETRY_LAST
if /i "!post_choice!"=="V" goto RETRY_VERBOSE
if /i "!post_choice!"=="M" goto MAIN_MENU
if "!post_choice!"=="0" goto EXIT
echo  [ERROR] Invalid selection.
goto POST_BUILD

:RETRY_LAST
if not defined LAST_CMD (
    echo  [ERROR] No previous command to retry.
    goto POST_BUILD
)
echo.
echo  [RETRY] !LAST_CMD_LABEL!
echo  Command: !LAST_CMD!
!LAST_CMD!
goto BUILD_DONE

:RETRY_VERBOSE
if not defined LAST_CMD (
    echo  [ERROR] No previous command to retry.
    goto POST_BUILD
)
echo.
echo  [RETRY+VERBOSE] !LAST_CMD_LABEL!
echo  Command: !LAST_CMD! --verbose_failures
!LAST_CMD! --verbose_failures
goto BUILD_DONE

:DONE
echo.
echo  ========================================
goto POST_BUILD

:EXIT
popd
endlocal
goto END

:END
pause
