/*--------------------------------------------------------------------------------------------------------*/

/*--------------------------------------------------------------------------------------------------------*/
/*  function:  Send_XCP_Connect_Request                                                                   */
/*  description: fills the value to be sent on the CAN for connect request                                */
/*--------------------------------------------------------------------------------------------------------*/
on key '1'
{

  if(xcp_VCAN_f == 0)
  {
  XCP_Command.ID = 0x10;
  cmdID = 0x10;
  }

}

on key '2'
{

  if(xcp_VCAN_f == 0)
  {
  XCP_Command.ID = 0x28;
  cmdID = 0x28;
  }

}


on key '3'
{
  if(xcp_VCAN_f == 0)
  {
  XCP_Command.ID = 0x30;
  cmdID = 0x30;
  }
}

on key '4'
{
  if(xcp_VCAN_f == 0)
  {
  XCP_Command.ID = 0x20;
  cmdID = 0x20;
  }
}

on key '5'
{
  if(xcp_VCAN_f == 0)
  {
  XCP_Command.ID = 0x18;
  cmdID = 0x18;
  }

}

/*--------------------------------------------------------------------------------------------------------*/
/*  function:  Send_XCP_Connect_Request                                                                   */
/*  description: fills the value to be sent on the CAN for connect request                                */
/*--------------------------------------------------------------------------------------------------------*/
on key 'S'
{
  sector_no =0x00;
  erase_cmd =0xD1;
  program_cmd = 0xD0;
  snprintf(Download_Filename,80,"smc_cal.ptp");
}

on key 's'
{
  sector_no =0x00;
  erase_cmd =0xD1;
  program_cmd = 0xD0;
  snprintf(Download_Filename,80,"smc_cal.ptp");

}

/*--------------------------------------------------------------------------------------------------------*/
/*  function:  Send_XCP_Connect_Request                                                                   */
/*  description: fills the value to be sent on the CAN for connect request                                */
/*--------------------------------------------------------------------------------------------------------*/
on key 'U'
{
  sector_no =0x01;
  erase_cmd =0xD1;
  program_cmd = 0xD0;
 // set_mode =  0x04;
  snprintf(Download_Filename,80,"usc_cal.ptp");
}

on key 'u'
{
  sector_no =0x01;
  erase_cmd =0xD1;
  program_cmd = 0xD0;
 // set_mode =  0x04;
  snprintf(Download_Filename,80,"usc_cal.ptp");

}

/*--------------------------------------------------------------------------------------------------------*/
/*  function:  Send_XCP_Connect_Request                                                                   */
/*  description: fills the value to be sent on the CAN for connect request                                */
/*--------------------------------------------------------------------------------------------------------*/
on key 'a'
{
  nextflag =0;
  flash_count =0;
  Download_PTP_File();
}


on key 'A'
{
  nextflag =0;
  flash_count =0;
  Download_PTP_File();

}

/*--------------------------------------------------------------------------------------------------------*/
/*  function:  Send_XCP_Connect_Request                                                                   */
/*  description: fills the value to be sent on the CAN for connect request                                */
/*--------------------------------------------------------------------------------------------------------*/
on message 0x29, 0x11, 0x31, 0x21, 0x19
{
    if (this.byte(0) == 0xFF)
      {
          //write("nextflag = %d", nextflag);
        if(1)
          {
              switch (next_cmd)
                  {
                    case XCP_PCAN_DISABLE:
                    {
                        Send_XCP_PCAN_Disable_Request();
                     // write("Disable PCAN");
                        break;
                    }
                    case XCP_GET_SECTOR_START_ADDRESS:
                    {
                        Send_XCP_Get_Sector_Start_Address();
                     // write("Disable PCAN");
                        break;
                    }
                case XCP_GET_SECTOR_LENGTH_INFO :
                    {
                        usc_smc_add_3 = this.byte(4);
                        usc_smc_add_2 = this.byte(5);
                        usc_smc_add_1 = this.byte(6);
                        usc_smc_add_0 = this.byte(7);
                        Send_XCP_Get_Sector_Length_Info();
                     // write("Disable PCAN");
                        break;
                    }
                    case XCP_SET_MTA_TO_CLEAR:
                    {
                        usc_smc_len_3 = this.byte(4);
                        usc_smc_len_2 = this.byte(5);
                        usc_smc_len_1 = this.byte(6);
                        usc_smc_len_0 = this.byte(7);
                        Set_MTA_Address_To_Clear();
                        break;
                    }
                    case XCP_PROGRAM_START:
                    {
                       Send_XCP_Program_Start_Request();
                       // setTimer(stopforerasetocomplete, 500);
                      //write("usc clr cmplete");

                        break;
                    }

                    case XCP_PROGRAM_CLEAR_USC_AREA:
                    {

                        Send_XCP_Program_Clear_USC_Area();
                      //write("clr usc");
                        break;
                    }

                    case PROGRAM:
                    {
                       program_command();
                       SetTimer(delay, 5000); //Timer initialization, set to be 5000ms
                       break;
                    }
                    /*case PROGRAMNEXT:
                    {
                       program_next_command();
                       break;
                    }
                   */
                    case XCP_RESET_ECU:
                    {
                        Send_XCP_Reset_ECU();
                        break;
                    }
                    default:
                    {
                        //nothing
                        break;
                    }
                }
              }
              else
              {
              write("Stopped: Negative Response received ");
              }
      }
      else
        {
              write("Stopped: Negative Response received ");
        }
}

on key *
{
  write("\n Enter valid input" );
}

on timer delay
{

}
