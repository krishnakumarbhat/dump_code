  /*Minumum lenth of Ethernt frame is 60 bytes,
  Therefore XCP frame is of 18 bytes*/
  byte XCP_Req[12]; /*XCP Request Frame(Header + Payload) */
  byte XCP_Expected_Response[12];
  byte RxBuffer[1500];


   dword page;
  /*usc_smc_ variables */
  /* Download file names */
  char Download_Filename[80]="smc_cal.ptp";
  /* Static Vars for reading ptp file */
  dword File_Handle;
  dword dupl_Remaining_bytes;
  dword no_of_times_992=0;
  dword Remaining_bytes;
  char PTP_Line[256];
  Dword BufferCount;
  dword Download_Block_Index=0;
  Dword dex, idx, rate;
  dword Buffer_Index;
  dword x=0;
  long ptp_addr = 0x3D0000,ptp_start_addr = 0;
  const dword MAX_PTP_BLOCK_SIZE = 0x3F0000;
  byte Download_Block_Buffer[MAX_PTP_BLOCK_SIZE];
  byte Ptp_Char_Index;
  dword total_no_of_remaining_bytes;
  dword byte_of_992_chunk;

  /*ethernet Packet*/
  ethernetPacket pkt;
  dword GlobalDataIndex=0;
  byte usc_smc_add_3;
  byte usc_smc_add_2;
  byte usc_smc_add_1;
  byte usc_smc_add_0;
  byte usc_smc_len_3;
  byte usc_smc_len_2;
  byte usc_smc_len_1;
  byte usc_smc_len_0;
  byte sector_no =0;
  enum NextCommand
    {
