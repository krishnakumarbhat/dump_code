        RtmCan_Measurements[12].MeasurementCount_current = @sysvar::XCP::Rtm::Rtm_Results_12_::count;
        RtmCan_Measurements[12].MeasurementTime_current = @sysvar::XCP::Rtm::Rtm_Results_12_::time;

        if ( (RtmCan_Measurements[12].MeasurementTime_current != RtmCan_Measurements[12].MeasurementTime_last) ||
             (RtmCan_Measurements[12].MeasurementCount_current != RtmCan_Measurements[12].MeasurementCount_last) )
        {
          sysSetVariableFloat("RtmLive", "IdleTask_OsCore0_runtime", _RtmCan_CalculateRuntime(RtmCan_Measurements[12].ID));
          sysSetVariableFloat("RtmLive", "IdleTask_OsCore0_cpuload", _RtmCan_CalculateCpuLoad(RtmCan_Measurements[12].ID, RtmCan_Measurements[12].MeasurementRuntime));

          _RtmCan_StoreLastResults(RtmCan_Measurements[12].ID);
        }
      }
    }
  }
} /* on sysvar_update sysvar::XCP::Rtm::Rtm_Results_12_::time */


