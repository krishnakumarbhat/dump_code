/* ############################################################ */
/* INTERNAL HELPER APIs: */

/**********************************************************************************************************************
  _RtmCan_StateTransition
**********************************************************************************************************************/
/*!
 *
 *  \brief        Changes state of RtmCan.
 *  \details      Depending on current state and the specified eventthe new state is set.
 *  \param[in]    event                   Active MP ID.
 *  \return       RTMCAN_E_OK             The state transition succeeded.
 *  \return       RTMCAN_E_INVALID_EVENT  The state transition failed due to an invalid event.
 *  \return       RTMCAN_E_INVALID_STATE  The state transition failed due to an invalid state.
 *  \pre          -
 *  \synchronous  TRUE
 *  \ingroup      Internal
 *********************************************************************************************************************/
enum RtmCan_ReturnValueType _RtmCan_StateTransition(enum RtmCan_EventType event)
{
  enum RtmCan_ReturnValueType retVal;

  retVal = RTMCAN_E_INVALID_EVENT;

  switch(RtmCan_State)
  {
    /* RTMCAN_STATE_UNINIT -> RTMCAN_STATE_WAITFORACTION
     *   if event:
     *    - RTMCAN_EVENT_INIT occurs.
     */
    case(RTMCAN_STATE_UNINIT) :
      switch(event)
      {
        case(RTMCAN_EVENT_INIT) :
          if (3 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
          {
            write("RtmCan Info @%lld: RtmCan_State == RTMCAN_STATE_WAITFORACTION", timeNowInt64()/100);
          }
          RtmCan_State = RTMCAN_STATE_WAITFORACTION;
          retVal = RTMCAN_E_OK;
          break;

        default :
          if (2 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
          {
            write("RtmCan Warning @%lld: Invalid event in state RTMCAN_STATE_UNINIT.", timeNowInt64()/100);
          }
          break;
      }
      break;

    /* RTMCAN_STATE_WAITFORACTION -> RTMCAN_STATE_MEASURING
     *   if event:
     *    - RTMCAN_EVENT_MEASURING occurs.
     *
     * RTMCAN_STATE_WAITFORACTION -> RTMCAN_STATE_CLEARRESULTS
     *   if event:
     *    - RTMCAN_EVENT_CLEARRESULTS occurs.
     *
     * RTMCAN_STATE_WAITFORACTION -> RTMCAN_STATE_BUSY
     *   if event:
     *    - RTMCAN_EVENT_WAITINGFORUPLOAD,
     *    - RTMCAN_EVENT_CHANGESTATE,
     *    - RTMCAN_EVENT_GETRESULT or
     *    - RTMCAN_EVENT_GENERATEREPORT occurs.
     */
    case(RTMCAN_STATE_WAITFORACTION) :
      switch(event)
      {
        case(RTMCAN_EVENT_MEASURING) :
          if (3 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
          {
            write("RtmCan Info @%lld: RtmCan_State == RTMCAN_STATE_MEASURING", timeNowInt64()/100);
          }
          RtmCan_State = RTMCAN_STATE_MEASURING;
          retVal = RTMCAN_E_OK;
          break;

        case(RTMCAN_EVENT_CLEARRESULTS) :
          if (3 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
          {
            write("RtmCan Info @%lld: RtmCan_State == RTMCAN_STATE_CLEARRESULTS", timeNowInt64()/100);
          }
          RtmCan_State = RTMCAN_STATE_CLEARRESULTS;
          retVal = RTMCAN_E_OK;
          break;

        case(RTMCAN_EVENT_WAITINGFORUPLOAD) :
        case(RTMCAN_EVENT_CHANGESTATE) :
        case(RTMCAN_EVENT_GETRESULT) :
        case(RTMCAN_EVENT_GENERATEREPORT) :
          if (3 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
          {
            write("RtmCan Info @%lld: RtmCan_State == RTMCAN_STATE_BUSY", timeNowInt64()/100);
          }
          RtmCan_State = RTMCAN_STATE_BUSY;
          retVal = RTMCAN_E_OK;
          break;

        default :
          if (2 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
          {
            write("RtmCan Warning @%lld: Invalid event in state RTMCAN_STATE_WAITFORACTION.", timeNowInt64()/100);
          }
          break;
      }
      break;

    /* RTMCAN_STATE_BUSY -> RTMCAN_STATE_WAITFORACTION
     *   if event:
     *    - RTMCAN_EVENT_ACTIONFINISHED occurs.
     *
     * RTMCAN_STATE_BUSY -> RTMCAN_STATE_MEASURING
     *   if event:
     *    - RTMCAN_EVENT_MEASURING occurs.
     */
    case(RTMCAN_STATE_BUSY) :
      switch(event)
      {
        case(RTMCAN_EVENT_ACTIONFINISHED) :
          if (3 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
          {
            write("RtmCan Info @%lld: RtmCan_State == RTMCAN_STATE_WAITFORACTION", timeNowInt64()/100);
          }
          RtmCan_State = RTMCAN_STATE_WAITFORACTION;
          retVal = RTMCAN_E_OK;
          break;

        case(RTMCAN_EVENT_MEASURING) :
          if (3 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
          {
            write("RtmCan Info @%lld: RtmCan_State == RTMCAN_STATE_MEASURING", timeNowInt64()/100);
          }
          RtmCan_State = RTMCAN_STATE_MEASURING;
          retVal = RTMCAN_E_OK;
          break;

        default :
          if (2 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
          {
            write("RtmCan Warning @%lld: Invalid event in state RTMCAN_STATE_BUSY.", timeNowInt64()/100);
          }
          break;
      }
      break;

    /* RTMCAN_STATE_MEASURING -> RTMCAN_STATE_WAITFORACTION
     *   if event:
     *    - RTMCAN_EVENT_ACTIONFINISHED occurs.
     *
     * RTMCAN_STATE_MEASURING -> RTMCAN_STATE_BUSY
     *   if event:
     *    - RTMCAN_EVENT_WAITINGFORUPLOAD occurs.
     */
    case(RTMCAN_STATE_MEASURING) :
      switch(event)
      {
        case(RTMCAN_EVENT_ACTIONFINISHED) :
          if (3 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
          {
            write("RtmCan Info @%lld: RtmCan_State == RTMCAN_STATE_WAITFORACTION", timeNowInt64()/100);
          }
          RtmCan_State = RTMCAN_STATE_WAITFORACTION;
          retVal = RTMCAN_E_OK;
          break;

        case(RTMCAN_EVENT_WAITINGFORUPLOAD) :
          if (3 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
          {
            write("RtmCan Info @%lld: RtmCan_State == RTMCAN_STATE_BUSY", timeNowInt64()/100);
          }
          RtmCan_State = RTMCAN_STATE_BUSY;
          retVal = RTMCAN_E_OK;
          break;

        default :
          if (2 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
          {
            write("RtmCan Warning @%lld: Invalid event in state RTMCAN_STATE_MEASURING.", timeNowInt64()/100);
          }
          break;
      }
      break;

    /* RTMCAN_STATE_CLEARRESULTS -> RTMCAN_STATE_WAITFORACTION
     *   if event:
     *    - RTMCAN_EVENT_ACTIONFINISHED occurs.
     */
    case(RTMCAN_STATE_CLEARRESULTS) :
      switch(event)
      {
        case(RTMCAN_EVENT_ACTIONFINISHED) :
          if (3 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
          {
            write("RtmCan Info @%lld: RtmCan_State == RTMCAN_STATE_WAITFORACTION", timeNowInt64()/100);
          }
          RtmCan_State = RTMCAN_STATE_WAITFORACTION;
          retVal = RTMCAN_E_OK;
          break;

        default :
          if (2 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
          {
            write("RtmCan Warning @%lld: Invalid event in state RTMCAN_STATE_CLEARRESULTS.", timeNowInt64()/100);
          }
          break;
      }
      break;

    /* Invalid state! -> RTMCAN_STATE_UNINIT */
    default :
      if (1 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
      {
        write("RtmCan Error @%lld: Is in invalid state. Set to RTMCAN_STATE_UNINIT.", timeNowInt64()/100);
      }
      RtmCan_State = RTMCAN_STATE_UNINIT;
      retVal = RTMCAN_E_INVALID_STATE;
      break;
  }

  return retVal;
} /* _RtmCan_StateTransition */

/**********************************************************************************************************************
  _RtmCan_StoreLastResults
**********************************************************************************************************************/
/*!
 *
 *  \brief        Stores last measurement results.
 *  \details      Only required for Live Measurement.
 *  \param[in]    measurementId           Active MP ID.
 *  \return       -
 *  \pre          Live measurement is executed.
 *  \synchronous  TRUE
 *  \ingroup      Internal
 *********************************************************************************************************************/
void _RtmCan_StoreLastResults(int measurementId)
{
  RtmCan_Measurements[measurementId].MeasurementCount_last = RtmCan_Measurements[measurementId].MeasurementCount_current;
  RtmCan_Measurements[measurementId].MeasurementTime_last = RtmCan_Measurements[measurementId].MeasurementTime_current;
} /* _RtmCan_StoreLastResults */

/**********************************************************************************************************************
  _RtmCan_CreateLiveMeasurementVariables
**********************************************************************************************************************/
/*!
 *
 *  \brief        Creates system variables for all MPs.
 *  \details      Creates one variable for runtime and one for CPU load.
 *  \param[in]    -
 *  \return       -
 *  \pre          Live measurement is executed.
 *  \synchronous  TRUE
 *  \ingroup      Internal
 *********************************************************************************************************************/
void _RtmCan_CreateLiveMeasurementVariables()
{
  int i;
  char tmpText[200];

  SysDefineNamespace("RtmLive");
  SysDefineVariableFloat("RtmLive", "Rtm_CPULoad", 0.0);

  SysDefineNamespace("Rtm");
  sysDefineVariableInt("Rtm", "Rtm_MeasurementCounter", 0);

  for (i = 0; i < RTMCAN_MEASUREMENTS_COUNT; i++)
  {
    snprintf(tmpText, elcount(tmpText), "%s_cpuload", RtmCan_Measurements[i].Name );
    sysDefineVariableFloat("RtmLive", tmpText, 0.0);

    snprintf(tmpText, elcount(tmpText), "%s_runtime", RtmCan_Measurements[i].Name );
    sysDefineVariableFloat("RtmLive", tmpText, 0.0);
  }
} /* _RtmCan_CreateLiveMeasurementVariables */

/**********************************************************************************************************************
  _RtmCan_WaitForUpload
**********************************************************************************************************************/
/*!
 *
 *  \brief        Helper function to wait some ticks.
 *  \details      Used to wait for Xcp upload. Waits as long as specified.
 *  \param[in]    endValue                Specifies the duration of waiting.
 *  \return       -
 *  \pre          -
 *  \synchronous  TRUE
 *  \ingroup      Internal
 *********************************************************************************************************************/
/* Just wait for specified time. */
void _RtmCan_WaitForUpload(dword endValue)
{
  dword i;

  for (i = 0; i < endValue; i++)
  {
  }
} /* _RtmCan_WaitForUpload */


/**********************************************************************************************************************
  _RtmCan_ConfigureMeasurements
**********************************************************************************************************************/
/*!
 *
 *  \brief        Set the measurement config array, defining which MP is active on ECU.
 *  \details      Prepares the measurement config array which can be written to the ECU. It overtakes the user
 *                configuration settings to decide which MP is active and which is inactive.
 *  \param[in]    -
 *  \return       -
 *  \pre          The user should set the active MPs prior to start a measurement.
 *  \synchronous  TRUE
 *  \ingroup      Internal
 *********************************************************************************************************************/
void _RtmCan_ConfigureMeasurements()
{
  int i;

  _RtmCan_InitMeasurementConfig();

  for (i = 0; i < RTMCAN_MEASUREMENTS_COUNT; i++)
  {
    if (RtmCan_MeasurementSectionActive[i] == RTMCAN_MP_STATE_ACTIVE)
    {
       RtmCan_MeasurementConfigArray[RtmCan_Measurements[i].ByteIndex] |= (RtmCan_Measurements[i].BitMask);
    }
    else
    {
       RtmCan_MeasurementConfigArray[RtmCan_Measurements[i].ByteIndex] &= ~(RtmCan_Measurements[i].BitMask);
    }
  }
} /* _RtmCan_ConfigureMeasurements */


/**********************************************************************************************************************
  _RtmCan_TransmitCtrlArray
**********************************************************************************************************************/
/*!
 *
 *  \brief        Transmits the measurement config array, defining which MP is active.
 *  \details      Prepares the measurement config array which can be written to the ECU. It overtakes the user
 *                configuration settings to decide which MP is active and which is inactive.
 *  \param[in]    initialOnEcu            if set to RTMCAN_TRUE, deactivate all MPs on the ECU.
 *                                        if set to RTMCAN_FALSE, the last setting of active/inactive MPs is
 *                                          transmitted to ECU.
 *  \return       -
 *  \pre          -
 *  \synchronous  TRUE
 *  \ingroup      Internal
 *********************************************************************************************************************/
void _RtmCan_TransmitCtrlArray(enum RtmCan_Boolean initialOnEcu)
{
  int i;
  long tmpMeasConfigArray[RTMCAN_CONFIG_ARRAY_SIZE];

  if (initialOnEcu == RTMCAN_TRUE)
  {
    for (i = 0; i < RTMCAN_CONFIG_ARRAY_SIZE; i++)
    {
      tmpMeasConfigArray[i] = (long)0;
    }
  }
  else
  {
    for (i = 0; i < RTMCAN_CONFIG_ARRAY_SIZE; i++)
    {
      tmpMeasConfigArray[i] = (long)RtmCan_MeasurementConfigArray[i];
    }
  }

 
  sysSetVariableLongArray(sysvar::XCP::Rtm::Rtm_MeasurementConfig, tmpMeasConfigArray, RTMCAN_CONFIG_ARRAY_SIZE);
} /* _RtmCan_TransmitCtrlArray */


/**********************************************************************************************************************
  _RtmCan_TransmitEcuCommand
**********************************************************************************************************************/
/*!
 *
 *  \brief        Transmits a Rtm command to ECU.
 *  \details      The command defines what the Rtm has to do next.
 *  \param[in]    cmd                     If set to RTMCAN_CMD_SERIAL, a serial measurement is started.
 *                                        If set to RTMCAN_CMD_PARALLEL, a parallel measurement is started.
 *                                        If set to RTMCAN_CMD_LIVE, a live measurement is started.
 *                                        If set to RTMCAN_CMD_STOP, the current measurement is stopped.
 *                                        If set to RTMCAN_CMD_CLEAR, all measurement results on the ECU are cleared.
 *  \return       -
 *  \pre          -
 *  \synchronous  TRUE
 *  \ingroup      Internal
 *********************************************************************************************************************/
void _RtmCan_TransmitEcuCommand(dword cmd)
{
  if (3 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
  {
    write("RtmCan Info @%lld: Write %x to \"Rtm_Cmd\".", timeNowInt64()/100, cmd);
  }
  @sysvar::XCP::Rtm::Rtm_Cmd = cmd;
} /* _RtmCan_TransmitEcuCommand */


/**********************************************************************************************************************
  _RtmCan_BuildEcuCommand
**********************************************************************************************************************/
/*!
 *
 *  \brief        Assembles the Rtm command.
 *  \details      The command defines what the Rtm has to do next.
 *  \param[in]    command                 If set to RTMCAN_CMD_SERIAL, a serial measurement is started.
 *                                        If set to RTMCAN_CMD_PARALLEL, a parallel measurement is started.
 *                                        If set to RTMCAN_CMD_LIVE, a live measurement is started.
 *                                        If set to RTMCAN_CMD_STOP, the current measurement is stopped.
 *                                        If set to RTMCAN_CMD_CLEAR, all measurement results on the ECU are cleared.
 *  \param[in]    timeMs                  Requested measurement duration. Is only relevant to start a measurement.
 *                                        If set to 0, the duration is unlimited and must be stopped by calling
 *                                        RtmCan_StopMeasurement.
 *  \return       Assembled Rtm command.
 *  \pre          -
 *  \synchronous  TRUE
 *  \ingroup      Internal
 *********************************************************************************************************************/
dword _RtmCan_BuildEcuCommand(enum RtmCan_MeasurementCommandType command, dword timeMs)
{
  dword cmd;

  cmd = 0;

  if ((timeMs / RTMCAN_MAINFUNCTIONCYCLETIME_MS) < 2)
  {
    /* Measurement Duration to small, measure endless. */
    timeMs = 0;
  }
  else
  {
    timeMs = (timeMs / RTMCAN_MAINFUNCTIONCYCLETIME_MS) - 1;
  }

  if (RTMCAN_CMD_SERIAL == command)
  {
    if (3 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
    {
      if (timeMs > 0)
      {
        write("RtmCan Info @%lld: - start SERIAL measurement for %dms", timeNowInt64()/100, (timeMs * RTMCAN_MAINFUNCTIONCYCLETIME_MS));
      }
      else
      {
        write("RtmCan Info @%lld: - start SERIAL measurement until call to \"RtmCan_StopMeasurement()\".", timeNowInt64()/100);
      }
    }

    cmd = (((dword)RTMCAN_CMD_SERIAL) << 28) | timeMs;
  }
  else if (RTMCAN_CMD_PARALLEL == command)
  {
    if (3 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
    {
      if (timeMs > 0)
      {
        write("RtmCan Info @%lld: - start PARALLEL measurement for %dms", timeNowInt64()/100, (timeMs * RTMCAN_MAINFUNCTIONCYCLETIME_MS));
      }
      else
      {
        write("RtmCan Info @%lld: - start PARALLEL measurement until call to \"RtmCan_StopMeasurement()\".", timeNowInt64()/100);
      }
    }

    cmd = (((dword)RTMCAN_CMD_PARALLEL) << 28) | timeMs;
  }
  else if (RTMCAN_CMD_LIVE == command)
  {
    if (3 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
    {
      if (timeMs > 0)
      {
        write("RtmCan Info @%lld: - start LIVE measurement for %dms", timeNowInt64()/100, (timeMs * RTMCAN_MAINFUNCTIONCYCLETIME_MS));
      }
      else
      {
        write("RtmCan Info @%lld: - start LIVE measurement until call to \"RtmCan_StopMeasurement()\".", timeNowInt64()/100);
      }
    }

    cmd = (((dword)RTMCAN_CMD_LIVE) << 28) | timeMs;
  }
  else if (RTMCAN_CMD_STOP == command)
  {
    if (3 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
    {
      write("RtmCan Info @%lld: - STOP measurement.", timeNowInt64()/100);
    }
    cmd = (((dword)RTMCAN_CMD_STOP) << 28) | 0;
  }
  else if (RTMCAN_CMD_CLEAR == command)
  {
    if (3 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
    {
      write("RtmCan Info @%lld: - CLEAR results on ECU.", timeNowInt64()/100);
    }
    cmd = (((dword)RTMCAN_CMD_CLEAR) << 28) | 0;
  }
  else
  {
    if (1 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
    {
      write("RtmCan Error @%lld: Invalid measurement duration specified (%lld ms)",timeNowInt64()/100, (timeMs * RTMCAN_MAINFUNCTIONCYCLETIME_MS));
    }

    RtmCan_State = RTMCAN_STATE_WAITFORACTION;
  }

  return cmd;
} /* _RtmCan_BuildEcuCommand */


/**********************************************************************************************************************
  _RtmCan_CalculateCpuLoad
**********************************************************************************************************************/
/*!
 *
 *  \brief        Calculates the CPU load of the requested MP.
 *  \details      The calculation depends on the measurement duration.
 *  \param[in]    mpIndex                 The requested MP index.
 *  \param[in]    runtime                 The runtime the MP in us.
 *  \return       The calculated CPU load of the MP in %.
 *  \pre          Must be called after _RtmCan_CalculateRuntime() for the same MP.
 *  \synchronous  TRUE
 *  \ingroup      Internal
 *********************************************************************************************************************/
double _RtmCan_CalculateCpuLoad(dword mpIndex, double runtime)
{
  double cpuLoad;
  dword count;
  double correction;

  cpuLoad = 0;

  if (RtmCan_MeasurementSectionActive[mpIndex] == RTMCAN_MP_STATE_ACTIVE)
  {
    /* If the measurement is endless and therefore stoppable. */
    if (RtmCan_StoppableMeasurementRunning == RTMCAN_FALSE)
    {
      correction = @sysvar::XCP::Rtm::Rtm_MeasTimeCorrection; /* in ticks */

      correction = ((correction * 1000) / RTMCAN_MEASUREMENT_FREQ_MS); /* in us */

      /* And if current measurement mode is LIVE. */
      if (RtmCan_LiveMeasurementActive == RTMCAN_TRUE)
      {
         /* The measurement duration is always one Main Function Cycle. */
        RtmCan_MeasurementDuration_us = (qword)(RTMCAN_MAINFUNCTIONCYCLETIME_MS * 1000); /* in us */
      }
    }

    count = RtmCan_Measurements[mpIndex].MeasurementCount_current - RtmCan_Measurements[mpIndex].MeasurementCount_last;

    if (0 == count && RtmCan_LiveMeasurementActive == RTMCAN_FALSE)
    {
      count = RtmCan_Measurements[mpIndex].MeasurementCount_current;
    }

    if ((count != 0) && (RtmCan_MeasurementDuration_us != 0))
    {
      /* Calculate CPU load: */
      if (mpIndex == RTMCAN_INDEX_OF_CPU_LOAD)
      {
        if (RTMCAN_CPULOAD_VIA_C_API == 1)
        {
          cpuLoad = (double)((double)(100 * runtime) / (double)(RTMCAN_MAINFUNCTIONCYCLETIME_MS * 1000));
        }
        else
        {
          cpuLoad = (double)((double)(100 * runtime * count) / (double)(RtmCan_MeasurementDuration_us));
        }
      }
      else
      {
        if (RtmCan_StoppableMeasurementRunning == RTMCAN_TRUE)
        {
          cpuLoad = (double)((double)(100 * runtime * count) / (double)(RtmCan_MeasurementDuration_us));
        }
        else
        {

          if (((int64)(RtmCan_MeasurementDuration_us) >   (int64)correction) &&
              ((int64)(RtmCan_MeasurementDuration_us) > (int64)(-correction)) &&
              ((RTMCAN_MAINFUNCTIONCYCLETIME_MS * RTMCAN_MEASUREMENT_FREQ_MS) > correction)
             )
          {
            cpuLoad = (double)((double)(100 * runtime * count) / (double)((int64)RtmCan_MeasurementDuration_us - correction));
          }
          else
          {
            cpuLoad = (double)((double)(100 * runtime * count) / (double)(RtmCan_MeasurementDuration_us));
          }
        }
      }

      /* Cpu Load must be in range 0 to 100. */
      if (cpuLoad > 100)
      {
        cpuLoad = 100;
      }
      else if (cpuLoad < 0)
      {
        cpuLoad = 0;
      }

      RtmCan_Measurements[mpIndex].MeasurementCpuLoad_Percent = cpuLoad;
    }
    else
    {
      if (RtmCan_LiveMeasurementActive == RTMCAN_FALSE)
      {
        if (2 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
        {
          write("RtmCan Warning @%lld: count of MP or measurement duration is 0.", timeNowInt64()/100);
        }
      }
      RtmCan_Measurements[mpIndex].MeasurementCpuLoad_Percent = 0;
    }
  }

  return cpuLoad;
} /* _RtmCan_CalculateCpuLoad */


/**********************************************************************************************************************
  _RtmCan_GetOverheadForMP
**********************************************************************************************************************/
/*!
 *
 *  \brief        Calculates the overhead of the requested MP.
 *  \details      Gets the corresponding overhead runtime for the specified MP.
 *  \param[in]    mpIndex                 The requested MP index.
 *  \return       The corresponding overhead runtime.
 *  \pre          -
 *  \synchronous  TRUE
 *  \ingroup      Internal
 *********************************************************************************************************************/
double _RtmCan_GetOverheadForMP(dword mpIndex)
{
  double overhead;

  overhead = 0.0;

  switch(RtmCan_Measurements[mpIndex].MpType)
  {
    case(RTMCAN_MP_TYPE_GROSS_EXECUTIONTIME) :
      if (RtmCan_Measurements[mpIndex].DisableInterrupts == RTMCAN_FALSE)
      {
        overhead = RtmCan_Measurements[0].MeasurementRuntime;
      }
      else
      {
        overhead = RtmCan_Measurements[1].MeasurementRuntime;
      }
      break;

    case(RTMCAN_MP_TYPE_NET_EXECUTIONTIME) :
      if (RtmCan_Measurements[mpIndex].DisableInterrupts == RTMCAN_FALSE)
      {
        overhead = RtmCan_Measurements[2].MeasurementRuntime;
      }
      else
      {
        overhead = RtmCan_Measurements[3].MeasurementRuntime;
      }
      break;

    default :
      if (1 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
      {
        write("RtmCan Error @%lld: MP %d has an invalid type.", timeNowInt64()/100, mpIndex);
      }
      break;
  }

  return overhead;
} /* _RtmCan_GetOverheadForMP */


/**********************************************************************************************************************
  _RtmCan_CalculateRuntime
**********************************************************************************************************************/
/*!
 *
 *  \brief        Calculates the runtime of the requested MP.
 *  \details      The command defines what the Rtm has to do next.
 *  \param[in]    mpIndex                 The requested MP index.
 *  \return       The calculated runtime of the MP in us.
 *  \pre          -
 *  \synchronous  TRUE
 *  \ingroup      Internal
 *********************************************************************************************************************/
double _RtmCan_CalculateRuntime(dword mpIndex)
{
  double runtime, overhead;
  dword count, ticks;

  runtime = 0;

  count = RtmCan_Measurements[mpIndex].MeasurementCount_current - RtmCan_Measurements[mpIndex].MeasurementCount_last;
  ticks = RtmCan_Measurements[mpIndex].MeasurementTime_current - RtmCan_Measurements[mpIndex].MeasurementTime_last;

  if ((count == 0) && (RtmCan_LiveMeasurementActive == RTMCAN_FALSE))
  {
    count = RtmCan_Measurements[mpIndex].MeasurementCount_current;
    ticks = RtmCan_Measurements[mpIndex].MeasurementTime_current;
  }

  if (count != 0)
  {
    /* Calculate Runtime: */
    runtime = (double)((((double)ticks/(double)count))/(double)RTMCAN_MEASUREMENT_FREQ_MS) * (double)1000.0; /* Average Runtime in us. */

    /* Measurement correction - remove runtime of Rtm_Start-/Rtm_Stop-APIs: */
    if (mpIndex >= RTMCAN_NUMBER_OF_OVERHEAD_MPS)
    {
      if (mpIndex != RTMCAN_INDEX_OF_CPU_LOAD)
      {
        overhead = _RtmCan_GetOverheadForMP(mpIndex);

        if (overhead <= runtime)
        {
          runtime -= overhead;
        }
        else
        {
          runtime = 0;

          if (3 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
          {
            write("RtmCan Info @%lld: MP %d was executed but runtime was too short.", timeNowInt64()/100, mpIndex);
          }
        }
      }
    }

    RtmCan_Measurements[mpIndex].MeasurementRuntime = (double)runtime;
  }
  else
  {
    RtmCan_Measurements[mpIndex].MeasurementRuntime = 0;
  }

  return runtime;
} /* _RtmCan_CalculateRuntime */


/**********************************************************************************************************************
  _RtmCan_CalculateResults
**********************************************************************************************************************/
/*!
 *
 *  \brief        Calculates the measurement results of all active MPs.
 *  \details      Calculates the measurement results of all active MPs.
 *  \param[in]    -
 *  \return       -
 *  \pre          -
 *  \synchronous  TRUE
 *  \ingroup      Internal
 *********************************************************************************************************************/
void _RtmCan_CalculateResults()
{
  dword i;
  double res;

  for (i = 0; i < RTMCAN_MEASUREMENTS_COUNT; i++)
  {
    if (RtmCan_MeasurementSectionActive[i] == RTMCAN_MP_STATE_ACTIVE)
    {
      res = _RtmCan_CalculateRuntime(i);
      _RtmCan_CalculateCpuLoad(i, res);
    }
  }
} /* _RtmCan_CalculateResults */


/**********************************************************************************************************************
  _RtmCan_SetMinMaxRuntime
**********************************************************************************************************************/
/*!
 *
 *  \brief        Sets the min and max runtime of current MP to result struct.
 *  \details      Calculates the minimum runtime of current MP.
 *  \param[in]    -
 *  \return       -
 *  \pre          Min runtime is smaller than max runtime.
 *  \synchronous  TRUE
 *  \ingroup      Internal
 *********************************************************************************************************************/
void _RtmCan_SetMinMaxRuntime(struct RtmCan_ResultType result, dword mpIndex)
{
  double maxRuntime;
  double minRuntime;
  double overhead;

  /* If the measurement point was never executed, min and max runtime must be zero. */ 
  if ((RtmCan_Measurements[mpIndex].MeasurementCount_current - RtmCan_Measurements[mpIndex].MeasurementCount_Last) == 0)
  {
    minRuntime = 0;
    maxRuntime = 0;
  }
  else
  {
    maxRuntime = (double)((double)(RtmCan_Measurements[mpIndex].MeasurementMax) / (double)RTMCAN_MEASUREMENT_FREQ_MS) * (double)1000;
    minRuntime = (double)((double)(RtmCan_Measurements[mpIndex].MeasurementMin) / (double)RTMCAN_MEASUREMENT_FREQ_MS) * (double)1000;

    overhead = _RtmCan_GetOverheadForMP(mpIndex);

    if (maxRuntime >= overhead)
    {
      maxRuntime -= overhead;
    }
    else
    {
      maxRuntime = 0;
    }

    if (minRuntime >= overhead)
    {
      minRuntime -= overhead;
    }
    else
    {
      minRuntime = 0;
    }
  }

  result.RtmCan_Result_MinRuntime_us = minRuntime;
  result.RtmCan_Result_MaxRuntime_us = maxRuntime;
} /* _RtmCan_SetMinMaxRuntime */


/**********************************************************************************************************************
  _RtmCan_SetResult
**********************************************************************************************************************/
/*!
 *
 *  \brief        Sets the measurement results of one MP to a result structure.
 *  \details      Returns the structure containing the results.
 *  \param[out]   result                  Pointer to struct, containing the measurement results of specified MP.
 *  \param[in]    isInitResultRequested   If set to RTMCAN_TRUE, the struct members of result are set to initial
 *                                          values.
 *                                        If set to RTMCAN_FALSE, the reults of the specified MP are returned.
 *  \param[in]    mpIndex                 The index of the specified MP.
 *  \return       -
 *  \pre          The index of MP must be in valid range (0 <= mpIndex < RTMCAN_MEASUREMENTS_COUNT).
 *  \synchronous  TRUE
 *  \ingroup      Internal
 *********************************************************************************************************************/
void _RtmCan_SetResult(struct RtmCan_ResultType result, enum RtmCan_Boolean isInitResultRequested, dword mpIndex)
{
  if (isInitResultRequested == RTMCAN_TRUE)
  {
    result.RtmCan_Result_ID = 0;
    strncpy(result.RtmCan_Result_Name, "\0", 1);
    strncpy(result.RtmCan_Result_Group, "\0", 1);
    result.RtmCan_Result_MP_Type = RTMCAN_MP_TYPE_GROSS_EXECUTIONTIME;
    result.RtmCan_Result_MinRuntime_us = 0;
    result.RtmCan_Result_MaxRuntime_us = 0;
    result.RtmCan_Result_AverageRuntime_us = 0;
    result.RtmCan_Result_NumberOfExecution = 0;
    result.RtmCan_Result_CpuLoad = 0;
    result.RtmCan_Result_AssignedToCore = 0xFFFFFFFF;
    result.RtmCan_Result_RelativeMax_percent = 0;
    result.RtmCan_Result_RelativeRemaining_percent = 0;
  }
  else
  {
    result.RtmCan_Result_ID = mpIndex;
    strncpy(result.RtmCan_Result_Name, RtmCan_Measurements[mpIndex].Name, strlen(RtmCan_Measurements[mpIndex].Name) + 1);
    strncpy(result.RtmCan_Result_Group, RtmCan_Measurements[mpIndex].Group, strlen(RtmCan_Measurements[mpIndex].Group) + 1);
    _RtmCan_SetMinMaxRuntime(result, mpIndex);
    result.RtmCan_Result_MP_Type = RtmCan_Measurements[mpIndex].MpType; 
    result.RtmCan_Result_AverageRuntime_us = RtmCan_Measurements[mpIndex].MeasurementRuntime;
    result.RtmCan_Result_NumberOfExecution = RtmCan_Measurements[mpIndex].MeasurementCount_Current - RtmCan_Measurements[mpIndex].MeasurementCount_Last;
    result.RtmCan_Result_CpuLoad = RtmCan_Measurements[mpIndex].MeasurementCpuLoad_Percent;
    result.RtmCan_Result_MeasurementDuration_us = (qword)RtmCan_MeasurementDuration_us;
    result.RtmCan_Result_AssignedToCore = RtmCan_Measurements[mpIndex].AssignedToCore;
    if (RtmCan_Measurements[mpIndex].TargetRuntime > 0)
    {
      result.RtmCan_Result_RelativeMax_percent = (result.RtmCan_Result_MaxRuntime_us * 100) / RtmCan_Measurements[mpIndex].TargetRuntime;

      if (result.RtmCan_Result_RelativeMax_percent >= 100)
      {
        result.RtmCan_Result_RelativeRemaining_percent = 0;
      }
      else
      {
        result.RtmCan_Result_RelativeRemaining_percent = 100 - result.RtmCan_Result_RelativeMax_percent;
      }
    }
    else
    {
      result.RtmCan_Result_RelativeMax_percent = 0;
    }
  }
} /* _RtmCan_SetResult */


/**********************************************************************************************************************
  _RtmCan_ReturnResultsByMPID
**********************************************************************************************************************/
/*!
 *
 *  \brief        Returns the results of one MP if the specified MP ID is in valid range.
 *  \details      Calculates the measurement results of all active MPs.
 *  \param[in]    measPointID             The index of the specified MP.
 *  \param[out]   result                  Pointer to struct, containing the measurement results of specified MP.
 *  \return       RTMCAN_E_OK             The request succeeded.
 *  \return       RTMCAN_E_NO_MATCH_FOUND
 *  \pre          -
 *  \synchronous  TRUE
 *  \ingroup      Internal
 *********************************************************************************************************************/
enum RtmCan_ReturnValueType _RtmCan_ReturnResultsByMPID(dword measPointID, struct RtmCan_ResultType result)
{
  enum RtmCan_ReturnValueType retVal;

  if ((measPointID < RTMCAN_MEASUREMENTS_COUNT) && (measPointID >= RTMCAN_NUMBER_OF_OVERHEAD_MPS))
  {
    _RtmCan_SetResult(result, RTMCAN_FALSE, measPointID);

    retVal = RTMCAN_E_OK;
  }
  else
  {
    _RtmCan_SetResult(result, RTMCAN_TRUE, 0);

    retVal = RTMCAN_E_NO_MATCH_FOUND;
  }

  return retVal;
} /* _RtmCan_ReturnResultsByMPID */


/**********************************************************************************************************************
  _RtmCan_StartMeasurement
**********************************************************************************************************************/
/*!
 *
 *  \brief        Starts a runtime measurement.
 *  \details      Sends firstly the measurement config array to ECU, then the Rtm_Cmd containing measurement mode and
 *                measurement duration.
 *  \param[in]    command                 The index of the specified MP.
 *  \param[out]   timeToMeas              Pointer to struct, containing the measurement results of specified MP.
 *  \return       -
 *  \pre          The command must be
 *  \synchronous  TRUE
 *  \ingroup      Internal
 *********************************************************************************************************************/
void _RtmCan_StartMeasurement(enum RtmCan_MeasurementCommandType command, dword timeToMeas)
{
  /* Transmit measurement config array with all active MPs. */
  _RtmCan_TransmitCtrlArray(RTMCAN_FALSE);
  _RtmCan_WaitForUpload(10000);

  /* Transmit Rtm_Cmd containing measurement mode and measurement duration. */
  _RtmCan_TransmitEcuCommand(_RtmCan_BuildEcuCommand(command, timeToMeas));

  if ((timeToMeas / RTMCAN_MAINFUNCTIONCYCLETIME_MS) < 2)
  {
    RtmCan_StoppableMeasurementRunning = RTMCAN_TRUE;
    RtmCan_MeasurementDuration_us = 0;
  }
  else
  {
    RtmCan_StoppableMeasurementRunning = RTMCAN_FALSE;
    RtmCan_MeasurementDuration_us = timeToMeas * 1000; /* Convert from s to ms. */
  }
} /* _RtmCan_StartMeasurement */


/**********************************************************************************************************************
  _RtmCan_StartNextSerialMeasurement
**********************************************************************************************************************/
/*!
 *
 *  \brief        Starts the next measurement for the next active measurement point.
 *  \details      Sets the next measurement point to active and starts serial measurement.
 *  \param[in]    -
 *  \return       RTMCAN_TRUE             The next measurement is started for the next measurement point.
 *  \return       RTMCAN_FALSE            The measurement for the last active measurement point was already executed.
 *                                        Thus, the serial measurement is finished.
 *  \pre          Serial measurement is executed.
 *  \synchronous  TRUE
 *  \ingroup      Internal
 *********************************************************************************************************************/
enum RtmCan_Boolean _RtmCan_StartNextSerialMeasurement()
{
  enum RtmCan_Boolean nextMPstarted;
  dword i;
  dword activeMPIndex;
  dword prevActiveMPIndex;

  prevActiveMPIndex = RTMCAN_MEASUREMENTS_COUNT;
  nextMPstarted = RTMCAN_FALSE;

  for (i = 0; (i < RTMCAN_MEASUREMENTS_COUNT) && (nextMPstarted == RTMCAN_FALSE); i++)
  {
    if (RtmCan_MeasurementSectionActive[i] == RTMCAN_MP_STATE_ACTIVE)
    {
      prevActiveMPIndex = i;
      RtmCan_MeasurementSectionActive[i] = RTMCAN_MP_STATE_INACTIVE;
    }
    if ((i > prevActiveMPIndex) /* A new MP has to be set active, not an old one. */
         && (RtmCan_MeasurementSectionActive_Serial[i] == RTMCAN_MP_STATE_ACTIVE) /* The next active MP to be measured. */
       )
    {
      nextMPstarted = RTMCAN_TRUE;

      RtmCan_MeasurementSectionActive[i] = RTMCAN_MP_STATE_ACTIVE;

      _RtmCan_ConfigureMeasurements();

      _RtmCan_StartMeasurement(RTMCAN_CMD_SERIAL, (RtmCan_MeasurementDuration_us / 1000) /* Measurement duration in ms */);
    }
  }

  /* If the last measurement point was already started. */
  if (nextMPstarted == RTMCAN_FALSE)
  {
    /* Recover all active measurement points and initialize the recovery stack. */
    for (i = 0; i < RTMCAN_MEASUREMENTS_COUNT; i++)
    {
      RtmCan_MeasurementSectionActive[i] = RtmCan_MeasurementSectionActive_Serial[i];
      RtmCan_MeasurementSectionActive_Serial[i] = RTMCAN_MP_STATE_INACTIVE;
    }
  }

  return nextMPstarted;
} /* _RtmCan_StartNextSerialMeasurement */

/* <- INTERNAL HELPER APIs */
/* ############################################################ */


/* ############################################################ */
/* CANOE CALLBACK APIs -> */

/// @cond DEV

/**********************************************************************************************************************
  on preStart
**********************************************************************************************************************/
/*!
 *
 *  \brief        Initializes the RtmCan.
 *  \details      Called by CANoe while start up of simulation. Initialized RtmCan.
 *  \param[in]    -
 *  \return       -
 *  \pre          Called if value of Rtm_Resp is changed within ECU.
 *  \pre          Called by CANoe, if the variable Rtm_Resp is mapped to DAQ-Event Rtm_Evt.
 *  \pre          Live measurement mode is active.
 *  \synchronous  TRUE
 *  \ingroup      Callback
 *********************************************************************************************************************/
on preStart
{
  RtmCan_State = RTMCAN_STATE_UNINIT;
  if (3 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
  {
    write("RtmCan Info @%lld: RtmCan_State == RTMCAN_STATE_UNINIT", timeNowInt64()/100);
  }

  _RtmCan_InitData();
  _RtmCan_InitMeasurementPointState();
  _RtmCan_InitMeasurementConfig();

  RtmCan_State = RTMCAN_STATE_WAITFORACTION;
  if (3 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
  {
    write("RtmCan Info @%lld: RtmCan_State == RTMCAN_STATE_WAITFORACTION", timeNowInt64()/100);
  }
} /* on preStart */


/**********************************************************************************************************************
  on sysvar_update sysvar::XCP::Rtm::Rtm_CpuLoadTime
**********************************************************************************************************************/
/*!
 *
 *  \brief        Called by CANoe if the variable Rtm_CpuLoadTime is updated on ECU and Xcp event Rtm_Event is
 *                  triggered.
 *  \details      According variable access and Xcp event triggering takes place within Rtm_MainFunction.
 *  \param[in]    -
 *  \return       -
 *  \pre          Called if value of Rtm_CpuLoadTime is changed within ECU.
 *  \pre          Called by CANoe, if the variable Rtm_CpuLoadTime is mapped to DAQ-Event Rtm_Event.
 *  \pre          Live measurement mode is active.
 *  \synchronous  TRUE
 *  \ingroup      Callback
 *********************************************************************************************************************/
on sysvar_update sysvar::XCP::Rtm::Rtm_CpuLoadTime
{
  double result;

  if (RtmCan_LiveMeasurementActive == RTMCAN_TRUE)
  {
    result = ((@sysvar::XCP::Rtm::Rtm_CpuLoadTime) / (double)((RTMCAN_MEASUREMENT_FREQ_MS * RTMCAN_MAINFUNCTIONCYCLETIME_MS) - @sysvar::XCP::Rtm::Rtm_MeasTimeCorrection)) *100;

    if(result <= 100 && result >= 0)
      sysSetVariableFloat("RtmLive", "Rtm_CPULoad", result);
    else
      sysSetVariableFloat("RtmLive", "Rtm_CPULoad", 0.0);

    if (3 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
    {
      write("RtmCan Info @%lld:", timeNowInt64()/100);
      write(" - CPU load time: %d.", @sysvar::XCP::Rtm::Rtm_CpuLoadTime);
      write(" - Measurement Time Correction: %d.", @sysvar::XCP::Rtm::Rtm_MeasTimeCorrection);
      result = sysGetVariableFloat("RtmLive", "Rtm_CPULoad");
      write(" - CPU load result: %g.", result);
    }
  }
} /* on sysvar_update sysvar::XCP::Rtm::Rtm_CpuLoadTime */

/**********************************************************************************************************************
  on sysvar_update sysvar::XCP::Rtm::Rtm_AverageMainFunctionCycleTime
**********************************************************************************************************************/
/*!
 *
 *  \brief        Called by CANoe if the variable Rtm_AverageMainFunctionCycleTime is updated on ECU and Xcp event
 *                Rtm_Evt is triggered.
 *  \details      According variable access and Xcp event triggering takes place within Rtm_MainFunction.
 *  \param[in]    -
 *  \return       -
 *  \pre          Called if value of Rtm_Resp is changed within ECU.
 *  \pre          Called by CANoe, if the variable Rtm_Resp is mapped to DAQ-Event Rtm_Evt.
 *  \pre          Live measurement mode is active.
 *  \synchronous  TRUE
 *  \ingroup      Callback
 *********************************************************************************************************************/
on sysvar_update sysvar::XCP::Rtm::Rtm_AverageMainFunctionCycleTime
{
  if (RtmCan_LiveMeasurementActive == RTMCAN_TRUE)
  {
    RtmCan_AverageMainFunctionCycleTime = @sysvar::XCP::Rtm::Rtm_AverageMainFunctionCycleTime;
    RtmCan_MeasurementDuration_us = ((RtmCan_AverageMainFunctionCycleTime * 1000) / RTMCAN_MEASUREMENT_FREQ_MS);
  }
} /* on sysvar_update sysvar::XCP::Rtm::Rtm_AverageMainFunctionCycleTime */

/**********************************************************************************************************************
  on sysvar_update sysvar::XCP::Rtm::Rtm_Resp
**********************************************************************************************************************/
/*!
 *
 *  \brief        Called by CANoe if the variable Rtm_Resp is updated on ECU and Xcp event Rtm_Evt is triggered.
 *  \details      According variable access and Xcp event triggering takes place within Rtm_MainFunction.
 *  \param[in]    -
 *  \return       -
 *  \pre          Called if value of Rtm_Resp is changed within ECU.
 *  \pre          Called by CANoe, if the variable Rtm_Resp is mapped to DAQ-Event Rtm_Evt.
 *  \synchronous  TRUE
 *  \ingroup      Callback
 *********************************************************************************************************************/
on sysvar_update sysvar::XCP::Rtm::Rtm_Resp
{
  long controlArray[(RTMCAN_MEASUREMENTS_COUNT-1)/8+1];
  dword i;
  dword resp;
  int uploadResult;

  resp = @sysvar::XCP::Rtm::Rtm_Resp;

  if ((resp & 0x60000000) == 0x60000000)
  {
    if (@sysvar::XCP::Rtm::Rtm_Cmd != 0x0)
    {
      @sysvar::XCP::Rtm::Rtm_Cmd = 0x0;
    }
    if (@sysvar::XCP::Rtm::Rtm_Resp != 0x0)
    {
      @sysvar::XCP::Rtm::Rtm_Resp = 0x0;
    }

    switch(RtmCan_GetRtmCanState())
    {
    case(RTMCAN_STATE_WAITFORACTION) :
    case(RTMCAN_STATE_BUSY) :
      break;

    case(RTMCAN_STATE_MEASURING) :
      if (RtmCan_LiveMeasurementActive == RTMCAN_TRUE)
      {
        if (RtmCan_StoppableMeasurementRunning == RTMCAN_FALSE)
        {
          if (RtmCan_LiveMeasurementCounter > 0)
          {
            RtmCan_LiveMeasurementCounter--;
          }
          else
          {
            RtmCan_LiveMeasurementActive = RTMCAN_FALSE;

            if (3 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
            {
              write("RtmCan Info @%lld: Live Measurement has finished.", timeNowInt64()/100);
            }

            _RtmCan_StateTransition(RTMCAN_EVENT_ACTIONFINISHED);

            /* Time limited live measurement finished. */
            Appl_RtmCanRespReceived(RTMCAN_STATE_MEASURING);
          }
        }
      }
      else
      {
        if (3 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
        {
          write("RtmCan Info @%lld: Sending has finished.", timeNowInt64()/100); 
        }
        /* Turn off all measurement points in ECU: */
        _RtmCan_TransmitCtrlArray(RTMCAN_TRUE);

        if (RtmCan_StoppableMeasurementRunning == RTMCAN_TRUE)
        {
          /* Upload data for Measurement Duration calculation, if Endless Measurement */
          xcpUpload("XCP::Rtm", "Rtm_AverageMainFunctionCycleTime");
          _RtmCan_WaitForUpload(1000);

          xcpUpload("XCP::Rtm", "Rtm_MainFunctionCounter");
          _RtmCan_WaitForUpload(1000);

          RtmCan_ExpectedUploads = RtmCan_ExpectedUploads + 2;
        }
        else
        {
          xcpUpload("XCP::Rtm", "Rtm_MeasTimeCorrection");
          _RtmCan_WaitForUpload(1000);

          RtmCan_ExpectedUploads++;
        }

        /* Request all results: */
        for (i = 0; i < RTMCAN_MEASUREMENTS_COUNT; i++)
        {
          if (RtmCan_MeasurementSectionActive[i] == RTMCAN_MP_STATE_ACTIVE)
          {
            long ret;
            if (RtmCan_LiveMeasurementActive == RTMCAN_TRUE)
            {
              snprintf(RtmCan_XcpUploadVariable_time, elcount(RtmCan_XcpUploadVariable_time), "Rtm_Results_%i_::time", i );
              snprintf(RtmCan_XcpUploadVariable_count, elcount(RtmCan_XcpUploadVariable_count), "Rtm_Results_%i_::count", i );

              ret  = xcpUpload("XCP::Rtm", RtmCan_XcpUploadVariable_time);
              _RtmCan_WaitForUpload(1000);
              ret |= xcpUpload("XCP::Rtm", RtmCan_XcpUploadVariable_count);
              _RtmCan_WaitForUpload(1000);

              if (ret != 0)
              {
                if (1 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
                {
                  write("RtmCan Error @%lld: Error while result uploading!", timeNowInt64()/100);
                }
              }
              else
              {
                RtmCan_ExpectedUploads += 2;
              }
            }
            else
            {
              snprintf(RtmCan_XcpUploadVariable_time, elcount(RtmCan_XcpUploadVariable_time), "Rtm_Results_%i_::time", i );
              snprintf(RtmCan_XcpUploadVariable_count, elcount(RtmCan_XcpUploadVariable_count), "Rtm_Results_%i_::count", i );
              snprintf(RtmCan_XcpUploadVariable_max, elcount(RtmCan_XcpUploadVariable_max), "Rtm_Results_%i_::max", i );
              snprintf(RtmCan_XcpUploadVariable_min, elcount(RtmCan_XcpUploadVariable_min), "Rtm_Results_%i_::min", i );

              ret  = xcpUpload("XCP::Rtm", RtmCan_XcpUploadVariable_time);
              _RtmCan_WaitForUpload(1000);
              ret |= xcpUpload("XCP::Rtm", RtmCan_XcpUploadVariable_count);
              _RtmCan_WaitForUpload(1000);
              ret |= xcpUpload("XCP::Rtm", RtmCan_XcpUploadVariable_max);
              _RtmCan_WaitForUpload(1000);
              ret |= xcpUpload("XCP::Rtm", RtmCan_XcpUploadVariable_min);
              _RtmCan_WaitForUpload(1000);

              if (ret != 0)
              {
                if (1 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
                {
                  write("RtmCan Error @%lld: Error while result uploading! Maybe Rtm_Results[] sysvars not set in XCP/CCP.", timeNowInt64()/100);
                }
              }
              else
              {
                RtmCan_ExpectedUploads += 4;
              }
            }
          }
        }

        /* If trigger reading is requested, indicate this to upper layer. */
        if ((resp & 0x80000000) == 0x80000000)
        {
          Appl_RtmCanTriggerReadingReceived();
        }

        _RtmCan_StateTransition(RTMCAN_EVENT_WAITINGFORUPLOAD);
      }
      break;

    case(RTMCAN_STATE_CLEARRESULTS) :
      _RtmCan_StateTransition(RTMCAN_EVENT_ACTIONFINISHED);

      /* The clear request was executed successfully. */
      Appl_RtmCanRespReceived(RTMCAN_STATE_CLEARRESULTS);
      break;

    default :
      if (1 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
      {
        write("RtmCan Error @%lld: invalid state of RtmCan!", timeNowInt64()/100);
      }
      break;
    }
  }
} /* on sysvar_update sysvar::XCP::Rtm::Rtm_Resp */


/**********************************************************************************************************************
  OnXcpUpload
**********************************************************************************************************************/
/*!
 *
 *  \brief        Stores the results of all active measurement points to global struture array RtmCan_Measurements.
 *  \details      Called by CANoe if the variable rtmNamespace::variable is updated with value from ECU.
 *  \param[in]    rtmNamespace            The namespace of the updated system variable.
 *  \param[in]    variable                The name of the updated system variable.
 *  \param[in]    errorIndication         Indicates if an error occured while updating.
 *  \return       -
 *  \pre          Only called by CANoe.
 *  \synchronous  TRUE
 *  \ingroup      Callback
 *********************************************************************************************************************/
void OnXcpUpload(char rtmNamespace[], char variable[], long errorIndication)
{
  dword i;
  long result;

  if (RtmCan_LiveMeasurementActive == RTMCAN_FALSE)
  {
    long stringLength;

    /* Reduce Bandwidth */
    _RtmCan_WaitForUpload(10000);

    if (3 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
    {
      write("RtmCan Info @%lld: Upload succeeded for: %s::%s", timeNowInt64()/100, rtmNamespace, variable);
    }

    stringLength = strlen("XCP::Rtm");
    /* If the rtmNamespace is not "XCP::Rtm" the xcp upload is not relevant for RtmCan. */
    if (strlen(rtmNamespace) < stringLength)
    {
      if (3 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
      {
        write("RtmCan Info @%lld: OnXcpUpload: The system variable namespace does not fit.", timeNowInt64()/100);
      }
    }
    else if (strncmp(rtmNamespace, "XCP::Rtm", stringLength) != 0)
    {
      if (3 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
      {
        write("RtmCan Info @%lld: OnXcpUpload: The system variable namespace does not fit.", timeNowInt64()/100);
      }
    }
    else if (RtmCan_ExpectedUploads == 0)
    {
      if (1 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
      {
        write("RtmCan Error @%lld: More uploads than expected!", timeNowInt64()/100);
      }
    }
    else
    {
      RtmCan_ExpectedUploads--;
      if (RtmCan_ExpectedUploads == 0)
      {
        for (i = 0; i < RTMCAN_MEASUREMENTS_COUNT; i++)
        {
          if (RtmCan_MeasurementSectionActive[i] == RTMCAN_MP_STATE_ACTIVE)
          {
            snprintf(RtmCan_XcpUploadVariable_time_receive, elcount(RtmCan_XcpUploadVariable_time_receive), "Rtm_Results_%i_::time", i );
            snprintf(RtmCan_XcpUploadVariable_count_receive, elcount(RtmCan_XcpUploadVariable_count_receive), "Rtm_Results_%i_::count", i );
            snprintf(RtmCan_XcpUploadVariable_max_receive, elcount(RtmCan_XcpUploadVariable_max_receive), "Rtm_Results_%i_::max", i );
            snprintf(RtmCan_XcpUploadVariable_min_receive, elcount(RtmCan_XcpUploadVariable_min_receive), "Rtm_Results_%i_::min", i );

            RtmCan_Measurements[i].MeasurementCount_current = SysGetVariableInt("XCP::Rtm", RtmCan_XcpUploadVariable_count_receive);
            RtmCan_Measurements[i].MeasurementTime_current = SysGetVariableInt("XCP::Rtm", RtmCan_XcpUploadVariable_time_receive);
            RtmCan_Measurements[i].MeasurementMax = SysGetVariableInt("XCP::Rtm", RtmCan_XcpUploadVariable_max_receive);
            RtmCan_Measurements[i].MeasurementMin = SysGetVariableInt("XCP::Rtm", RtmCan_XcpUploadVariable_min_receive);

            if (RtmCan_Measurements[i].MeasurementCount_current > 0)
            {
              if ((RtmCan_Measurements[i].MeasurementTime_current / RtmCan_Measurements[i].MeasurementCount_current) >  RtmCan_Measurements[i].MeasurementMax)
              {
                if (3 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
                {
                  write("RtmCan Info @%lld: OnXcpUpload: Average Runtime greater than Maximum Runtime!", timeNowInt64()/100);
                }
              }
              if ((RtmCan_Measurements[i].MeasurementTime_current / RtmCan_Measurements[i].MeasurementCount_current) <  RtmCan_Measurements[i].MeasurementMin)
              {
                if (3 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
                {
                  write("RtmCan Info @%lld: OnXcpUpload: Average Runtime smaller than Minimum Runtime!", timeNowInt64()/100);
                }
              }
            }

            if (RtmCan_Measurements[i].IsLetMP)
            {
              RtmCan_Measurements[i].LetError = (enum RtmCan_LetErrorType)SysGetVariableInt("XCP::Rtm", RtmCan_Measurements[i].LetErrorVar);
            }
          }
          /* Remove previous results of not executed MPs: */
          else
          {
            /* Only delete old measurement results if serial measurement mode is *not* active. */
            if (RtmCan_MeasurementSectionActive_Serial[0] == RTMCAN_MP_STATE_INACTIVE)
            {
              RtmCan_Measurements[i].MeasurementCount_current = 0;
              RtmCan_Measurements[i].MeasurementTime_current = 0;
              RtmCan_Measurements[i].MeasurementMax = 0;
              RtmCan_Measurements[i].MeasurementMin = (dword)0xFFFFFFFF;
              RtmCan_Measurements[i].LetError = RTMCAN_LET_ERROR_OK;
            }
          }
        }

        /* All measurement results are loaded successfully. */
        if (RtmCan_StoppableMeasurementRunning == RTMCAN_TRUE)
        {
          RtmCan_AverageMainFunctionCycleTime = @sysvar::XCP::Rtm::Rtm_AverageMainFunctionCycleTime;
          RtmCan_MainFunctionCounter = @sysvar::XCP::Rtm::Rtm_MainFunctionCounter;

          /* Calculation of overall measurement duration in micro seconds. */
          RtmCan_MeasurementDuration_us = (qword)((qword)RtmCan_AverageMainFunctionCycleTime * (qword)RtmCan_MainFunctionCounter);
          RtmCan_MeasurementDuration_us = ((RtmCan_MeasurementDuration_us * 1000) / RTMCAN_MEASUREMENT_FREQ_MS); /* Measurement Duration in us. */
        }

        _RtmCan_CalculateResults();

        /* If parallel measurement was active. */
        if (RtmCan_MeasurementSectionActive_Serial[0] == RTMCAN_MP_STATE_INACTIVE)
        {
          /* The measurement is finished. */
          _RtmCan_StateTransition(RTMCAN_EVENT_ACTIONFINISHED);

          Appl_RtmCanMeasurementFinished(); /* Callback: this function must be provided by Application. */
        }
        /* Otherwise, serial measurement is active, thus activate next MP and start measurement. */
        else
        {
          _RtmCan_StateTransition(RTMCAN_EVENT_MEASURING);

          /* If the last active measurement point was already executed.  */
          if (_RtmCan_StartNextSerialMeasurement() == RTMCAN_FALSE)
          {
            /* All serial measurements are executed and the measurement is finished. */
            _RtmCan_StateTransition(RTMCAN_EVENT_ACTIONFINISHED);

            Appl_RtmCanMeasurementFinished(); /* Callback: this function must be provided by Application. */
          }
        }
      }
    }
  }
} /* OnXcpUpload */

/*   ############################################################ */
/*   -> LIVE MEASUREMENT -> */

/**********************************************************************************************************************
  on sysvar_update sysvar::XCP::Rtm::Rtm_Results_4_::time
**********************************************************************************************************************/
/*!
 *
 *  \brief        Calculates runtime and CPU load of measurement point Appl_BackgroundTask (with ID 4).
 *  \details      Called each Rtm_MainFunction-Cycle.
 *  \param[in]    -
 *  \return       -
 *  \pre          New values are only calculated if count is already updated.
 *  \pre          Called by CANoe, if measurement point is mapped to DAQ-Event Rtm_Evt.
 *  \pre          Live measurement mode is active.
 *  \synchronous  TRUE
 *  \ingroup      Callback
 *********************************************************************************************************************/
on sysvar_update sysvar::XCP::Rtm::Rtm_Results_4_::time
{
  RtmCan_TimeCtr[4]++;
  if (RtmCan_LiveMeasurementActive == RTMCAN_TRUE)
  {
    if (RtmCan_MeasurementSectionActive[4] == RTMCAN_TRUE)
    {
      /* ESCAN00086290 */
      if (RtmCan_TimeCtr[4] == RtmCan_CountCtr[4])
      {
        RtmCan_Measurements[4].MeasurementCount_current = @sysvar::XCP::Rtm::Rtm_Results_4_::count;
        RtmCan_Measurements[4].MeasurementTime_current = @sysvar::XCP::Rtm::Rtm_Results_4_::time;

        if ( (RtmCan_Measurements[4].MeasurementTime_current != RtmCan_Measurements[4].MeasurementTime_last) ||
             (RtmCan_Measurements[4].MeasurementCount_current != RtmCan_Measurements[4].MeasurementCount_last) )
        {
          sysSetVariableFloat("RtmLive", "Appl_BackgroundTask_runtime", _RtmCan_CalculateRuntime(RtmCan_Measurements[4].ID));
          sysSetVariableFloat("RtmLive", "Appl_BackgroundTask_cpuload", _RtmCan_CalculateCpuLoad(RtmCan_Measurements[4].ID, RtmCan_Measurements[4].MeasurementRuntime));

          _RtmCan_StoreLastResults(RtmCan_Measurements[4].ID);
        }
      }
    }
  }
} /* on sysvar_update sysvar::XCP::Rtm::Rtm_Results_4_::time */


