/**********************************************************************************************************************
  _RtmCan_InitMeasurementConfig
**********************************************************************************************************************/
/*!
 *
 *  \brief        Initializes the measurement config array.
 *  \details      Each bit in the measurement configuration array represents one MP. If the bit is set to 1, the MP is
 *                active in the ECU. This function deactivates all MPs.
 *  \param[in]    -
 *  \return       -
 *  \pre          -
 *  \synchronous  TRUE
 *  \ingroup      Internal
 *********************************************************************************************************************/
void _RtmCan_InitMeasurementConfig()
{
  int i;

  for(i = 0; i < RTMCAN_CONFIG_ARRAY_SIZE; i++)
  {
    RtmCan_MeasurementConfigArray[i] = 0;
  }
} /* _RtmCan_InitMeasurementConfig */


/**********************************************************************************************************************
  _RtmCan_InitMeasurementPointState
**********************************************************************************************************************/
/*!
 *
 *  \brief        Initializes the measurement point states to inactive.
 *  \details      Deactivates all measurement points locally in RtmCan.
 *  \param[in]    -
 *  \return       -
 *  \pre          -
 *  \synchronous  TRUE
 *  \ingroup      Internal
 *********************************************************************************************************************/
void _RtmCan_InitMeasurementPointState()
{
  dword i;

  /* The overhead MPs are always active. All others are initially inactive. */
  for (i = 0; i < RTMCAN_MEASUREMENTS_COUNT; i++)
  {
    RtmCan_MeasurementSectionActive_Serial[i] = RTMCAN_MP_STATE_INACTIVE;

    if (i < RTMCAN_NUMBER_OF_OVERHEAD_MPS)
    {
      RtmCan_MeasurementSectionActive[i] = RTMCAN_MP_STATE_ACTIVE;
    }
    else
    {
      RtmCan_MeasurementSectionActive[i] = RTMCAN_MP_STATE_INACTIVE;
    }
  }
} /* _RtmCan_InitMeasurementPointState */

