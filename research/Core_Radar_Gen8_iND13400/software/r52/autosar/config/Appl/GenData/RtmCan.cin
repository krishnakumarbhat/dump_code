/**********************************************************************************************************************
  RtmCan_GetRtmCanState
**********************************************************************************************************************/
/*!
 *
 *  \brief        Returns the current state of RtmCan.
 *  \details      Returns the current state of RtmCan.
 *  \param[in]    -
 *  \return       RTMCAN_STATE_UNINIT        The RtmCan must be initialized.
 *  \return       RTMCAN_STATE_WAITFORACTION The RtmCan is ready for action.
 *  \return       RTMCAN_STATE_BUSY          The RtmCan is busy.
 *  \return       RTMCAN_STATE_MEASURING       The RtmCan is measuring and sending the results.
 *  \return       RTMCAN_STATE_CLEARRESULTS  The RtmCan is clears the measurement results on the ECU.
 *  \pre          The RtmCan is not busy.
 *  \synchronous  TRUE
 *  \ingroup      External
 *********************************************************************************************************************/
enum RtmCan_StateType RtmCan_GetRtmCanState()
{
  return RtmCan_State;
} /* RtmCan_GetRtmCanState */


/**********************************************************************************************************************
  RtmCan_GenerateReport
**********************************************************************************************************************/
/*!
 *
 *  \brief        Generates the requested report containing all active MPs.
 *  \details      Creates *.csv reports.
 *  \param[in]    reportVariant              Specifies which report type is generated.
 *  \return       RTMCAN_E_OK                The report generation was successful.
 *  \return       RTMCAN_E_INTERFACE_IS_BUSY The report generation was rejected because the RtmCan is busy.
 *  \return       RTMCAN_E_INVALID_EVENT     RtmCan is in invalid state for this event.
 *  \return       RTMCAN_E_INVALID_STATE     RtmCan is in invalid state.
 *  \pre          The RtmCan is not busy.
 *  \synchronous  TRUE
 *  \ingroup      External
 *********************************************************************************************************************/
enum RtmCan_ReturnValueType RtmCan_GenerateReport(
  enum RtmCan_ReportVariantType reportVariant,
  enum RtmCan_Boolean intermediate)
{
  enum RtmCan_ReturnValueType retVal;
  struct RtmCan_ResultType resultMP;
  int i;
  int j;
  int precision;
  enum RtmCan_Boolean proceedWritingCsv;
  File resultCsv;
  File runnableResultCsv;
  File letCsv;
  char lineBuffer[1024];
  qword measDuration;

  measDuration = 0;

  /* Specify precision: */
  precision = 2;

  if ((RtmCan_GetRtmCanState() == RTMCAN_STATE_WAITFORACTION)
   || (intermediate == RTMCAN_TRUE))
  {
    if (intermediate == RTMCAN_FALSE)
    {
      retVal = _RtmCan_StateTransition(RTMCAN_EVENT_GENERATEREPORT);
    }

    proceedWritingCsv = RTMCAN_TRUE;

    if ((reportVariant == RTMCAN_REPORT_RUNNABLE_CSV) || (reportVariant == RTMCAN_REPORT_ALL))
    {
      char currentDateAndTime[64];
      getLocalTimeString(currentDateAndTime);

      str_replace(currentDateAndTime," ","_");
      str_replace(currentDateAndTime,":","");

      /* If trigger reading is active, generate report with time infix.
       * Otherwise, generate default report without infix. */
      if (intermediate == RTMCAN_TRUE)
      {
        Snprintf(lineBuffer, elCount(lineBuffer), "runnableReport_%s.csv", currentDateAndTime);
      }
      else
      {
        Snprintf(lineBuffer, elCount(lineBuffer), "runnableReport.csv");
      }

      /* generate RunnableReport for TA: */
      runnableResultCsv.open(lineBuffer, 0, 0);

      Snprintf(lineBuffer, elCount(lineBuffer), "application type;name;reference;order;read;write;avg. exec. Time [us];min. exec. time [us];max. exec. time [us]\n");
      if (1 != runnableResultCsv.putString(lineBuffer, elcount(lineBuffer)))
      {
        proceedWritingCsv = RTMCAN_FALSE;
      }
      else
      {
        for (i = RTMCAN_NUMBER_OF_OVERHEAD_MPS; i < RTMCAN_MEASUREMENTS_COUNT; i++)
        {
          _RtmCan_ReturnResultsByMPID(i, resultMP);

          if (RtmCan_MeasurementSectionActive[i] == RTMCAN_TRUE)
          {
            if (RtmCan_Measurements[i].IsRunnableMP == RTMCAN_TRUE)
            {
              snprintf(lineBuffer, elCount(lineBuffer), "%s;%s;%s;%s;%s;%s;%.*f;%.*f;%.*f\n",
                "Runnable",
                resultMP.RtmCan_Result_Name,
                "",
                "",
                "",
                "",
                precision, resultMP.RtmCan_Result_AverageRuntime_us,
                precision, resultMP.RtmCan_Result_MinRuntime_us,
                precision, resultMP.RtmCan_Result_MaxRuntime_us
              );

              str_replace(lineBuffer,".",",");
              write(lineBuffer);
              if (runnableResultCsv.putString(lineBuffer, elcount(lineBuffer)) != 1)
              {
                if (1 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
                {
                  write("RtmCan Error @%lld: Error writing .CSV-report", timeNowInt64()/100);
                }

                proceedWritingCsv = RTMCAN_FALSE;
                i = RTMCAN_MEASUREMENTS_COUNT;
              }
            }

            if (measDuration == 0)
            {
              measDuration = resultMP.RtmCan_Result_MeasurementDuration_us;
            }
          }
        }
      }
      runnableResultCsv.close();
    }

    /* LET REPORT */
    if ((reportVariant == RTMCAN_REPORT_LET_CSV) || (reportVariant == RTMCAN_REPORT_ALL))
    {
      char currentDateAndTime[64];
      getLocalTimeString(currentDateAndTime);

      str_replace(currentDateAndTime," ","_");
      str_replace(currentDateAndTime,":","");

      /* If trigger reading is active, generate report with time infix.
       * Otherwise, generate default report without infix. */
      if (intermediate == RTMCAN_TRUE)
      {
        Snprintf(lineBuffer, elCount(lineBuffer), "Report_LET_%s.csv", currentDateAndTime);
      }
      else
      {
        Snprintf(lineBuffer, elCount(lineBuffer), "Report_LET.csv");
      }

      /* Generate LET report: */
      letCsv.open(lineBuffer, 0, 0);

      proceedWritingCsv = RTMCAN_TRUE;

      while (proceedWritingCsv == RTMCAN_TRUE)
      {
        Snprintf(lineBuffer, elCount(lineBuffer), "Measurement;Max (us);LET interval (us);Relative remaining (%%);LET Error\n");
        if (1 != letCsv.putString(lineBuffer, elcount(lineBuffer)))
        {
          proceedWritingCsv = RTMCAN_FALSE;
          continue;
        }

        for (i = RTMCAN_NUMBER_OF_OVERHEAD_MPS; i < RTMCAN_MEASUREMENTS_COUNT; i++)
        {
          if ((RtmCan_MeasurementSectionActive[i] == RTMCAN_TRUE)
           && (RtmCan_Measurements[i].IsLetMP == RTMCAN_TRUE)
           && (RtmCan_Measurements[i].TargetRuntime > 0))
          {
            dword targetRuntime;
            char mpType[50];
            char letError[50];
            _RtmCan_ReturnResultsByMPID(i, resultMP);

            /* Prepare MP type as string. */
            if (resultMP.RtmCan_Result_MP_Type == RTMCAN_MP_TYPE_GROSS_EXECUTIONTIME)
            {
              strncpy(mpType, "GrossExecutionTime", elcount(mpType));
            }
            else if (resultMP.RtmCan_Result_MP_Type == RTMCAN_MP_TYPE_FLAT_EXECUTIONTIME)
            {
              strncpy(mpType, "FlatExecutionTime", elcount(mpType));
            }
            else if (resultMP.RtmCan_Result_MP_Type == RTMCAN_MP_TYPE_NET_EXECUTIONTIME)
            {
              strncpy(mpType, "NetExecutionTime", elcount(mpType));
            }
            else
            {
              mpType[0] = '\0';
            }

            /* Prepare MP type as string. */
            if (RtmCan_Measurements[i].LetError == RTMCAN_LET_ERROR_OK)
            {
              strncpy(letError, "RTMCAN_LET_ERROR_OK", elcount(letError));
            }
            else if (RtmCan_Measurements[i].LetError == RTMCAN_LET_ERROR_INTERVAL_EXCEEDED)
            {
              strncpy(letError, "RTMCAN_LET_ERROR_INTERVAL_EXCEEDED", elcount(letError));
            }
            else if (RtmCan_Measurements[i].LetError == RTMCAN_LET_ERROR_UNEXPECTED_RELEASE)
            {
              strncpy(letError, "RTMCAN_LET_ERROR_UNEXPECTED_RELEASE", elcount(letError));
            }
            else if (RtmCan_Measurements[i].LetError == RTMCAN_LET_ERROR_UNEXPECTED_TERMINATE)
            {
              strncpy(letError, "RTMCAN_LET_ERROR_UNEXPECTED_TERMINATE", elcount(letError));
            }
            else if (RtmCan_Measurements[i].LetError == RTMCAN_LET_ERROR_UNEXPECTED_RUNNABLE_EXECUTION)
            {
              strncpy(letError, "RTMCAN_LET_ERROR_UNEXPECTED_RUNNABLE_EXECUTION", elcount(letError));
            }

            targetRuntime = RtmCan_Measurements[i].TargetRuntime;

            snprintf(lineBuffer, elCount(lineBuffer), "%s;%.*f;%i;%.*f;%s;\n",
              resultMP.RtmCan_Result_Name,
              precision, resultMP.RtmCan_Result_MaxRuntime_us,
              targetRuntime,
              1, resultMP.RtmCan_Result_RelativeRemaining_percent,
              letError
            );

            if (measDuration == 0)
            {
              measDuration = resultMP.RtmCan_Result_MeasurementDuration_us;
            }

            str_replace(lineBuffer,".",",");
            write(lineBuffer);
            if (1 != letCsv.putString(lineBuffer, elcount(lineBuffer)))
            {
              if (1 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
              {
                write("RtmCan Error @%lld: Error writing .CSV-report", timeNowInt64()/100);
              }

              proceedWritingCsv = RTMCAN_FALSE;
              i = RTMCAN_MEASUREMENTS_COUNT;
            }
          }
        }
        proceedWritingCsv = RTMCAN_FALSE;
      }

      letCsv.close();
    }

    /* OVERALL REPORT */
    if ((reportVariant == RTMCAN_REPORT_OVERALL_CSV) || (reportVariant == RTMCAN_REPORT_ALL))
    {
      char currentDateAndTime[64];
      getLocalTimeString(currentDateAndTime);

      str_replace(currentDateAndTime," ","_");
      str_replace(currentDateAndTime,":","");

      /* If trigger reading is active, generate report with time infix.
       * Otherwise, generate default report without infix. */
      if (intermediate == RTMCAN_TRUE)
      {
        Snprintf(lineBuffer, elCount(lineBuffer), "report_%s.csv", currentDateAndTime);
      }
      else
      {
        Snprintf(lineBuffer, elCount(lineBuffer), "report.csv");
      }

      /* Generate results report: */
      resultCsv.open(lineBuffer, 0, 0);

      proceedWritingCsv = RTMCAN_TRUE;

      while (proceedWritingCsv == RTMCAN_TRUE)
      {
        Snprintf(lineBuffer, elCount(lineBuffer), "Measurement;MeasurementGroup;MP Type;count;max (us);min (us);average (us);overall cpuload (%%);core ID;relative max (%%)\n");
        if (1 != resultCsv.putString(lineBuffer, elcount(lineBuffer)))
        {
          proceedWritingCsv = RTMCAN_FALSE;
          continue;
        }

        for (i = RTMCAN_NUMBER_OF_OVERHEAD_MPS; i < RTMCAN_MEASUREMENTS_COUNT; i++)
        {
          if (RTMCAN_TRUE == RtmCan_MeasurementSectionActive[i])
          {
            char mpType[50];
            _RtmCan_ReturnResultsByMPID(i, resultMP);

            /* Prepare MP type as string. */
            if (resultMP.RtmCan_Result_MP_Type == RTMCAN_MP_TYPE_GROSS_EXECUTIONTIME)
            {
              strncpy(mpType, "GrossExecutionTime", elcount(mpType));
            }
            else if (resultMP.RtmCan_Result_MP_Type == RTMCAN_MP_TYPE_FLAT_EXECUTIONTIME)
            {
              strncpy(mpType, "FlatExecutionTime", elcount(mpType));
            }
            else if (resultMP.RtmCan_Result_MP_Type == RTMCAN_MP_TYPE_NET_EXECUTIONTIME)
            {
              strncpy(mpType, "NetExecutionTime", elcount(mpType));
            }
            else
            {
              mpType[0] = '\0';
            }

            if (resultMP.RtmCan_Result_AssignedToCore < RTMCAN_NUMBER_OF_CORES)
            {
              if ((resultMP.RtmCan_Result_MP_Type == RTMCAN_MP_TYPE_GROSS_EXECUTIONTIME)
               && (resultMP.RtmCan_Result_ID != RTMCAN_INDEX_OF_CPU_LOAD))
              {
                snprintf(lineBuffer, elCount(lineBuffer), "%s;%s;%s;%d;%.*f;%.*f;%.*f;%s;%d;%.*f;\n",
                  resultMP.RtmCan_Result_Name,
                  resultMP.RtmCan_Result_Group,
                  mpType,
                  resultMP.RtmCan_Result_NumberOfExecution,
                  precision, resultMP.RtmCan_Result_MaxRuntime_us,
                  precision, resultMP.RtmCan_Result_MinRuntime_us,
                  precision, resultMP.RtmCan_Result_AverageRuntime_us,
                  "-",
                  resultMP.RtmCan_Result_AssignedToCore,
                  1, resultMP.RtmCan_Result_RelativeMax_percent
                );
              }
              else
              {
                snprintf(lineBuffer, elCount(lineBuffer), "%s;%s;%s;%d;%.*f;%.*f;%.*f;%.*f;%d;%.*f;\n",
                  resultMP.RtmCan_Result_Name,
                  resultMP.RtmCan_Result_Group,
                  mpType,
                  resultMP.RtmCan_Result_NumberOfExecution,
                  precision, resultMP.RtmCan_Result_MaxRuntime_us,
                  precision, resultMP.RtmCan_Result_MinRuntime_us,
                  precision, resultMP.RtmCan_Result_AverageRuntime_us,
                  1, resultMP.RtmCan_Result_CpuLoad,
                  resultMP.RtmCan_Result_AssignedToCore,
                  1, resultMP.RtmCan_Result_RelativeMax_percent
                );
              }
            }
            else
            {
              if ((resultMP.RtmCan_Result_MP_Type == RTMCAN_MP_TYPE_GROSS_EXECUTIONTIME)
               && (resultMP.RtmCan_Result_ID != RTMCAN_INDEX_OF_CPU_LOAD))
              {
                snprintf(lineBuffer, elCount(lineBuffer), "%s;%s;%s;%d;%.*f;%.*f;%.*f;%s;%s;%.*f;\n",
                  resultMP.RtmCan_Result_Name,
                  resultMP.RtmCan_Result_Group,
                  mpType,
                  resultMP.RtmCan_Result_NumberOfExecution,
                  precision, resultMP.RtmCan_Result_MaxRuntime_us,
                  precision, resultMP.RtmCan_Result_MinRuntime_us,
                  precision, resultMP.RtmCan_Result_AverageRuntime_us,
                  "-",
                  "-",
                  1, resultMP.RtmCan_Result_RelativeMax_percent
                );
              }
              else
              {
                snprintf(lineBuffer, elCount(lineBuffer), "%s;%s;%s;%d;%.*f;%.*f;%.*f;%.*f;%s;%.*f;\n",
                  resultMP.RtmCan_Result_Name,
                  resultMP.RtmCan_Result_Group,
                  mpType,
                  resultMP.RtmCan_Result_NumberOfExecution,
                  precision, resultMP.RtmCan_Result_MaxRuntime_us,
                  precision, resultMP.RtmCan_Result_MinRuntime_us,
                  precision, resultMP.RtmCan_Result_AverageRuntime_us,
                  1, resultMP.RtmCan_Result_CpuLoad,
                  "-",
                  1, resultMP.RtmCan_Result_RelativeMax_percent
                );
              }
            }

            if (measDuration == 0)
            {
              measDuration = resultMP.RtmCan_Result_MeasurementDuration_us;
            }

            str_replace(lineBuffer,".",",");
            write(lineBuffer);
            if (1 != resultCsv.putString(lineBuffer, elcount(lineBuffer)))
            {
              if (1 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
              {
                write("RtmCan Error @%lld: Error writing .CSV-report", timeNowInt64()/100);
              }

              proceedWritingCsv = RTMCAN_FALSE;
              i = RTMCAN_MEASUREMENTS_COUNT;
            }
          }
        }
        proceedWritingCsv = RTMCAN_FALSE;
      }

      snprintf(lineBuffer, elCount(lineBuffer), "\nMeasurement Duration (us);%d;\n", (measDuration));

      str_replace(lineBuffer,".",",");
      write(lineBuffer);

      if (1 != resultCsv.putString(lineBuffer, elcount(lineBuffer)))
      {
        if (1 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
        {
          write("RtmCan Error @%lld: Error writing .CSV-report", timeNowInt64()/100);
        }

        proceedWritingCsv = RTMCAN_FALSE;
        i = RTMCAN_MEASUREMENTS_COUNT;
      }

      if (RtmCan_ActiveMeasurementMode == RTMCAN_MODE_SERIAL)
      {
        snprintf(lineBuffer, elCount(lineBuffer), "\nMeasurement Mode;RTMCAN_MODE_SERIAL;\n");
      }
      else if (RtmCan_ActiveMeasurementMode == RTMCAN_MODE_PARALLEL)
      {
        snprintf(lineBuffer, elCount(lineBuffer), "\nMeasurement Mode;RTMCAN_MODE_PARALLEL;\n");
      }
      else
      {
        snprintf(lineBuffer, elCount(lineBuffer), "\nMeasurement Mode;RTMCAN_MODE_LIVE;\n");
      }

      str_replace(lineBuffer,".",",");
      write(lineBuffer);

      if (1 != resultCsv.putString(lineBuffer, elcount(lineBuffer)))
      {
        if (1 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
        {
          write("RtmCan Error @%lld: Error writing .CSV-report", timeNowInt64()/100);
        }

        proceedWritingCsv = RTMCAN_FALSE;
        i = RTMCAN_MEASUREMENTS_COUNT;
      }

      resultCsv.close();
    }

    if ((retVal == RTMCAN_E_OK)
     && (intermediate == RTMCAN_FALSE))
    {
      retVal = _RtmCan_StateTransition(RTMCAN_EVENT_ACTIONFINISHED);
    }
  }
  else
  {
    if (2 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
    {
      write("RtmCan Warning @%lld: RtmCan_GenerateReport: failed to generate report because RtmCan is busy.", timeNowInt64()/100);
    }
    retVal = RTMCAN_E_INTERFACE_IS_BUSY;
  }

  return retVal;
} /* RtmCan_GenerateReport */


/**********************************************************************************************************************
  RtmCan_GetMPResultByName
**********************************************************************************************************************/
/*!
 *
 *  \brief        Returns the results of one MP, identified by the MP's name.
 *  \details      Searches for specified name in all measurement points.
 *  \param[in]    measPointName              The name of the measurement point.
 *  \param[out]   result                     A structure containing the results of the specified measurement point.
 *  \return       RTMCAN_E_OK                The result request was successful.
 *  \return       RTMCAN_E_INTERFACE_IS_BUSY The result request was rejected because the RtmCan is busy.
 *  \return       RTMCAN_E_NO_MATCH_FOUND    The requested measurement point does not exist.
 *  \pre          The RtmCan is not busy.
 *  \synchronous  TRUE
 *  \ingroup      External
 *  \note         The names must be equal.
 *********************************************************************************************************************/
enum RtmCan_ReturnValueType RtmCan_GetMPResultByName(char measPointName[], struct RtmCan_ResultType result)
{
  enum RtmCan_ReturnValueType retVal;
  enum RtmCan_Boolean ready;
  dword i;
  dword mpIndex;

  mpIndex = 0;

  /* If the RtmCan is in valid state: */
  if (RtmCan_GetRtmCanState() == RTMCAN_STATE_WAITFORACTION)
  {
    _RtmCan_StateTransition(RTMCAN_EVENT_GETRESULT);
    ready = RTMCAN_FALSE;

    /* Look for measurement points with *measPointName in their name: */
    for (i = RTMCAN_NUMBER_OF_OVERHEAD_MPS; (i < RTMCAN_MEASUREMENTS_COUNT) && (ready == RTMCAN_FALSE); i++)
    {
      /* If the specified name is equal to one registered measurement point: */
      if (strlen(measPointName) == strlen(RtmCan_Measurements[i].Name))
      {
        if (strncmp(RtmCan_Measurements[i].Name, measPointName, strlen(measPointName)) == 0)
        {
          /* The search was successful. */
          ready = RTMCAN_TRUE;
          mpIndex = i;
        }
      }
    }

    /* If the measurement point was found: */
    if (ready == RTMCAN_TRUE)
    {
      /* Set the according results. */
      _RtmCan_SetResult(result, RTMCAN_FALSE, mpIndex);

      retVal = RTMCAN_E_OK;
    }
    /* Otherwise, the specified measurement point name does not exist. */
    else
    {
      _RtmCan_SetResult(result, RTMCAN_TRUE, 0);

      retVal = RTMCAN_E_NO_MATCH_FOUND;
    }

    _RtmCan_StateTransition(RTMCAN_EVENT_ACTIONFINISHED);
  }
  /* Otherwise, RtmCan is busy. */
  else
  {
    _RtmCan_SetResult(result, RTMCAN_TRUE, 0);

    if (2 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
    {
      write("RtmCan Warning @%lld: Get Results by name failed because RtmCan is busy.", timeNowInt64()/100);
    }
    retVal = RTMCAN_E_INTERFACE_IS_BUSY;
  }

  return retVal;
} /* RtmCan_GetMPResultByName */


/**********************************************************************************************************************
  RtmCan_GetMPResultByID
**********************************************************************************************************************/
/*!
 *
 *  \brief        Returns the results of one MPs, identified by the MP's ID.
 *  \details      Searches for specified ID in all measurement points.
 *  \param[in]    measPointID                The ID of the measurement point.
 *  \param[out]   result                     A structure containing the results of the specified measurement point.
 *  \return       RTMCAN_E_OK                The result request was successful.
 *  \return       RTMCAN_E_INTERFACE_IS_BUSY The result request was rejected because the RtmCan is busy.
 *  \return       RTMCAN_E_NO_MATCH_FOUND    The requested measurement point does not exist.
 *  \pre          The RtmCan is not busy.
 *  \synchronous  TRUE
 *  \ingroup      External
 *********************************************************************************************************************/
enum RtmCan_ReturnValueType RtmCan_GetMPResultByID(dword measPointID, struct RtmCan_ResultType result)
{
  enum RtmCan_ReturnValueType retVal;

  /* If the RtmCan is in valid state: */
  if (RtmCan_GetRtmCanState() == RTMCAN_STATE_WAITFORACTION)
  {
    _RtmCan_StateTransition(RTMCAN_EVENT_GETRESULT);

    /* Get results of this measurement point if available. */
    retVal = _RtmCan_ReturnResultsByMPID(measPointID, result);

    _RtmCan_StateTransition(RTMCAN_EVENT_ACTIONFINISHED);
  }
  /* Otherwise, RtmCan is busy. */
  else
  {
    _RtmCan_SetResult(result, RTMCAN_TRUE, 0);

    if (2 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
    {
      write("RtmCan Warning @%lld: Get Results by ID failed because RtmCan is busy.", timeNowInt64()/100);
    }
    retVal = RTMCAN_E_INTERFACE_IS_BUSY;
  }

  return retVal;
} /* RtmCan_GetMPResultByID */



/**********************************************************************************************************************
  RtmCan_ResetRtmCanState
**********************************************************************************************************************/
/*!
 *
 *  \brief        Resets the RtmCan state.
 *  \details      Searches for specified ID in all measurement points.
 *  \param[in]    -
 *  \return       RTMCAN_E_OK                The reset request was successful.
 *  \pre          -
 *  \synchronous  TRUE
 *  \ingroup      External
 *********************************************************************************************************************/
enum RtmCan_ReturnValueType RtmCan_ResetRtmCanState()
{
  /* If current state is sending and stoppable measurement is running: */
  if (RtmCan_GetRtmCanState() == RTMCAN_STATE_MEASURING)
  {
    if (RtmCan_StoppableMeasurementRunning == RTMCAN_TRUE)
    {
      /* Send command to stop the measurement. */
      _RtmCan_TransmitEcuCommand(_RtmCan_BuildEcuCommand(RTMCAN_CMD_STOP, 0));
    }
  }

  _RtmCan_InitData();
  _RtmCan_InitMeasurementPointState();
  _RtmCan_InitMeasurementConfig();

  RtmCan_State = RTMCAN_STATE_WAITFORACTION;

  if (3 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
  {
    write("RtmCan Info @%lld: Reset the RtmCan State.", timeNowInt64()/100);
    write("RtmCan_State == RTMCAN_STATE_WAITFORACTION");
  }

  return RTMCAN_E_OK;
}


/**********************************************************************************************************************
  RtmCan_SetDebugLevel
**********************************************************************************************************************/
/*!
 *
 *  \brief        Sets the debug level system variable of RtmCan and Rtm_Canoe.
 *  \details      Creates the system variable if the variable does not already exist.
 *  \param[in]    debugLevel                 The new value for the Rtm_DebugLevel.
 *  \return       RTMCAN_E_OK                The set of debug level was successful.
 *  \pre          -
 *  \synchronous  TRUE
 *  \ingroup      External
 *********************************************************************************************************************/
enum RtmCan_ReturnValueType RtmCan_SetDebugLevel(enum RtmCan_DebugLevelType debugLevel)
{
  long val;

  /* If system variable Rtm_DebugLevel does not exist: */
  if (sysGetVariableInt("Rtm", "Rtm_DebugLevel", val) != 0)
  {
    /* Create variable and set to specified value. */
    write("Define system variable Rtm_DebugLevel.");
    SysDefineNamespace("Rtm");
    sysDefineVariableInt("Rtm", "Rtm_DebugLevel", debugLevel);
  }
  /* Otherwise, set the new value to system variable. */
  else
  {
    sysSetVariableInt("Rtm", "Rtm_DebugLevel", debugLevel);
  }

  if (3 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
  {
    write("RtmCan Info @%lld: System variable Rtm_DebugLevel set to new value %d.", timeNowInt64()/100, (int)debugLevel);
  }

  return RTMCAN_E_OK;
} /* RtmCan_SetDebugLevel */

/* <- COMMON APIs */
/* ############################################################ */


/* ############################################################ */
/* MEASUREMENT CONTROL -> */

/**********************************************************************************************************************
  RtmCan_ClearResults
**********************************************************************************************************************/
/*!
 *
 *  \brief        Requests the deletion of all measurement results on the ECU.
 *  \details      Clears all measurement results in RtmCan.
 *  \param[in]    -
 *  \return       RTMCAN_E_OK                The clearing of measurement results was requested successfully.
 *  \return       RTMCAN_E_INTERFACE_IS_BUSY The clearing of measurement results was rejected because the RtmCan is
 *                                           busy.
 *  \return       RTMCAN_E_INVALID_EVENT     RtmCan is in invalid state for this event.
 *  \return       RTMCAN_E_INVALID_STATE     RtmCan is in invalid state.
 *  \pre          The RtmCan is not busy.
 *  \synchronous  TRUE
 *  \ingroup      External
 *********************************************************************************************************************/
enum RtmCan_ReturnValueType RtmCan_ClearResults()
{
  enum RtmCan_ReturnValueType retVal;

  if (RtmCan_GetRtmCanState() == RTMCAN_STATE_WAITFORACTION)
  {
    if (3 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
    {
      write("RtmCan Info @%lld: Clear measurement results on ECU and RtmCan.", timeNowInt64()/100);
    }
    _RtmCan_TransmitEcuCommand(_RtmCan_BuildEcuCommand(RTMCAN_CMD_CLEAR, 0));

    _RtmCan_InitData();
    retVal = _RtmCan_StateTransition(RTMCAN_EVENT_CLEARRESULTS);
  }
  else
  {
    if (2 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
    {
      write("RtmCan Warning @%lld: Clear results failed because Rtm CANoe is busy.", timeNowInt64()/100);
    }
    retVal = RTMCAN_E_INTERFACE_IS_BUSY;
  }

  return retVal;
} /* RtmCan_ClearResults */


/**********************************************************************************************************************
  RtmCan_ClearAll
**********************************************************************************************************************/
/*!
 *
 *  \brief        Requests the deletion of all measurement results on the ECU.
 *  \details      Clears all measurement results in RtmCan.
 *  \param[in]    -
 *  \return       RTMCAN_E_OK                The clearing of measurement results was requested successfully.
 *  \return       RTMCAN_E_INTERFACE_IS_BUSY The clearing of measurement results was rejected because the RtmCan is
 *                                           busy.
 *  \return       RTMCAN_E_INVALID_EVENT     RtmCan is in invalid state for this event.
 *  \return       RTMCAN_E_INVALID_STATE     RtmCan is in invalid state.
 *  \pre          The RtmCan is not busy.
 *  \synchronous  TRUE
 *  \ingroup      External
 *********************************************************************************************************************/
enum RtmCan_ReturnValueType RtmCan_ClearAll()
{
  enum RtmCan_ReturnValueType retVal;

  if (RtmCan_GetRtmCanState() == RTMCAN_STATE_WAITFORACTION)
  {
    if (3 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
    {
      write("RtmCan Info @%lld: Clear results on ECU, on RtmCan and complete config in RtmCan.", timeNowInt64()/100);
    }
    _RtmCan_TransmitEcuCommand(_RtmCan_BuildEcuCommand(RTMCAN_CMD_CLEAR, 0));

    _RtmCan_InitData();
    _RtmCan_InitMeasurementPointState();
    _RtmCan_InitMeasurementConfig();
    retVal = _RtmCan_StateTransition(RTMCAN_EVENT_CLEARRESULTS);
  }
  else
  {
    if (2 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
    {
      write("RtmCan Warning @%lld: Clear results failed because Rtm CANoe is busy.", timeNowInt64()/100);
    }
    retVal = RTMCAN_E_INTERFACE_IS_BUSY;
  }

  return retVal;
} /* RtmCan_ClearAll */


/**********************************************************************************************************************
  RtmCan_StartMeasurement
**********************************************************************************************************************/
/*!
 *
 *  \brief        Starts the measurement of all activated MPs in the specified measurement mode.
 *  \details      If the specified measurement duration is too short, it is set to 0 (endless measurement duration).
 *  \param[in]    measMode                   The measurement mode (serial, parallel or live).
 *  \param[in]    timeToMeas                 The measurement duration in milliseconds. If set to 0, endless
 *                                           measurement is started.
 *  \return       RTMCAN_E_OK                The start of new measurement was successful.
 *  \return       RTMCAN_E_INTERFACE_IS_BUSY The start of new measurement was rejected because the RtmCan is busy.
 *  \return       RTMCAN_E_INVALID_EVENT     RtmCan is in invalid state for this event.
 *  \return       RTMCAN_E_INVALID_STATE     RtmCan is in invalid state.
 *  \return       RTMCAN_E_NOT_AVAILABLE_WITH_16BIT_COUNTER The endless measurement mode is not available.
 *  \return       RTMCAN_E_NOT_AVAILABLE_IN_MULTICORE_SYSTEM Live measurment is not available in multi core system.
 *  \return       RTMCAN_E_NOT_SUPPORTED     Serial mode does not support endless measurement.
 *  \pre          The RtmCan is not busy.
 *  \synchronous  TRUE
 *  \ingroup      External
 *  \note         The combination serial measurement mode and endless measurement duration is not allowed.
 *********************************************************************************************************************/
enum RtmCan_ReturnValueType RtmCan_StartMeasurement(enum RtmCan_MeasurementModeType measMode, dword timeToMeas)
{
  enum RtmCan_ReturnValueType retVal;
  enum RtmCan_MeasurementCommandType command;

  /* If the RtmCan is in valid state: */
  if (RtmCan_GetRtmCanState() == RTMCAN_STATE_WAITFORACTION)
  {
    long controlArray[(RTMCAN_MEASUREMENTS_COUNT-1)/8+1];
    dword i;

    /* If 16 bit counter is used and endless measurement mode is requested: */
    if ((RTMCAN_32BIT_COUNTER == 0) && ((timeToMeas / RTMCAN_MAINFUNCTIONCYCLETIME_MS) < 2))
    {
      if (2 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
      {
        write("RtmCan Warning @%lld: Endless measurment cannot be started with 16 bit counter.", timeNowInt64()/100);
      }
      /* Invalid request because the measurement duration cannot be determined. */
      retVal = RTMCAN_E_NOT_AVAILABLE_WITH_16BIT_COUNTER;
    }
    else
    {
      retVal = _RtmCan_StateTransition(RTMCAN_EVENT_MEASURING);

      RtmCan_ActiveMeasurementMode = measMode;

      /* Set the command according to specified measurement mode and measurement duration. */
      if (measMode == RTMCAN_MODE_SERIAL)
      {
        command = RTMCAN_CMD_SERIAL;
      }
      else if (measMode == RTMCAN_MODE_PARALLEL)
      {
        command = RTMCAN_CMD_PARALLEL;
      }
      else if (measMode == RTMCAN_MODE_LIVE)
      {
        if (RTMCAN_MULTICORE_SUPPORT == 0)
        {
          command = RTMCAN_CMD_LIVE;

          RtmCan_LiveMeasurementActive = RTMCAN_TRUE;

          _RtmCan_CreateLiveMeasurementVariables();

          /* If the measurement is *not* stoppable (time limited). */
          if ((timeToMeas / RTMCAN_MAINFUNCTIONCYCLETIME_MS) >= 2)
          {
            RtmCan_LiveMeasurementCounter = (timeToMeas / RTMCAN_MAINFUNCTIONCYCLETIME_MS) - 1;
          }
        }
        else
        {
          if (2 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
          {
            write("RtmCan Warning @%lld: Live measurment is not available in multicore system.", timeNowInt64()/100);
          }
          retVal = RTMCAN_E_NOT_AVAILABLE_IN_MULTICORE_SYSTEM;
          command = RTMCAN_CMD_NULL;

          _RtmCan_StateTransition(RTMCAN_EVENT_ACTIONFINISHED);
        }
      }
      else
      {
        if (1 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
        {
          write("RtmCan Error @%lld: Invalid measurement mode passed.", timeNowInt64()/100);
        }
        command = RTMCAN_CMD_NULL;

        _RtmCan_StateTransition(RTMCAN_EVENT_ACTIONFINISHED);
      }

      /* If new measurement is in mode SERIAL: */
      if (measMode == RTMCAN_MODE_SERIAL)
      {
        /* If measurement duration is set to ENDLESS: */
        if ((timeToMeas / RTMCAN_MAINFUNCTIONCYCLETIME_MS) < 2)
        {
          /* This configuration is not allowed! */
          if (2 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
          {
            write("RtmCan Warning @%lld: Not supported measurement setting: Serial and endless is not allowed.", timeNowInt64()/100);
          }

          _RtmCan_StateTransition(RTMCAN_EVENT_ACTIONFINISHED);
          retVal = RTMCAN_E_NOT_SUPPORTED;
        }
        /* Otherwise, store all active measurement points and set only first to active. */
        else
        {
          for (i = 0; i < RTMCAN_MEASUREMENTS_COUNT; i++)
          {
            RtmCan_MeasurementSectionActive_Serial[i] = RtmCan_MeasurementSectionActive[i];

            if (i > 0)
            {
              RtmCan_MeasurementSectionActive[i] = RTMCAN_MP_STATE_INACTIVE;
            }
          }
          _RtmCan_ConfigureMeasurements();

          /* Start serial measurement for first active measurement point. */
          _RtmCan_StartMeasurement(command, timeToMeas);
        }
      }
      /* Otherwise, start parallel or live measurement. */
      else
      {
        if (command != RTMCAN_CMD_NULL)
        {
          _RtmCan_StartMeasurement(command, timeToMeas);
        }
      }
    }
  }
  /* Otherwise, RtmCan is busy. */
  else
  {
    if (2 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
    {
      write("RtmCan Warning @%lld: Starting failed because RtmCan is busy.", timeNowInt64()/100);
    }
    retVal = RTMCAN_E_INTERFACE_IS_BUSY;
  }

  return retVal;
} /* RtmCan_StartMeasurement */


/**********************************************************************************************************************
  RtmCan_StopMeasurement
**********************************************************************************************************************/
/*!
 *
 *  \brief        Stops the current measurement if the measurement is stoppable.
 *  \details      Sends stop command to ECU.
 *  \param[in]    -
 *  \return       RTMCAN_E_OK                        The stop of current measurement was successful.
 *  \return       RTMCAN_E_INTERFACE_IS_BUSY         The stop of current measurement was rejected because the RtmCan
 *                                                   is busy.
 *  \return       RTMCAN_E_MEASUREMENT_NOT_STOPPABLE The stop of current measurement was rejected because the
 *                                                   measurement is not stoppable.
 *  \pre          The RtmCan is not busy.
 *  \pre          The current measurement has endless measurement duration and is therefore stoppable.
 *  \synchronous  TRUE
 *  \ingroup      External
 *********************************************************************************************************************/
enum RtmCan_ReturnValueType RtmCan_StopMeasurement()
{
  enum RtmCan_ReturnValueType retVal;

  /* If the RtmCan is in valid state: */
  if (RtmCan_GetRtmCanState() == RTMCAN_STATE_MEASURING)
  {
    /* If the measurement is stoppable: */
    if (RtmCan_StoppableMeasurementRunning == RTMCAN_TRUE)
    {
      retVal = RTMCAN_E_OK;

      /* Send command to stop the measurement. */
      _RtmCan_TransmitEcuCommand(_RtmCan_BuildEcuCommand(RTMCAN_CMD_STOP, 0));

      /* If live measurement was active, set according flag to inactive. */
      if (RtmCan_LiveMeasurementActive == RTMCAN_TRUE)
      {
        RtmCan_LiveMeasurementActive = RTMCAN_FALSE;

        _RtmCan_StateTransition(RTMCAN_EVENT_ACTIONFINISHED);
      }
    }
    else
    {
      /* The Measurement must not be stopped. */
      retVal = RTMCAN_E_MEASUREMENT_NOT_STOPPABLE;
    }
  }
  /* Otherwise, RtmCan is busy. */
  else
  {
    if (2 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
    {
      write("RtmCan Warning @%lld: Stop failed because measurement is not running.", timeNowInt64()/100);
    }
    retVal = RTMCAN_E_INTERFACE_IS_BUSY;
  }

  return retVal;
} /* RtmCan_StopMeasurement */


/**********************************************************************************************************************
  RtmCan_SetMPStateAll
**********************************************************************************************************************/
/*!
 *
 *  \brief        Set states (active or inactive) of all measurement points.
 *  \details      Set states (active or inactive) of all measurement points.
 *  \param[in]    -
 *  \return       RTMCAN_E_OK                The setting of new state was successful.
 *  \return       RTMCAN_E_INTERFACE_IS_BUSY The setting of new state was rejected because the RtmCan is busy.
 *  \pre          The RtmCan is not busy.
 *  \synchronous  TRUE
 *  \ingroup      External
 *  \note         The first measurement points are reserved for overhead measurement, therefore they cannot be set to
 *                inactive.
 *********************************************************************************************************************/
enum RtmCan_ReturnValueType RtmCan_SetMPStateAll(enum RtmCan_MeasurementStateType state)
{
  enum RtmCan_ReturnValueType retVal;
  dword i;

  /* If the RtmCan is in valid state: */
  if (RtmCan_GetRtmCanState() == RTMCAN_STATE_WAITFORACTION)
  {
    _RtmCan_StateTransition(RTMCAN_EVENT_CHANGESTATE);

    /* Set all measurement points to active. */
    for (i = RTMCAN_NUMBER_OF_OVERHEAD_MPS; i < RTMCAN_MEASUREMENTS_COUNT; i++)
    {
      RtmCan_MeasurementSectionActive[i] = state;
    }

    retVal = RTMCAN_E_OK;

    _RtmCan_ConfigureMeasurements();

    _RtmCan_StateTransition(RTMCAN_EVENT_ACTIONFINISHED);
  }
  /* Otherwise, RtmCan is busy. */
  else
  {
    if (2 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
    {
      write("RtmCan Warning @%lld: Set of all MP states failed because RtmCan is busy.", timeNowInt64()/100);
    }
    retVal = RTMCAN_E_INTERFACE_IS_BUSY;
  }

  return retVal;
} /* RtmCan_SetMPStateAll */


/**********************************************************************************************************************
  RtmCan_SetMPStateGroup
**********************************************************************************************************************/
/*!
 *
 *  \brief        Set States (active or inactive) of all measurement points of one or more groups.
 *  \details      Sets the state of one or more groups.
 *  \param[in]    measPointGroupName         Name of the measurement group whose state has to be changed.
 *  \param[in]    equal                      If set to true, the group name has to match completely. If set to false,
 *                                             the group name has to contain the specified name.
 *  \param[in]    state                      The new state of the measurement group(s).
 *  \return       RTMCAN_E_OK                The setting of new state was successful.
 *  \return       RTMCAN_E_INTERFACE_IS_BUSY The setting of new state was rejected because the RtmCan is busy.
 *  \return       RTMCAN_E_NO_MATCH_FOUND    The setting of new state was rejected because no measurement point is
 *                                             part of the specified measurement group.
 *  \pre          The RtmCan is not busy.
 *  \synchronous  TRUE
 *  \ingroup      External
 *  \note         Not matching measurement groups are ignored and therefore not set to the opposite state.
 *********************************************************************************************************************/
enum RtmCan_ReturnValueType RtmCan_SetMPStateGroup(char measPointGroupName[], enum RtmCan_Boolean equal, enum RtmCan_MeasurementStateType state)
{
  dword i;
  enum RtmCan_ReturnValueType retVal;
  enum RtmCan_Boolean ready;

  /* If the RtmCan is in valid state: */
  if (RtmCan_GetRtmCanState() == RTMCAN_STATE_WAITFORACTION)
  {
    _RtmCan_StateTransition(RTMCAN_EVENT_CHANGESTATE);

    /* If the measurement group must match completely: */
    if (equal == RTMCAN_TRUE)
    {
      ready = RTMCAN_FALSE;

      /* Search for measurement points whose measurement group are matching and set their state to new value. */
      for (i = RTMCAN_NUMBER_OF_OVERHEAD_MPS; (i < RTMCAN_MEASUREMENTS_COUNT); i++)
      {
        if (strlen(RtmCan_Measurements[i].Group) == strlen(measPointGroupName))
        {
          if (strncmp(RtmCan_Measurements[i].Group, measPointGroupName, strlen(measPointGroupName)) == 0)
          {
            RtmCan_MeasurementSectionActive[i] = state;
            ready = RTMCAN_TRUE;
          }
        }
      }
    }
    /* Otherwise, the specified measurement group name must be part of the registered measurement groups. */
    else
    {
      /* Look for measurement points with *measPointGroupName in their group name and set their state to new value. */
      for (i = RTMCAN_NUMBER_OF_OVERHEAD_MPS; i < RTMCAN_MEASUREMENTS_COUNT; i++)
      {
        if (strstr(RtmCan_Measurements[i].Group, measPointGroupName) >= 0)
        {
          RtmCan_MeasurementSectionActive[i] = state;
          ready = RTMCAN_TRUE;
        }
      }
    }

    if (ready == RTMCAN_TRUE)
    {
      retVal = RTMCAN_E_OK;
    }
    else
    {
      /* No matching measurement group was found. */
      retVal = RTMCAN_E_NO_MATCH_FOUND;
    }

    _RtmCan_ConfigureMeasurements();

    _RtmCan_StateTransition(RTMCAN_EVENT_ACTIONFINISHED);
  }
  /* Otherwise, RtmCan is busy. */
  else
  {
    if (2 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
    {
      write("RtmCan Warning @%lld: Set of all MP states of a group failed because RtmCan is busy.", timeNowInt64()/100);
    }
    retVal = RTMCAN_E_INTERFACE_IS_BUSY;
  }

  return retVal;
} /* RtmCan_SetMPStateGroup */


/**********************************************************************************************************************
  RtmCan_SetMPState
**********************************************************************************************************************/
/*!
 *
 *  \brief        Set states (active or inactive) of one or more measurement points.
 *  \details      Sets the state of one or more measurement points.
 *  \param[in]    measPointName              Name of the measurement group whose state has to be changed.
 *  \param[in]    equal                      If set to true, the MP name has to match completely. If set to false,
 *                                             the MP name has to contain the specified name.
 *  \param[in]    state                      The new state of the measurement group(s).
 *  \return       RTMCAN_E_OK                The setting of new state was successful.
 *  \return       RTMCAN_E_INTERFACE_IS_BUSY The setting of new state was rejected because the RtmCan is busy.
 *  \return       RTMCAN_E_NO_MATCH_FOUND    The setting of new state was rejected because no measurement point has
 *                                             the specified name.
 *  \pre          The RtmCan is not busy.
 *  \synchronous  TRUE
 *  \ingroup      External
 *  \note         Not matching measurement points are ignored and therefore not set to the opposite state.
 *********************************************************************************************************************/
enum RtmCan_ReturnValueType RtmCan_SetMPState(char measPointName[], enum RtmCan_Boolean equal, enum RtmCan_MeasurementStateType state)
{
  dword i;
  enum RtmCan_ReturnValueType retVal;
  enum RtmCan_Boolean ready;

  /* If the RtmCan is in valid state: */
  if (RtmCan_GetRtmCanState() == RTMCAN_STATE_WAITFORACTION)
  {
    _RtmCan_StateTransition(RTMCAN_EVENT_CHANGESTATE);

    /* If the MP name must match completely: */
    if (equal == RTMCAN_TRUE)
    {
      ready = RTMCAN_FALSE;

      /* Search for the specified MP and set its state to new value. */
      for (i = RTMCAN_NUMBER_OF_OVERHEAD_MPS; (i < RTMCAN_MEASUREMENTS_COUNT) && (ready == RTMCAN_FALSE); i++)
      {
        if (strlen(RtmCan_Measurements[i].Name) == strlen(measPointName))
        {
          if (strncmp(RtmCan_Measurements[i].Name, measPointName, strlen(measPointName)) == 0)
          {
            RtmCan_MeasurementSectionActive[i] = state;
            ready = RTMCAN_TRUE;
          }
        }
      }
    }
    /* Otherwise, the specified MP name must be part of the registered MPs. */
    else
    {
      /* Look for measurement points with *measPointName in their name and set their state to the new value. */
      for (i = RTMCAN_NUMBER_OF_OVERHEAD_MPS; i < RTMCAN_MEASUREMENTS_COUNT; i++)
      {
        if (strstr(RtmCan_Measurements[i].Name, measPointName) >= 0)
        {
          RtmCan_MeasurementSectionActive[i] = state;
          ready = RTMCAN_TRUE;
        }
      }
    }

    if (ready == RTMCAN_TRUE)
    {
      retVal = RTMCAN_E_OK;
    }
    else
    {
      /* No matching MP was found. */
      retVal = RTMCAN_E_NO_MATCH_FOUND;
    }

    _RtmCan_ConfigureMeasurements();

    _RtmCan_StateTransition(RTMCAN_EVENT_ACTIONFINISHED);
  }
  /* Otherwise, RtmCan is busy. */
  else
  {
    if (2 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
    {
      write("RtmCan Warning @%lld: Set of MP state failed because RtmCan is busy.", timeNowInt64()/100);
    }
    retVal = RTMCAN_E_INTERFACE_IS_BUSY;
  }

  return retVal;
} /* RtmCan_SetMPState */


/**********************************************************************************************************************
  RtmCan_SetMPStateByID
**********************************************************************************************************************/
/*!
 *
 *  \brief        Set states (active or inactive) of one measurement point.
 *  \details      Sets the state of one measurement point, depending on specified MP ID.
 *  \param[in]    measPointID                ID of the MP whose state has to be changed.
 *  \param[in]    state                      The new state of the measurement group(s).
 *  \return       RTMCAN_E_OK                The setting of new state was successful.
 *  \return       RTMCAN_E_INTERFACE_IS_BUSY The setting of new state was rejected because the RtmCan is busy.
 *  \return       RTMCAN_E_NO_MATCH_FOUND    The setting of new state was rejected because no measurement point has
 *                                             the specified name.
 *  \pre          The RtmCan is not busy.
 *  \synchronous  TRUE
 *  \ingroup      External
 *  \note         Not matching measurement points are ignored and therefore not set to the opposite state.
 *********************************************************************************************************************/
enum RtmCan_ReturnValueType RtmCan_SetMPStateByID(dword measPointID, enum RtmCan_MeasurementStateType state)
{
  dword i;
  enum RtmCan_ReturnValueType retVal;
  enum RtmCan_Boolean ready;

  /* If the RtmCan is in valid state: */
  if (RtmCan_GetRtmCanState() == RTMCAN_STATE_WAITFORACTION)
  {
    _RtmCan_StateTransition(RTMCAN_EVENT_CHANGESTATE);

    /* If specified measurement point ID is in valid range: */
    if ((measPointID >= RTMCAN_NUMBER_OF_OVERHEAD_MPS) && (measPointID < RTMCAN_MEASUREMENTS_COUNT))
    {
           /* Set state of the according MP to new value. */
           RtmCan_MeasurementSectionActive[measPointID] = state;
           retVal = RTMCAN_E_OK;
    }
    /* Otherwise, no matching MP was found. */
    else
    {
      retVal = RTMCAN_E_NO_MATCH_FOUND;
    }

    _RtmCan_ConfigureMeasurements();

    _RtmCan_StateTransition(RTMCAN_EVENT_ACTIONFINISHED);

  }
  /* Otherwise, RtmCan is busy. */
  else
  {
    if (2 <= SysGetVariableInt("Rtm", "Rtm_DebugLevel"))
    {
      write("RtmCan Warning @%lld: Set of MP state failed because RtmCan is busy.", timeNowInt64()/100);
    }
    retVal = RTMCAN_E_INTERFACE_IS_BUSY;
  }

  return retVal;
} /* RtmCan_SetMPStateByID */

