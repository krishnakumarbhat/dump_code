                          <SHORT-NAME>Com_MainFunctionTx_ComMainFunctionTx_PeriodicTimingEvent0</SHORT-NAME>
                          <STARTS-ON-EVENT-REF DEST="BSW-SCHEDULABLE-ENTITY">/MICROSAR/Com_ib_bswmd/BswModuleDescriptions/Com/ComBehavior/Com_MainFunctionTx_ComMainFunctionTx_Periodic</STARTS-ON-EVENT-REF>
                          <PERIOD>0.025</PERIOD>
                        </BSW-TIMING-EVENT>
