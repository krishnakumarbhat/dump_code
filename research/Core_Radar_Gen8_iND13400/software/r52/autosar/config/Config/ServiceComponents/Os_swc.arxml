                        </RUNNABLE-ENTITY>
                        <RUNNABLE-ENTITY UUID="9af0c3a0-01b8-4fc3-ae61-ec77bd1b4bf7">
                          <SHORT-NAME>GetElapsedValue</SHORT-NAME>
                          <MINIMUM-START-INTERVAL>0</MINIMUM-START-INTERVAL>
                          <SW-ADDR-METHOD-REF DEST="SW-ADDR-METHOD">/MICROSAR_MemMap/SwAddrMethods/CODE_ASIL_D</SW-ADDR-METHOD-REF>
                          <CAN-BE-INVOKED-CONCURRENTLY>true</CAN-BE-INVOKED-CONCURRENTLY>
                          <SYMBOL>GetElapsedValue</SYMBOL>
                        </RUNNABLE-ENTITY>
                      </RUNNABLES>
                      <SUPPORTS-MULTIPLE-INSTANTIATION>false</SUPPORTS-MULTIPLE-INSTANTIATION>
                    </SWC-INTERNAL-BEHAVIOR>
                  </INTERNAL-BEHAVIORS>
                </SERVICE-SW-COMPONENT-TYPE>
                <SWC-IMPLEMENTATION UUID="cf71e75f-46b7-420c-be7d-368956e236fe">
