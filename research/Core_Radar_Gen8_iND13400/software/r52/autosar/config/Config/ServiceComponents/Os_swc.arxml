                    <SWC-INTERNAL-BEHAVIOR UUID="3417f1dd-a078-4a26-b75b-f8b34bbc77b0">
                      <SHORT-NAME>Os_OsCore0_swcInternalBehavior</SHORT-NAME>
                      <EVENTS>
                        <OPERATION-INVOKED-EVENT UUID="a765ecea-cd14-4922-b67f-9d64b6f7aabe">
