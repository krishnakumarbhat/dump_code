<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00053.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE UUID="ff55d029-386d-43a2-b3c2-dfef4c7a5e36">
      <SHORT-NAME>MICROSAR</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE UUID="3DAF0FCD-3CD5-411C-AA93-9FC719D1D0D2">
          <SHORT-NAME>WdgM_swc</SHORT-NAME>
          <ELEMENTS>
            <MODE-DECLARATION-GROUP UUID="e89a597d-929f-46d4-99fc-42468d54fd72">
              <SHORT-NAME>WdgM_Mode</SHORT-NAME>
              <DESC>
                <L-2 L="FOR-ALL">The mode declaration group WdgMMode represents the modes of the Watchdog Manager module that will be notified to the SW-Cs / CDDs and the RTE.</L-2>
              </DESC>
              <CATEGORY>EXPLICIT_ORDER</CATEGORY>
              <INITIAL-MODE-REF DEST="MODE-DECLARATION">/MICROSAR/WdgM_swc/WdgM_Mode/SUPERVISION_OK</INITIAL-MODE-REF>
              <MODE-DECLARATIONS>
                <MODE-DECLARATION UUID="f8eabe49-1c95-4b64-9974-26fd21e164ab">
                  <SHORT-NAME>SUPERVISION_OK</SHORT-NAME>
                  <VALUE>0</VALUE>
                </MODE-DECLARATION>
                <MODE-DECLARATION UUID="7556e6f0-dd5e-441c-a33e-71c039e33f9c">
                  <SHORT-NAME>SUPERVISION_FAILED</SHORT-NAME>
                  <VALUE>1</VALUE>
                </MODE-DECLARATION>
                <MODE-DECLARATION UUID="2109d0fd-f7a3-414d-8b9e-8458b5aa0027">
                  <SHORT-NAME>SUPERVISION_EXPIRED</SHORT-NAME>
                  <VALUE>2</VALUE>
                </MODE-DECLARATION>
                <MODE-DECLARATION UUID="69fa1110-013b-4758-9370-fa21bc040ffd">
                  <SHORT-NAME>SUPERVISION_STOPPED</SHORT-NAME>
                  <VALUE>3</VALUE>
                </MODE-DECLARATION>
                <MODE-DECLARATION UUID="697a905f-88d0-4aa5-a905-de7e5c1ff9d5">
                  <SHORT-NAME>SUPERVISION_DEACTIVATED</SHORT-NAME>
                  <VALUE>4</VALUE>
                </MODE-DECLARATION>
              </MODE-DECLARATIONS>
              <ON-TRANSITION-VALUE>255</ON-TRANSITION-VALUE>
            </MODE-DECLARATION-GROUP>
            <DATA-TYPE-MAPPING-SET UUID="cf990dc6-d532-4a4a-b88c-a366fa892e36">
              <SHORT-NAME>WdgMMappingSet</SHORT-NAME>
              <DESC>
                <L-2 L="FOR-ALL">Contains mapping for mode declaration groups which are provided by WdgM.</L-2>
              </DESC>
              <MODE-REQUEST-TYPE-MAPS>
                <MODE-REQUEST-TYPE-MAP>
                  <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/MICROSAR/WdgM_swc/DataTypes/WdgMMode</IMPLEMENTATION-DATA-TYPE-REF>
                  <MODE-GROUP-REF DEST="MODE-DECLARATION-GROUP">/MICROSAR/WdgM_swc/WdgM_Mode</MODE-GROUP-REF>
                </MODE-REQUEST-TYPE-MAP>
              </MODE-REQUEST-TYPE-MAPS>
            </DATA-TYPE-MAPPING-SET>
          </ELEMENTS>
          <AR-PACKAGES>
            <AR-PACKAGE UUID="3A32DA89-7BE7-45F8-89F2-9914A7ACFCF7">
              <SHORT-NAME>DataTypes</SHORT-NAME>
              <ELEMENTS>
