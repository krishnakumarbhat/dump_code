                <ECUC-TEXTUAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-ENUMERATION-PARAM-DEF">/MICROSAR/Crc/CrcGeneral/Crc32P4Mode</DEFINITION-REF>
