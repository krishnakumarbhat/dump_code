            <ECUC-CONTAINER-VALUE UUID="c6077cd1-95bd-478b-a003-9971321b8307">
              <SHORT-NAME>CrcGeneral</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/MICROSAR/Crc/CrcGeneral</DEFINITION-REF>
              <PARAMETER-VALUES>
                <ECUC-TEXTUAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-ENUMERATION-PARAM-DEF">/MICROSAR/Crc/CrcGeneral/Crc16Mode</DEFINITION-REF>
                  <VALUE>CRC_16_TABLE</VALUE>
                </ECUC-TEXTUAL-PARAM-VALUE>
                <ECUC-TEXTUAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-ENUMERATION-PARAM-DEF">/MICROSAR/Crc/CrcGeneral/Crc32Mode</DEFINITION-REF>
                  <VALUE>CRC_32_TABLE</VALUE>
                </ECUC-TEXTUAL-PARAM-VALUE>
                <ECUC-TEXTUAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-ENUMERATION-PARAM-DEF">/MICROSAR/Crc/CrcGeneral/Crc8H2FMode</DEFINITION-REF>
                  <VALUE>CRC_8H2F_TABLE</VALUE>
                </ECUC-TEXTUAL-PARAM-VALUE>
                <ECUC-TEXTUAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-ENUMERATION-PARAM-DEF">/MICROSAR/Crc/CrcGeneral/Crc8Mode</DEFINITION-REF>
                  <VALUE>CRC_8_TABLE</VALUE>
                </ECUC-TEXTUAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/MICROSAR/Crc/CrcGeneral/CrcVersionInfoApi</DEFINITION-REF>
                  <VALUE>false</VALUE>
