                <ECUC-TEXTUAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-FUNCTION-NAME-DEF">/indieSemi/Wdg/WdgGeneral/WdgTriggerLocation</DEFINITION-REF>
