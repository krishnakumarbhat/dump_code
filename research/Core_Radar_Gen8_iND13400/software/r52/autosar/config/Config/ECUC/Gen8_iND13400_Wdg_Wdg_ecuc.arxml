                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/indieSemi/Wdg/WdgGeneral/WdgEnableTimeoutMapping</DEFINITION-REF>
