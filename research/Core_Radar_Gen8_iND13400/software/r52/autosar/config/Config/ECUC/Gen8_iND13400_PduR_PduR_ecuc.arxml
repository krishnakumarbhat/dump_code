                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/MICROSAR/PduR/PduRGeneral/PduRGeneration/PduREnableAdditionalRAMDebugData</DEFINITION-REF>
                      <VALUE>false</VALUE>
